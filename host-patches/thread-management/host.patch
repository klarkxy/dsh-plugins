+import { describe, expect, it } from 'vitest'
+import type { SessionFormatArtifact, SessionFormatEvent } from '@deepseek-ai/dsh-session-format'
+import { restoreReleasedV5Artifact } from '../src/index.ts'
+
+const known = new Set(['feedback/record', 'session-log-deepseek/delivery-accepted', 'session/end-seed'])
+function artifact(data: SessionFormatEvent['data'], inherited = false): SessionFormatArtifact {
+  return {
+    header: { version: 5, id: 'owner', createdAt: 1, isSeeded: inherited, delegationDepth: 0, classification: 'ordinary', ...(inherited ? { parentSession: 'parent' } : {}) },
+    inheritedEventCount: inherited ? 2 : 0,
+    events: [
+      { type: 'feedback/record', seq: 0, time: 1, data: {} },
+      { type: 'session-log-deepseek/delivery-accepted', seq: 1, time: 2, data },
+      ...(inherited ? [{ type: 'session/end-seed', seq: 2, time: 3, data: { inherited: true } }] : []),
+    ],
+  }
+}
+
+describe('native V5 delivery ownership', () => {
+  it('refuses a current delivery belonging to another session', () => {
+    expect(() => restoreReleasedV5Artifact(artifact({ sessionId: 'other', sessionFormatVersion: 5, throughSeq: 0 }), known)).toThrow('wrong Session')
+  })
+
+  it.each([1, -1, undefined])('refuses invalid current delivery coordinates %s', throughSeq => {
+    expect(() => restoreReleasedV5Artifact(artifact({ sessionId: 'owner', sessionFormatVersion: 5, ...(throughSeq === undefined ? {} : { throughSeq }) }), known)).toThrow(/throughSeq/)
+  })
+
+  it('retains valid current event identity and payload bytes', () => {
+    const input = artifact({ sessionId: 'owner', sessionFormatVersion: 5, throughSeq: 0 })
+    const before = JSON.stringify(input)
+    expect(restoreReleasedV5Artifact(input, known)).toBe(input)
+    expect(JSON.stringify(input)).toBe(before)
+    expect(input.events[1]?.data).toEqual({ sessionId: 'owner', sessionFormatVersion: 5, throughSeq: 0 })
+  })
+
+  it('retains inherited parent deliveries without adopting their ownership', () => {
+    const input = artifact({ sessionId: 'parent', sessionFormatVersion: 5, throughSeq: 0 }, true)
+    expect(restoreReleasedV5Artifact(input, known)).toBe(input)
+  })
+
+  it('retains future delivery generations without interpreting their coordinates', () => {
+    const input = artifact({ sessionId: 'other', sessionFormatVersion: 6, throughSeq: 'future-coordinate' })
+    expect(restoreReleasedV5Artifact(input, known)).toBe(input)
+  })
+})
