+    if (pending) {
+      return { branchRevision: revision, inputRevision, eligible: false, reason: 'pending' }
+    }
+    if (anchor === undefined) {
+      return { branchRevision: revision, inputRevision, eligible: false, reason: 'not-human-prompt' }
+    }
+    if (agent.status === 'running') {
+      return { branchRevision: revision, inputRevision, eligible: false, reason: 'running' }
+    }
+    const jobs = this.runningJobs(agent.id)
+    if (jobs.length > 0) return { branchRevision: revision, inputRevision, eligible: false, reason: 'running', blockers: jobs }
