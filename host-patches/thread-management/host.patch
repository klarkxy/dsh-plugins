+    const started = this.waitForTurnStart(agent, floor)
+    const opened = (): boolean => agent.session.snapshotEvents().some(event => event.type === 'turn/start' && event.seq > floor)
+    agent.continueFromBranch()
+    const stopped = agent.whenIdle().then(() => {
+      if (opened()) return
+      throw new RemoteError(
+        'session/retry-blocked',
+        'retry driver stopped before a durable turn start',
+        { sessionId: agent.id, reason: 'stop-failed', blockers: [] },
+      )
+    }).catch((error: unknown) => {
+      if (opened()) return
+      throw error
+    })
+    void stopped.catch(() => {})
+    await Promise.race([started, stopped])
