+
+  /** Read owned cold children without activation and correlate their own dispatch intervals to this parent cut. */
+  private async descendantBlockers(parent: Session, parentSeq: number, sinceTime: number, readFailures: 'blocker' | 'throw' = 'blocker'): Promise<string[]> {
+    const blockers: string[] = []
+    const ids = new Set<SessionId>()
+    try {
+      for (const id of await this.ownedDescendantIds(parent.id)) ids.add(id)
+    } catch (error: unknown) {
+      if (readFailures === 'throw') throw error
+      return [`missing:owned-descendants:${error instanceof Error ? error.message : String(error)}`]
+    }
+    const createdAfter = new Set<SessionId>()
+    for (const event of projectActiveBranch(parent.snapshotEvents())) {
+      if (event.seq < parent.inheritedEventCount || event.type !== 'subagent/catalog') continue
+      ids.add(event.data.childId)
+      if (event.seq > parentSeq) createdAfter.add(event.data.childId)
+    }
+    const visited = new Set<SessionId>([parent.id])
+    for (const id of ids) {
+      if (visited.has(id)) continue
+      visited.add(id)
+      if (this.ctx.agents.get(id)?.status === 'running') blockers.push(`running:${id}`)
+      blockers.push(...this.runningJobs(id))
