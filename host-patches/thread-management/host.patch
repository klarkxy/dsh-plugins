+
+  /** A later active-branch decision superseded this request. Replaying it must not replace that receipt. */
+  private laterBranch(session: Session, requestId: string): boolean {
+    const branch = this.branchEvent(session, requestId)
+    if (branch === undefined) return false
+    return session.snapshotEvents().some(event => event.type === 'session/active-branch' && event.seq > branch.seq)
+  }
+
+  /** Writes, unknown effects, and calls missing durable host evidence are never blindly replayed. */
+  private async uncertainWrite(session: Session, requestId: string): Promise<boolean> {
+    if (this.durableModelResult(session, requestId) || this.laterBranch(session, requestId)) return false
+    const branch = this.branchEvent(session, requestId)
+    if (branch === undefined) return false
+    return this.runningJobs(session.id).length > 0 || effectBlockers(session, branch.seq).length > 0 || (await this.descendantBlockers(session, branch.seq, branch.time)).length > 0
+  }
