+      try {
+        await this.completeReceipt(agent, receipt)
+      } catch (error: unknown) {
+        if (!(error instanceof RetryCutRefusal)) throw error
+        this.ctx.logger.warn(`automatic retry recovery for "${agent.id}" request "${receipt.requestId}" refused (${error.code}): ${error.message}; receipt and history retained`)
+        return
+      }
+      if (settle === 'idle') await agent.whenIdle()
+      return
+    }
+    if (agent.status === 'running') {
+      if (settle === 'idle') await agent.whenIdle()
+    }
+    if (this.durableModelResult(agent.session, receipt.requestId)) {
+      if (receipt.stage !== 'admitted') await this.putRetry(agent.id, { ...receipt, stage: 'admitted' })
+      return
+    }
