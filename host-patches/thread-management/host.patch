new file mode 100644
--- /dev/null
+++ b/packages/core/session/src/admission.ts
@@ -0,0 +1,232 @@
+/** Shared ordering for native session publication and lifecycle operations. */
+
+import { AsyncLocalStorage } from 'node:async_hooks'
+import { RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import type { SessionHeader, SessionId } from './types.ts'
+
+declare module '@deepseek-ai/dsh-typert-protocol' {
+  interface RemoteErrorDetailsMap {
+    'session/lifecycle-unavailable': Record<string, never>
+    'session/admission-busy': { readonly sessionId: SessionId }
+    'session/deleted': { readonly sessionId: SessionId }
+    'session/allocation-pending': { readonly sessionId: SessionId }
+  }
+}
+
+/** Durable owner consulted before session creation, publication, or input. */
+export interface SessionAdmissionDelegate {
+  /** @returns resolution after durable records load; unavailable owners reject. */
+  whenReady(): Promise<void>
+  /**
+   * Validate writable activation under the same per-id ordering and native proof scope.
+   * @param sessionId - target logical identity.
+   * @param operation - ordered activation or input work.
+   * @param header - target metadata known before publication.
+   * @returns the operation result inside the verified native scope.
+   */
+  admit<T>(sessionId: SessionId, operation: () => Promise<T>, header?: Pick<SessionHeader, 'classification' | 'cwd' | 'ownedDirectory'>): Promise<T>
+  /**
+   * Refuse an identity whose durable lifecycle no longer accepts activity.
+   * @param sessionId - target logical identity.
+   * @param header - target metadata or an already-admitted immutable live header.
+   */
+  assertUsable(sessionId: SessionId, header?: Pick<SessionHeader, 'classification' | 'cwd' | 'ownedDirectory'>): void
+}
+
+interface AdmissionLease {
+  readonly owner: SessionAdmission
+  readonly id: SessionId
+  readonly parent: AdmissionLease | undefined
+  active: boolean
+}
+
+interface AdmissionQueue {
+  tail: Promise<void>
+  pending: number
+  frozen: number
+}
+
+/**
+ * One queue per logical id, shared by factories and the durable lifecycle owner.
+ * The private operation lease expires on return, including inherited async work.
+ */
+export class SessionAdmission {
+  private readonly queues = new Map<SessionId, AdmissionQueue>()
+  private readonly operations = new AsyncLocalStorage<AdmissionLease>()
+  private delegate: SessionAdmissionDelegate | undefined
+  private wasBound = false
+
+  /**
+   * @param hasPersistence - whether a durable backend requires an admission owner.
+   * @param parentOf - persisted ownership of a live parent, without ordinary fork lineage.
+   * @param headerOf - immutable metadata for a live target or ancestor.
+   */
+  constructor(
+    private readonly hasPersistence: () => boolean,
+    private readonly parentOf: (id: SessionId) => SessionId | undefined = () => undefined,
+    private readonly headerOf: (id: SessionId) => SessionHeader | undefined = () => undefined,
+  ) {}
+
+  /**
+   * Bind one durable owner until its fiber unloads.
+   * @param delegate - loaded-record provider with synchronous refusals.
+   * @returns disposer that leaves durable admission unavailable until replacement.
+   */
+  bind(delegate: SessionAdmissionDelegate): () => void {
+    if (this.delegate !== undefined) throw new Error('session admission owner is already bound')
+    this.delegate = delegate
+    this.wasBound = true
+    return () => {
+      if (this.delegate === delegate) this.delegate = undefined
+    }
+  }
+
+  /**
+   * Refuse unavailable, terminal, or externally locked identities synchronously.
+   * @param sessionId - identity being published or receiving input.
+   * @param ownedParentId - actual owned parent; ordinary fork lineage is independent.
+   * @param header - metadata to verify at persistence or publication.
+   */
+  assertUsable(sessionId: SessionId, ownedParentId?: SessionId, header?: Pick<SessionHeader, 'classification' | 'cwd' | 'ownedDirectory'>): void {
+    for (const id of this.ancestors(sessionId, ownedParentId)) {
+      this.requireDelegate()?.assertUsable(id, id === sessionId ? header ?? this.headerOf(id) : this.headerOf(id))
+      this.assertUnlocked(id)
+    }
+  }
+
+  /**
+   * Refuse publication outside the operation that ordered this identity.
+   * @param sessionId - exact identity about to enter a native store.
+   * @param ownedParentId - actual owned parent, when present.
+   * @param header - immutable publication metadata.
+   */
+  assertPublication(sessionId: SessionId, ownedParentId?: SessionId, header?: Pick<SessionHeader, 'classification' | 'cwd' | 'ownedDirectory'>): void {
+    this.assertUsable(sessionId, ownedParentId, header)
+    for (const id of this.ancestors(sessionId, ownedParentId)) {
+      if ((this.queues.get(id)?.pending ?? 0) !== 0 && !this.owns(id)) throw busy(id)
+    }
+  }
+
+  /**
+   * Admit work and retain its ordering through every awaited publication step.
+   * @param sessionId - target identity.
+   * @param operation - creation, resume, or input operation.
+   * @param ownedParentId - owned parent to lock before the child.
+   * @param header - metadata verified before persistence or publication.
+   * @param signal - cancellation that rejects queued work before its body starts.
+   * @returns the operation result after the admission lease is released.
+   */
+  run<T>(sessionId: SessionId, operation: () => Promise<T>, ownedParentId?: SessionId,
+    header?: Pick<SessionHeader, 'classification' | 'cwd' | 'ownedDirectory'>, signal?: AbortSignal): Promise<T> {
+    const ids = this.ancestors(sessionId, ownedParentId).reverse()
+    const admit = async () => {
+      const delegate = this.requireDelegate()
+      const execute = async () => {
+        this.assertUsable(sessionId, ownedParentId, header)
+        return operation()
+      }
+      return delegate === undefined ? execute() : delegate.admit(sessionId, execute, header ?? this.headerOf(sessionId))
+    }
+    const lock = (index: number): Promise<T> => index === ids.length
+      ? admit()
+      : this.order(ids[index]!, () => lock(index + 1), false, signal)
+    return lock(0)
+  }
+
+  /**
+   * Order one lifecycle operation; nested calls on its id reuse the active lease.
+   * @param sessionId - identity whose activity is frozen.
+   * @param operation - durable lifecycle work, including terminal cleanup.
+   * @param signal - optional cancellation of the queued caller.
+   * @returns the operation result.
+   */
+  exclusive<T>(sessionId: SessionId, operation: () => Promise<T>, signal?: AbortSignal): Promise<T> {
+    return this.order(sessionId, operation, true, signal)
+  }
+
+  private order<T>(sessionId: SessionId, operation: () => Promise<T>, freeze: boolean, signal?: AbortSignal): Promise<T> {
+    if (signal?.aborted) return Promise.reject(abortError(sessionId, signal))
+    if (this.owns(sessionId)) return operation()
+    const inherited = this.operations.getStore()
+    const parent = this.active(inherited) ? inherited : undefined
+    const queue = this.queues.get(sessionId) ?? { tail: Promise.resolve(), pending: 0, frozen: 0 }
+    queue.pending++
+    if (freeze) queue.frozen++
+    this.queues.set(sessionId, queue)
+    const current = queue.tail.then(async () => {
+      const lease: AdmissionLease = { owner: this, id: sessionId, parent, active: true }
+      try {
+        if (signal?.aborted) throw abortError(sessionId, signal)
+        return await this.operations.run(lease, operation)
+      } finally {
+        lease.active = false
+        queue.pending--
+        if (freeze) queue.frozen--
+        if (queue.pending === 0 && this.queues.get(sessionId) === queue) this.queues.delete(sessionId)
+      }
+    })
+    queue.tail = current.then(() => undefined, () => undefined)
+    if (signal === undefined) return current
+    return new Promise<T>((resolve, reject) => {
+      const abort = () => { reject(abortError(sessionId, signal)) }
+      signal.addEventListener('abort', abort, { once: true })
+      void current.then(resolve, reject).finally(() => { signal.removeEventListener('abort', abort) })
+    })
+  }
+
+  private requireDelegate(): SessionAdmissionDelegate | undefined {
+    if (this.delegate !== undefined) return this.delegate
+    if (this.wasBound || this.hasPersistence()) {
+      throw new RemoteError('session/lifecycle-unavailable', 'durable session admission is unavailable', {})
+    }
+    return undefined
+  }
+
+  private ancestors(id: SessionId, parent?: SessionId): SessionId[] {
+    const ids = [id]
+    let next = parent ?? this.parentOf(id)
+    while (next !== undefined) {
+      if (ids.includes(next)) throw new Error(`session "${id}" has cyclic owned lineage`)
+      ids.push(next)
+      next = this.parentOf(next)
+    }
+    return ids
+  }
+
+  private owns(id: SessionId): boolean {
+    let owns = false
+    for (let lease = this.operations.getStore(); lease !== undefined; lease = lease.parent) {
+      if (!lease.active || lease.owner !== this) return false
+      if (lease.id === id) owns = true
+    }
+    return owns
+  }
+
+  private active(lease: AdmissionLease | undefined): boolean {
+    for (let current = lease; current !== undefined; current = current.parent) {
+      if (!current.active || current.owner !== this) return false
+    }
+    return true
+  }
+
+  private assertUnlocked(id: SessionId): void {
+    if ((this.queues.get(id)?.frozen ?? 0) !== 0 && !this.owns(id)) throw busy(id)
+  }
+}
+
+function abortError(id: SessionId, signal: AbortSignal): Error {
+  return signal.reason instanceof Error ? signal.reason : new Error(`agent "${id}" creation aborted`, { cause: signal.reason })
+}
+
+function busy(id: SessionId): RemoteError {
+  return new RemoteError('session/admission-busy', `session "${id}" has a lifecycle operation in progress`, { sessionId: id })
+}
+
+/**
+ * Select durable child ownership without treating independent forks as children.
+ * @param header - immutable session lineage recorded by the host.
+ * @returns parent identity only for a delegated session.
+ */
+export function ownedSessionParent(header: Pick<SessionHeader, 'parentSession' | 'origin' | 'delegationDepth'>): SessionId | undefined {
+  return header.origin === 'subagent' || (header.delegationDepth ?? 0) > 0 ? header.parentSession : undefined
+}
