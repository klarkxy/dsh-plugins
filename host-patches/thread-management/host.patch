+/** Native durable admission owner shared by every session-persistence profile. */
+
+import { FiberState } from '@deepseek-ai/cordis'
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionAdmissionDelegate, SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionHeader } from '@deepseek-ai/dsh-session'
+import { AsyncLocalStorage } from 'node:async_hooks'
+import type { Domain, KvTable } from '@deepseek-ai/dsh-storage-domain'
+import { RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import { sessionLifecycleDomain } from './lifecycle-spec.ts'
+import type { SessionLifecycleRecord } from './lifecycle-spec.ts'
+import { verifyDirectoryProof } from './directory-proof.ts'
+
+interface AllocationLease {
+  readonly owner: NativeSessionAdmission
+  readonly sessionId: SessionId
+  readonly nonce: string
+  readonly directory: string
+  readonly canonicalDirectory: string
+  readonly device: string
+  readonly inode: string
+  readonly generation: AdmissionGeneration
+  active: boolean
+}
+
+interface AdmissionGeneration {
+  active: boolean
+  readonly fiber: Context['fiber']
+  loaded: Promise<void>
+  domain?: Domain<typeof sessionLifecycleDomain>
+  table?: KvTable<SessionId, SessionLifecycleRecord>
+}
+
+/**
+ * Owns the existing lifecycle domain and its loaded-record barrier. Cleanup
+ * replay is a consumer operation and never participates in this barrier.
+ */
+export class NativeSessionAdmission implements SessionAdmissionDelegate {
+  private readonly allocations = new AsyncLocalStorage<AllocationLease>()
+  private readonly admittedHeaders = new WeakMap<object, AllocationLease>()
+  private current: AdmissionGeneration | undefined
+
+  /** @param ctx - persistence provider context that owns the domain and delegate binding. */
+  constructor(private readonly ctx: Context) {
+    ctx.inject(['sessions'], (sessionCtx) => {
+      sessionCtx.sessions.setAdmissionDelegate(this)
+    })
+    ctx.inject(['storageDomain'], (domainCtx) => {
+      const generation: AdmissionGeneration = {
+        active: true,
+        fiber: domainCtx.fiber,
+        loaded: Promise.resolve(),
+      }
+      this.current = generation
+      domainCtx.effect(() => {
+        generation.loaded = domainCtx.storageDomain.open(sessionLifecycleDomain).then(async (domain) => {
+          if (!generation.active) {
+            await domain.close()
+            return
+          }
+          generation.domain = domain
+          generation.table = domain.table('sessions')
+        })
+        // Admission callers observe the original failure; the effect also retains it for load diagnostics.
+        void generation.loaded.catch((error: unknown) => {
+          domainCtx.logger.warn(`session admission domain failed to load: ${String(error)}`)
+        })
+        return async () => {
+          generation.active = false
+          delete generation.table
+          if (this.current === generation) this.current = undefined
+          await generation.loaded
+          await generation.domain?.close()
+        }
+      }, 'sessionPersistence.admission-domain()')
+    })
+  }
+
+  /** Loaded canonical table, unavailable during domain reload or teardown. */
+  get table(): KvTable<SessionId, SessionLifecycleRecord> | undefined {
+    const generation = this.current
+    return generation?.active === true && live(generation.fiber) && live(this.ctx.fiber) ? generation.table : undefined
+  }
+
+  /**
+   * Wait only for domain loading, then revalidate the same provider generation.
+   * @returns resolution when synchronous admission can read durable records.
+   */
+  async whenReady(): Promise<void> {
+    const generation = this.current
+    if (generation === undefined || !generation.active || !live(generation.fiber) || !live(this.ctx.fiber)) throw unavailable()
+    await generation.loaded
+    if (this.current !== generation || this.table === undefined) throw unavailable()
+  }
+
+  /**
+   * Verify writable activation against the canonical domain and physical free root.
+   * @param sessionId - identity being activated or receiving an asynchronous prompt.
+   * @param operation - already ordered factory or input operation.
+   * @param header - target immutable metadata, when known before persistence opens.
+   * @returns the result inside a native verified proof scope.
+   */
+  admit<T>(sessionId: SessionId, operation: () => Promise<T>, header?: Pick<SessionHeader, 'classification' | 'cwd' | 'ownedDirectory'>): Promise<T> {
+    return this.exclusive(sessionId, async () => {
+      const record = this.table?.get(sessionId)
+      if (record?.phase === 'creating') {
+        this.assertUsable(sessionId, header)
+        return operation()
+      }
+      if (record?.classification !== 'free') {
+        this.assertUsable(sessionId, header)
+        return operation()
+      }
+      if (record.phase !== 'active' || !await verifyDirectoryProof(sessionId, record)) {
+        throw new RemoteError('session/allocation-pending', record.error ?? 'owned free workspace is unavailable', { sessionId })
+      }
+      const target = header ?? (await this.ctx.get('sessionPersistence')?.stat(sessionId))?.header
+      if (target === undefined || target.classification !== 'free' || target.cwd !== record.ownedDirectory
+        || target.ownedDirectory !== record.ownedDirectory) {
+        throw new RemoteError('session/allocation-pending', 'free session metadata does not match its native ownership record', { sessionId })
+      }
+      const lease = this.proofLease(sessionId, record)
+      try {
+        return await this.allocations.run(lease, async () => {
+          this.assertUsable(sessionId, target)
+          return operation()
+        })
+      } finally {
+        lease.active = false
+      }
+    })
+  }
+
+  /**
+   * Refuse terminal identities and unresolved allocation without reading logs.
+   * @param sessionId - logical identity the caller wants to activate.
+   * @param header - target metadata or an immutable live header with native admission proof.
+   */
+  assertUsable(sessionId: SessionId, header?: Pick<SessionHeader, 'classification' | 'cwd' | 'ownedDirectory'>): void {
+    const table = this.table
+    if (table === undefined) throw unavailable()
+    const record = table.get(sessionId)
+    if (record === undefined) {
+      if (header?.classification === 'free') throw new RemoteError('session/allocation-pending', 'free workspace has no native ownership record', { sessionId })
+      return
+    }
+    if (record.phase === 'deleted' || record.phase === 'deleting' || record.phase === 'cleanup-pending') {
+      throw new RemoteError('session/deleted', `session "${sessionId}" is ${record.phase}`, { sessionId })
+    }
+    if (record.phase === 'creating' || record.classification === 'free') {
+      const allocation = record.allocation
+      const active = this.allocations.getStore()
+      const lease = active?.active === true && active.owner === this && active.sessionId === sessionId && active.generation === this.current ? active
+        : record.phase === 'active' && header !== undefined ? this.admittedHeaders.get(header) : undefined
+      const target = header ?? (lease?.active === true ? { classification: 'free', cwd: lease.directory, ownedDirectory: lease.directory } : undefined)
+      if ((record.phase === 'creating' && record.error !== undefined) || lease === undefined || lease.owner !== this || allocation === undefined || lease.generation !== this.current
+        || lease.sessionId !== sessionId || lease.nonce !== allocation.nonce
+        || lease.directory !== record.ownedDirectory || lease.canonicalDirectory !== allocation.canonicalDirectory
+        || lease.device !== allocation.device || lease.inode !== allocation.inode
+        || target?.classification !== 'free' || target.cwd !== lease.directory || target.ownedDirectory !== lease.directory) {
+        throw new RemoteError('session/allocation-pending', record.error ?? 'free workspace allocation requires recovery before activation', { sessionId })
+      }
+      if (header !== undefined && 'id' in header && header.id === sessionId && Object.isFrozen(header)) this.admittedHeaders.set(header, lease)
+    }
+  }
+
+  /**
+   * Activate a newly proven free allocation under an expiring native lease.
+   * @param sessionId - exact id whose current allocation is about to publish.
+   * @param operation - factory creation and activation while the same queue remains held.
+   * @returns the operation result; existing interrupted allocations stay closed to generic callers.
+   */
+  withAllocatedSession<T>(sessionId: SessionId, operation: () => Promise<T>): Promise<T> {
+    return this.exclusive(sessionId, async () => {
+      const record = this.table?.get(sessionId)
+      if (record?.phase !== 'creating' || record.classification !== 'free' || record.error !== undefined
+        || record.allocation === undefined || record.ownedDirectory === undefined
+        || !await verifyDirectoryProof(sessionId, record)) {
+        throw new RemoteError('session/allocation-pending', 'free workspace allocation is not ready for activation', { sessionId })
+      }
+      const current = this.table?.get(sessionId)
+      if (current?.phase !== 'creating' || current.allocation?.nonce !== record.allocation.nonce
+        || current.ownedDirectory !== record.ownedDirectory || current.error !== undefined) {
+        throw new RemoteError('session/allocation-pending', 'free workspace allocation changed during verification', { sessionId })
+      }
+      const lease = this.proofLease(sessionId, record)
+      try {
+        return await this.allocations.run(lease, operation)
+      } finally {
+        lease.active = false
+      }
+    })
+  }
+
+  private proofLease(sessionId: SessionId, record: SessionLifecycleRecord): AllocationLease {
+    const allocation = record.allocation
+    const generation = this.current
+    if (record.ownedDirectory === undefined || allocation?.canonicalDirectory === undefined
+      || allocation.device === undefined || allocation.inode === undefined || generation === undefined || this.table === undefined) {
+      throw new RemoteError('session/allocation-pending', 'free workspace has no physical ownership proof', { sessionId })
+    }
+    return { owner: this, sessionId, nonce: allocation.nonce, directory: record.ownedDirectory,
+      canonicalDirectory: allocation.canonicalDirectory, device: allocation.device, inode: allocation.inode, generation, active: true }
+  }
+
+  /**
+   * Use the SessionStore's queue for a durable lifecycle operation.
+   * @param sessionId - identity whose intake must remain frozen.
+   * @param operation - retry, allocation, or terminal cleanup.
+   * @returns the operation result after releasing the shared lease.
+   */
+  exclusive<T>(sessionId: SessionId, operation: () => Promise<T>): Promise<T> {
+    const sessions = this.ctx.get('sessions')
+    if (sessions === undefined) return Promise.reject(unavailable())
+    return sessions.admission.exclusive(sessionId, async () => {
+      await this.whenReady()
+      return operation()
+    })
+  }
+}
+
+/**
+ * Install native admission as part of the existing persistence provider.
+ * @param ctx - provider context; teardown closes its domain and delegate binding.
+ * @returns the shared access used by lifecycle consumers.
+ */
+export function installSessionAdmission(ctx: Context): NativeSessionAdmission {
+  return new NativeSessionAdmission(ctx)
+}
+
+function unavailable(): RemoteError {
+  return new RemoteError('session/lifecycle-unavailable', 'durable session admission is unavailable', {})
+}
+
+function live(fiber: Context['fiber']): boolean {
+  return fiber.state !== FiberState.UNLOADING && fiber.state !== FiberState.DISPOSED && fiber.state !== FiberState.FAILED
+}
