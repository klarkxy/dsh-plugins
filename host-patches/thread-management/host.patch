+++ b/packages/session/session-format-v4-to-v5/src/migration.ts
@@ -0,0 +1,53 @@
+/** Identity migration from released V4 to V5. Events are copied; classification defaults to ordinary. */
+
+import { defineSessionFormatMigration, SessionFormatError, isSessionFormatJsonObject } from '@deepseek-ai/dsh-session-format'
+import type { SessionFormatEvent, SessionFormatEventRun, SessionFormatMigrationContext, SessionFormatMigrationStage, SessionFormatMigrationStageInput } from '@deepseek-ai/dsh-session-format'
+import { assertReleasedV4Header } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+import { assertReleasedV5Header } from './validation.ts'
+
+/** Header-only identity migration. Body events keep their sequence and payload. */
+export const sessionFormatV4ToV5 = defineSessionFormatMigration({
+  name: '@deepseek-ai/dsh-session-format-v4-to-v5',
+  fromVersion: 4,
+  toVersion: 5,
+  migrateHeader(header) {
+    assertReleasedV4Header(header)
+    return { ...header, version: 5, classification: 'ordinary' }
+  },
+  createStage(input) {
+    return new ReleasedV4ToV5Stage(input)
+  },
+  validateTargetHeader: assertReleasedV5Header,
+})
+
+class ReleasedV4ToV5Stage implements SessionFormatMigrationStage {
+  readonly headerInheritedEventCount?: number
+  private cut: number | undefined
+
+  constructor(input: SessionFormatMigrationStageInput) {
+    this.cut = input.sourceHeader.isSeeded ? input.sourceInheritedEventCount : 0
+    if (!input.sourceHeader.isSeeded) this.headerInheritedEventCount = 0
+    else if (input.sourceInheritedEventCount !== undefined) this.headerInheritedEventCount = input.sourceInheritedEventCount
+  }
+
+  transformEvent(event: SessionFormatEvent, context: SessionFormatMigrationContext): void {
+    this.observe(event)
+    context.emitEvent(event)
+  }
+
+  transformRun(run: SessionFormatEventRun, context: SessionFormatMigrationContext): void {
+    for (const event of run.expand()) this.observe(event)
+    context.emitRun(run)
+  }
+
+  finish(): number {
+    if (this.cut === undefined) throw new SessionFormatError('format v4 seeded Session has no inherited cut')
+    return this.cut
+  }
+
+  private observe(event: SessionFormatEvent): void {
+    if (event.type === 'session/end-seed' && isSessionFormatJsonObject(event.data) && event.data['inherited'] === true) {
+      this.cut = event.seq
+    }
+  }
+}
diff --git a/packages/session/session-format-v4-to-v5/src/validation.ts b/packages/session/session-format-v4-to-v5/src/validation.ts
new file mode 100644
--- /dev/null
+++ b/packages/session/session-format-v4-to-v5/src/validation.ts
@@ -0,0 +1,158 @@
+/** Native V5 header admission and V4 relationship reuse. */
+
+import { isAbsolute } from 'node:path'
+import { SessionFormatError, isSessionFormatJsonObject, sessionFormatCount } from '@deepseek-ai/dsh-session-format'
+import type { SessionFormatArtifact, SessionFormatHeader } from '@deepseek-ai/dsh-session-format'
+import { assertReleasedV4Relationships, assertV4RowAdmission, restoreReleasedV4Artifact } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+
+const EFFECTS = new Set(['read-only', 'filesystem-write', 'external-write', 'unknown'])
+
+/**
+ * Copy the V4 header fields out of a V5 header.
+ * @param header - V5 logical header that has already passed {@link assertReleasedV5Header}.
+ * @returns a V4 header with the same identity fields.
+ */
+export function releasedV4HeaderView(header: SessionFormatHeader): SessionFormatHeader {
+  return {
+    version: 4,
+    id: header.id,
+    createdAt: header.createdAt,
+    isSeeded: header.isSeeded,
+    delegationDepth: header.delegationDepth,
+    ...(header.cwd === undefined ? {} : { cwd: header.cwd }),
+    ...(header.parentSession === undefined ? {} : { parentSession: header.parentSession }),
+    ...(header.origin === undefined ? {} : { origin: header.origin }),
+    ...(header.agentPreset === undefined ? {} : { agentPreset: header.agentPreset }),
+  }
+}
+
+/**
+ * Validate the exact native V5 logical header.
+ * Classification is required. Free sessions record an absolute owned directory
+ * equal to `cwd`. Ordinary sessions do not record one.
+ * @param header - decoded or otherwise untrusted V5 Session header candidate.
+ */
+export function assertReleasedV5Header(header: unknown): void {
+  if (!isSessionFormatJsonObject(header) || header['version'] !== 5) throw new SessionFormatError('expected format v5 header')
+  const required = ['version', 'id', 'createdAt', 'isSeeded', 'delegationDepth', 'classification']
+  const allowed = new Set([...required, 'cwd', 'parentSession', 'origin', 'agentPreset', 'ownedDirectory'])
+  const missing = required.find(key => !Object.hasOwn(header, key))
+  const unexpected = Object.keys(header).find(key => !allowed.has(key))
+  if (missing !== undefined) throw new SessionFormatError(`format v5 header lacks required field ${missing}`)
+  if (unexpected !== undefined) throw new SessionFormatError(`format v5 header has unexpected field ${unexpected}`)
+  if (typeof header['id'] !== 'string') throw new SessionFormatError('format v5 header id must be a string')
+  sessionFormatCount(header['createdAt'], 'format v5 header createdAt')
+  sessionFormatCount(header['delegationDepth'], 'format v5 header delegationDepth')
+  if (typeof header['isSeeded'] !== 'boolean') throw new SessionFormatError('format v5 header isSeeded must be boolean')
+  if (header['cwd'] !== undefined && (typeof header['cwd'] !== 'string' || !isAbsolute(header['cwd']))) {
+    throw new SessionFormatError('format v5 header cwd must be absolute')
+  }
+  for (const key of ['parentSession', 'agentPreset']) {
+    if (header[key] !== undefined && typeof header[key] !== 'string') {
+      throw new SessionFormatError(`format v5 header ${key} must be a string`)
+    }
+  }
+  if (header['origin'] !== undefined && header['origin'] !== 'subagent') {
+    throw new SessionFormatError('format v5 header origin must be "subagent"')
+  }
+  if (header['classification'] !== 'ordinary' && header['classification'] !== 'free') {
+    throw new SessionFormatError('format v5 header classification must be "ordinary" or "free"')
+  }
+  if (header['classification'] === 'free') {
+    if (typeof header['ownedDirectory'] !== 'string' || !isAbsolute(header['ownedDirectory'])) {
+      throw new SessionFormatError('format v5 free header ownedDirectory must be absolute')
+    }
+    if (header['ownedDirectory'] !== header['cwd']) {
+      throw new SessionFormatError('format v5 free header ownedDirectory must equal cwd')
+    }
+  } else if (header['ownedDirectory'] !== undefined) {
+    throw new SessionFormatError('format v5 ordinary header must not record ownedDirectory')
+  }
+}
+
+/**
+ * Validate one current-generation row, including active-branch and tool-effect payloads.
+ * @param row - parsed physical row before the current decoder accepts it.
+ * @param knownEventTypes - installed event types, supplied by native readers before tail recovery.
+ */
+export function assertV5RowAdmission(row: unknown, knownEventTypes?: ReadonlySet<string>): void {
+  assertV4RowAdmission(row, knownEventTypes)
+  if (!isSessionFormatJsonObject(row)) return
+  if (row['type'] === 'session/active-branch') assertActiveBranch(row)
+  if (row['type'] === 'host/tool-effect') assertToolEffect(row)
+}
+
+/**
+ * Restore a V5 artifact by checking the V5 header, then the unchanged V4 relationships.
+ * @param artifact - complete detached V5 artifact.
+ * @param knownEventTypes - event types understood by the installed Session package.
+ * @returns the same validated artifact.
+ */
+export function restoreReleasedV5Artifact(artifact: SessionFormatArtifact, knownEventTypes: ReadonlySet<string>): SessionFormatArtifact {
+  assertReleasedV5Header(artifact.header)
+  restoreReleasedV4Artifact({
+    ...artifact,
+    header: releasedV4HeaderView(artifact.header),
+  }, knownEventTypes)
+  assertReleasedV5Relationships(artifact, knownEventTypes)
+  return artifact
+}
+
+/**
+ * Validate V5 additions and then the released V4 relationship rules.
+ * @param artifact - decoded artifact with its final inherited cut.
+ * @param knownEventTypes - installed event types whose payloads this reader interprets.
+ */
+export function assertReleasedV5Relationships(artifact: SessionFormatArtifact, knownEventTypes: ReadonlySet<string>): void {
+  assertReleasedV5Header(artifact.header)
+  for (const event of artifact.events) {
+    if (!knownEventTypes.has(event.type)) continue
+    if (event.type === 'session/active-branch') assertActiveBranch(event)
+    if (event.type === 'host/tool-effect') assertToolEffect(event)
+  }
+  assertReleasedV4Relationships({
+    ...artifact,
+    header: releasedV4HeaderView(artifact.header),
+    // The released validator sees a V4 header view, so present native V5 delivery coordinates in that same view.
+    // This changes no stored or returned event payload; historical and future delivery generations remain untouched.
+    events: artifact.events.map(event => event.type === 'session-log-deepseek/delivery-accepted'
+      && isSessionFormatJsonObject(event.data) && event.data['sessionFormatVersion'] === 5
+      ? { ...event, data: { ...event.data, sessionFormatVersion: 4 } }
+      : event),
+  }, knownEventTypes)
+}
+
+function assertActiveBranch(event: { readonly [key: string]: unknown }): void {
+  const data = event['data']
+  if (!isSessionFormatJsonObject(data)) throw new SessionFormatError('session/active-branch data must be an object')
+  const revision = sessionFormatCount(data['revision'], 'session/active-branch revision')
+  if (revision < 1) throw new SessionFormatError('session/active-branch revision must be positive')
+  sessionFormatCount(data['anchorSeq'], 'session/active-branch anchorSeq')
+  sessionFormatCount(data['expectedRevision'], 'session/active-branch expectedRevision')
+  for (const key of ['messageId', 'requestId']) {
+    if (typeof data[key] !== 'string' || data[key].length === 0) {
+      throw new SessionFormatError(`session/active-branch ${key} must be a nonempty string`)
+    }
+  }
+  if (data['text'] !== undefined && typeof data['text'] !== 'string') {
+    throw new SessionFormatError('session/active-branch text must be a string')
+  }
+  if (!isSessionFormatJsonObject(data['prompt']) || data['prompt']['role'] !== 'user' || data['prompt']['id'] !== data['messageId']) {
+    throw new SessionFormatError('session/active-branch prompt must be the same user message')
+  }
+}
+
+function assertToolEffect(event: { readonly [key: string]: unknown }): void {
+  const data = event['data']
+  if (!isSessionFormatJsonObject(data)) throw new SessionFormatError('host/tool-effect data must be an object')
+  if (typeof data['callId'] !== 'string' || data['callId'].length === 0) {
+    throw new SessionFormatError('host/tool-effect callId must be a nonempty string')
+  }
+  if (typeof data['name'] !== 'string' || data['name'].length === 0) {
+    throw new SessionFormatError('host/tool-effect name must be a nonempty string')
+  }
+  if (typeof data['effect'] !== 'string' || !EFFECTS.has(data['effect'])) {
+    throw new SessionFormatError('host/tool-effect effect must be a host classification')
+  }
+  if (typeof data['nested'] !== 'boolean') throw new SessionFormatError('host/tool-effect nested must be boolean')
+}
