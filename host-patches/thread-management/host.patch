+  private waitForTurnStart(agent: Agent, afterSeq: number): Promise<void> {
+    return new Promise((resolve, reject) => {
+      let settled = false
+      const stop = (): void => {
+        disposeEvent()
+        disposeSession()
+      }
+      const succeed = (): void => {
+        if (settled) return
+        settled = true
+        stop()
+        resolve()
+      }
+      const fail = (): void => {
+        if (settled) return
+        settled = true
+        stop()
+        reject(new RemoteError(
+          'session/retry-blocked',
+          'retry driver stopped before a durable turn start',
+          { sessionId: agent.id, reason: 'stop-failed', blockers: [] },
+        ))
+      }
+      const disposeEvent = this.ctx.on('session/event', (session, event) => {
+        if (session.id !== agent.id || event.type !== 'turn/start' || event.seq <= afterSeq) return
+        succeed()
+      })
+      const disposeSession = this.ctx.on('session/disposed', (session) => {
+        if (session.id !== agent.id) return
+        fail()
+      })
+    })
+  }
+
+  private branchEvent(session: Session, requestId: string): SessionEvent<'session/active-branch'> | undefined {
+    for (const event of session.snapshotEvents()) {
+      if (event.type === 'session/active-branch' && event.data.requestId === requestId) return event
+    }
+    return undefined
+  }
+
+  private async finishDelete(sessionId: SessionId, record: SessionLifecycleRecord): Promise<void> {
+    if (this.table?.get(sessionId)?.phase === 'deleted') return
+    const descendants = await this.ownedDescendantIds(sessionId)
+    await this.closeAdmission(descendants)
