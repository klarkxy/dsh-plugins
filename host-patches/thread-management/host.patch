+   */
+  async previewRetry(sessionId: SessionId, messageId: string): Promise<SessionRetryPreview> {
+    await this.assertUsable(sessionId)
+    const agent = await this.requireAgent(sessionId)
+    return this.inspect(agent, messageId)
+  }
+
+  /**
