+import { FREE_DIRECTORY_MARKER as MARKER, verifyDirectoryIdentity, verifyDirectoryProof } from '@deepseek-ai/dsh-session-persistence'
+export { assertFreeSessionSegment, freeDirectoryPath, verifyDirectoryProof } from '@deepseek-ai/dsh-session-persistence'
+import type { SessionLifecycleRecord } from './lifecycle-spec.ts'
+
+type Allocation = NonNullable<SessionLifecycleRecord['allocation']>
+
+/** Record the physical identity immediately after exclusive mkdir, before writing proof. */
+export async function allocatedDirectoryIdentity(directory: string, nonce: string): Promise<Allocation> {
+  const stats = await lstat(directory, { bigint: true })
+  if (!stats.isDirectory() || stats.isSymbolicLink()) throw new Error('allocated free workspace was substituted')
+  await syncDirectory(dirname(directory))
+  return { nonce, canonicalDirectory: await realpath(directory), device: String(stats.dev), inode: String(stats.ino) }
+}
+
+/** A newly allocated root gets an exclusive, synced marker; existing entries are never overwritten. */
+export async function writeDirectoryProof(sessionId: string, directory: string, allocation: Allocation): Promise<void> {
+  const marker = await open(join(directory, MARKER), 'wx', 0o600)
+  try {
+    await marker.writeFile(JSON.stringify({ sessionId, nonce: allocation.nonce }) + '\n')
+    await marker.sync()
+  } finally {
+    await marker.close()
+  }
+  await syncDirectory(directory)
+  await verifyDirectoryProof(sessionId, { ownedDirectory: directory, allocation })
+}
+
+/** Final-stage cleanup keeps physical identity checks but never regains recursive authority. */
+export function verifyDirectoryCleanup(sessionId: string, record: SessionLifecycleRecord): Promise<boolean> {
+  return record.rootRemoval === 'final' ? verifyDirectoryIdentity(sessionId, record) : verifyDirectoryProof(sessionId, record)
+}
+
+/** Remove a quiescent, proven root; retain its marker until every other entry is removed. */
+export async function removeFreeDirectory(
+  sessionId: string, record: SessionLifecycleRecord, recordFinalRemoval: () => Promise<void>,
+): Promise<void> {
+  const directory = record.ownedDirectory
+  if (directory === undefined) throw new Error('free workspace has no recorded directory')
+  if (record.rootRemoval === 'final') {
+    if (!await verifyDirectoryIdentity(sessionId, record)) return
+    const markerExists = await lstat(join(directory, MARKER)).then(() => true).catch((error: unknown) => {
+      if (hasCode(error, 'ENOENT')) return false
+      throw error
+    })
+    if (markerExists) {
+      await verifyDirectoryProof(sessionId, record)
+      await unlink(join(directory, MARKER))
+    }
+    // The durable final-removal stage allows no recursive traversal or deletion of new entries.
+    await rmdir(directory)
+    await syncDirectory(dirname(directory))
+    return
+  }
+  if (!await verifyDirectoryProof(sessionId, record)) return
+  await removeChildren(directory, true)
+  await verifyDirectoryProof(sessionId, record)
+  await recordFinalRemoval()
+  await unlink(join(directory, MARKER))
+  await rmdir(directory)
+  await syncDirectory(dirname(directory))
+}
+
+async function removeChildren(directory: string, root = false): Promise<void> {
+  const stats = await lstat(directory)
+  if (!stats.isDirectory() || stats.isSymbolicLink()) throw new Error('owned directory changed while removing its contents')
+  for (const name of await readdir(directory)) {
+    if (root && name === MARKER) continue
+    const child = join(directory, name)
+    const entry = await lstat(child)
+    if (entry.isDirectory() && !entry.isSymbolicLink()) {
+      await removeChildren(child)
+      await rmdir(child)
+    } else await unlink(child)
+  }
+}
+
+/** Copy only within two proven roots. The child's marker always keeps its own identity. */
+export async function copyFreeDirectory(
+  sourceId: string, source: SessionLifecycleRecord,
+  targetId: string, target: SessionLifecycleRecord,
+): Promise<void> {
+  const sourceDirectory = source.ownedDirectory
+  const targetDirectory = target.ownedDirectory
+  if (sourceDirectory === undefined || targetDirectory === undefined) throw new Error('free workspace source or target has no recorded directory')
+  if (!await verifyDirectoryProof(sourceId, source) || !await verifyDirectoryProof(targetId, target)) {
+    throw new Error('free workspace source or target is missing')
+  }
+  await copyChildren(sourceDirectory, sourceDirectory, targetDirectory, new Set(), true)
+  await verifyDirectoryProof(sourceId, source)
+  await verifyDirectoryProof(targetId, target)
+}
+
+async function copyChildren(root: string, source: string, target: string, seen: Set<string>, atRoot = false): Promise<void> {
+  const sourceReal = await realpath(source)
+  if (seen.has(sourceReal)) return
+  seen.add(sourceReal)
+  for (const name of await readdir(source)) {
+    if (atRoot && name === MARKER) continue
+    let from = join(source, name)
+    const to = join(target, name)
+    let stats = await lstat(from)
+    if (stats.isSymbolicLink()) {
+      const linked = await realpath(from).catch((error: unknown) => {
+        if (hasCode(error, 'ENOENT')) return undefined
+        throw error
+      })
+      if (linked === undefined || seen.has(linked)) continue
+      const inside = relative(root, linked)
+      if (inside.startsWith('..') || isAbsolute(inside)) continue
+      from = linked
+      stats = await lstat(from)
+      if (stats.isSymbolicLink()) continue
+    }
+    if (stats.isDirectory()) {
+      await mkdir(to)
+      await copyChildren(root, from, to, seen)
+    } else if (stats.isFile()) await copyFile(from, to)
+  }
+}
+
+function hasCode(error: unknown, code: string): boolean {
+  return typeof error === 'object' && error !== null && 'code' in error && error.code === code
+}
+
+/** POSIX needs directory fsync to durably publish entries; Windows has no directory fsync API. */
+async function syncDirectory(directory: string): Promise<void> {
+  if (process.platform === 'win32') return
+  const handle = await open(directory, 'r')
+  try { await handle.sync() } finally { await handle.close() }
+}
