+  private async idempotent(
+    agent: Agent,
+    request: { messageId: string; expectedRevision: number; expectedInputRevision: string; requestId: string; text?: string },
+  ): Promise<number | undefined> {
+    const event = this.branchEvent(agent.session, request.requestId)
