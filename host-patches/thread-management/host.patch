+async function mountDurable(ctx: Context): Promise<void> {
+  await ctx.plugin(Storage)
+  applyStorageJson(ctx, { root: join(resolveDshHome(), 'storages') })
+  const facility = new DomainFacility(ctx, { backend: 'json', routes: {} })
+  ctx.storage.mount('domain', facility)
+  ctx.provide('storageDomain', facility)
+}
+
+async function contextWithoutHome(options: { persistence?: boolean; checkpoint?: boolean; supportsDelete?: boolean } = {}): Promise<Context> {
+  const ctx = new Context()
+  await mountDurable(ctx)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  // Evidence-only lifecycle fixtures; real JSONL durability is exercised by the Loader workflow tests.
+  if (options.persistence !== false) {
+    await ctx.plugin({
+      name: 'edge-persistence-fixture', inject: ['sessions', 'storageDomain'],
+      apply(providerCtx: Context) {
+        providerCtx.provide('sessionPersistence', {
+          admission: installSessionAdmission(providerCtx),
+          supportsDelete: options.supportsDelete ?? true,
+          create: () => Promise.reject(new Error('edge fixture does not create persistent handles')),
+          open: () => Promise.reject(new Error('edge fixture does not open persistent handles')),
+          flush: () => Promise.resolve(),
+          stat: () => Promise.resolve(undefined),
+          list: () => Promise.resolve([]),
+          delete: () => Promise.resolve(),
+        } as never)
+      },
+    })
+    await ctx.sessionPersistence.admission.whenReady()
+  }
+  if (options.checkpoint !== false) ctx.on('session/flush', () => Promise.resolve())
+  ctx.provide('workspaceRegistry', { get: () => undefined, list: () => [], archivedSessionIds: [] } as never)
+  return ctx
+}
+
+async function waitUntilGone(path: string): Promise<void> {
+  for (let attempt = 0; attempt < 50; attempt += 1) {
+    try {
+      await lstat(path)
+    } catch (error: unknown) {
+      if (typeof error === 'object' && error !== null && 'code' in error && error.code === 'ENOENT') return
+    }
+    await new Promise(resolve => { setTimeout(resolve, 20) })
+  }
+  throw new Error(`path stayed after restart cleanup: ${path}`)
+}
