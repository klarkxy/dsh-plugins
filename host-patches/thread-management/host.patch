+// @vitest-environment jsdom
+/** Async menu close returns focus only when the owner left it on the page. */
+import { useState } from 'react'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it } from 'vitest'
+import { Menu } from '../src/Menu.tsx'
+
+afterEach(cleanup)
+
+function DelayedMenu({ moveFocus }: { moveFocus?: () => void }) {
+  const [open, setOpen] = useState(true)
+  return (
+    <>
+      <button type="button">Elsewhere</button>
+      <Menu
+        open={open}
+        onClose={() => { setOpen(false) }}
+        anchor={<button type="button">Open</button>}
+        items={[{ id: 'copy', label: 'Copy' }]}
+        onSelect={() => {
+          moveFocus?.()
+          setTimeout(() => { setOpen(false) }, 20)
+        }}
+      />
+    </>
+  )
+}
+
+it('returns focus to the anchor after an async close leaves it on the body', async () => {
+  render(<DelayedMenu />)
+  const anchor = screen.getByRole('button', { name: 'Open' })
+  anchor.focus()
+  fireEvent.click(screen.getByRole('menuitem', { name: 'Copy' }))
+  await act(async () => { await new Promise(resolve => { setTimeout(resolve, 40) }) })
+  expect(document.activeElement).toBe(anchor)
+})
+
+it('leaves focus where the owner moved it before the menu closed', async () => {
+  render(<DelayedMenu moveFocus={() => { screen.getByRole('button', { name: 'Elsewhere' }).focus() }} />)
+  fireEvent.click(screen.getByRole('menuitem', { name: 'Copy' }))
+  await act(async () => { await new Promise(resolve => { setTimeout(resolve, 40) }) })
+  expect(document.activeElement).toBe(screen.getByRole('button', { name: 'Elsewhere' }))
+})
