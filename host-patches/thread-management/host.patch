+/** Derived SDK output follows the native current branch while returned journals remain physical. */
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { projectActiveBranch, type SessionEvent } from '@deepseek-ai/dsh-session'
+import { describe, expect, it } from 'vitest'
+import { createProcessDeepSeekHarness, finalResponse } from '../src/api.ts'
+import { SdkProtocolError } from '../src/client.ts'
+
+const fixturePath = fileURLToPath(new URL('./active-branch-parity.json', import.meta.url))
+const runtimePath = fileURLToPath(new URL('./branch-fixture-runtime.mjs', import.meta.url))
+const fixture = JSON.parse(readFileSync(fixturePath, 'utf8')) as {
+  events: SessionEvent[]
+  cases: Array<{ name: string; start: number; end: number; response: string; finishReason: string | null }>
+}
+
+function harness(caseName: string, malformed?: string) {
+  return createProcessDeepSeekHarness({
+    command: process.execPath,
+    args: [runtimePath, fixturePath, caseName, ...(malformed === undefined ? [] : [malformed])],
+    environment: () => ({}),
+    description: 'keyless branch fixture runtime',
+    initializeTimeoutMs: 5_000,
+  })
+}
+
+describe('SDK active-branch derived output', () => {
+  it.each(fixture.cases)('$name keeps raw events and derives the current result', async (scenario) => {
+    const events = fixture.events.filter(event => scenario.start <= event.seq && event.seq <= scenario.end)
+    const before = JSON.stringify(events)
+    expect(finalResponse(events)).toBe(scenario.response)
+    expect(JSON.stringify(events)).toBe(before)
+    const current = projectActiveBranch(events)
+    expect(current.findLast(event => event.type === 'turn/end')?.data.reason.kind ?? null).toBe(scenario.finishReason)
+    await using sdk = harness(scenario.name)
+    const seen: object[] = []
+    const result = await sdk.run('replay', { sessionId: 'sdk-branch', onNotification: notification => { seen.push(notification) } })
+    expect(result.finalResponse).toBe(scenario.response)
+    expect(result.events.slice(1)).toEqual(events)
+    expect(result.notifications.filter(notification => notification.method === 'session.event').map(notification => notification.params.event).slice(1)).toEqual(events)
+    expect(seen).toEqual(result.notifications)
+  })
+
+  it.each(['data', 'anchor', 'prompt', 'sequence', 'prior-sequence'])('reports malformed branch wire %s as SdkProtocolError', async (malformed) => {
+    await using sdk = harness('cut without replacement retains prefix', malformed)
+    await expect(sdk.run('reject malformed branch')).rejects.toThrow(SdkProtocolError)
+  })
+})
