+      return { sessionId: request.sessionId, branchRevision: revision }
+    })
+  }
+
+  /**
+   * Delete one session. Ordinary project directories stay. Free owned directories go.
+   * @param sessionId - session to delete.
+   * @param requestId - caller idempotency key. A deleted id returns deleted again.
+   * @returns the terminal or retryable phase.
+   */
+  delete(sessionId: SessionId, requestId: string): Promise<SessionDeleteValue> {
+    void requestId
+    return this.run(sessionId, async () => {
+      await this.requireDurable()
+      if (!this.canDelete) throw new RemoteError('session/lifecycle-unavailable', 'session persistence backend does not support deletion', {})
+      const current = this.table?.get(sessionId)
+      if (current?.phase === 'deleted') return { sessionId, phase: 'deleted' as const }
+      const session = this.ctx.sessions.get(sessionId)
+      // Imported cold headers remain readable; absence of a domain row never grants ordinary cleanup rights over a free root.
+      const stored = current === undefined && session === undefined ? await this.ctx.get('sessionPersistence')?.stat(sessionId) : undefined
+      const header = session?.header ?? stored?.header
+      const classification = current?.classification ?? header?.classification ?? 'ordinary'
+      const ownedDirectory = current?.ownedDirectory ?? header?.ownedDirectory
+      const deleting: SessionLifecycleRecord = {
+        ...current,
+        phase: 'deleting',
+        classification,
+        ...(ownedDirectory === undefined ? {} : { ownedDirectory }),
+      }
+      await this.put(sessionId, deleting)
+      try {
+        await this.finishDelete(sessionId, deleting)
+        return { sessionId, phase: 'deleted' as const }
+      } catch (error: unknown) {
+        await this.put(sessionId, {
+          ...deleting,
+          ...this.table?.get(sessionId),
+          phase: 'cleanup-pending',
+          classification,
+          ...(ownedDirectory === undefined ? {} : { ownedDirectory }),
+          error: error instanceof Error ? error.message : String(error),
+        })
+        throw new RemoteError('session/delete-pending', `session "${sessionId}" cleanup is incomplete`, {
+          sessionId,
+          reason: error instanceof Error ? error.message : String(error),
+        })
+      }
+    })
+  }
+
+  /**
+   * Copy a free session's owned root into a new owned root, skipping links that leave the source.
+   * @param sourceId - free session being forked.
+   * @param childId - new free session id.
+   * @returns the child owned directory.
+   */
+  forkFreeDirectory(sourceId: SessionId, childId: SessionId, ownedDirectory: string): Promise<string> {
+    return this.run(childId, async () => {
+      await this.assertUsable(sourceId)
+      await this.assertUsable(childId)
+      const source = this.ctx.sessions.get(sourceId)
+      const classification = source?.header.classification
+        ?? this.table?.get(sourceId)?.classification
+      const owned = source?.header.ownedDirectory ?? ownedDirectory
+      if (classification !== 'free' || owned !== ownedDirectory) {
+        throw new RemoteError('session/fork-unavailable', `session "${sourceId}" is not a free session`, {
+          sessionId: sourceId,
+        })
+      }
+      this.assertFreeForkQuiet(sourceId)
+      const target = await this.beginFreeSession(childId)
+      const sourceRecord = this.table?.get(sourceId)
+      const targetRecord = this.table?.get(childId)
+      if (sourceRecord === undefined || targetRecord === undefined) throw new Error('free fork has no durable ownership record')
+      await copyFreeDirectory(sourceId, sourceRecord, childId, targetRecord)
+      this.assertFreeForkQuiet(sourceId)
+      return target
+    })
+  }
+
+  private async open(): Promise<void> {
+    if (this.admission !== undefined) await this.admission.whenReady()
+  }
+
+  private async replay(): Promise<void> {
+    if (this.table === undefined) return
+    for (const [id, record] of this.table.entries()) {
+      const sessionId = brandString<SessionId>(id)
+      try {
+        if (record.phase === 'creating' && record.ownedDirectory !== undefined) {
+          if (record.rootRemoval === 'final') {
+            if (await this.ctx.get('sessionPersistence')?.stat(sessionId) !== undefined) throw new Error('interrupted allocation cleanup acquired a session log; preserve it for inspection')
+            await this.removeDirectory(sessionId, record)
+            await this.put(sessionId, { ...record, phase: 'deleted' })
+            continue
+          }
+          const exists = await verifyDirectoryProof(sessionId, record)
+          const persisted = this.ctx.get('sessionPersistence')
+          const stat = persisted === undefined ? undefined : await persisted.stat(sessionId)
+          if (stat !== undefined && (!exists || stat.header.classification !== 'free' || stat.header.ownedDirectory !== record.ownedDirectory)) {
+            throw new Error('persisted free session does not match its owned workspace allocation')
+          }
+          if (stat === undefined && exists) await this.removeDirectory(sessionId, record)
+          await this.put(sessionId, { ...record, phase: stat === undefined ? 'deleted' : 'active' })
