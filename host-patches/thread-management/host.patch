+        expectedRevision: receipt.expectedRevision,
+        expectedInputRevision: receipt.inputRevision,
+      }, anchor.event)
+      if (!preview.eligible) {
+        throw new RetryCutRefusal('session/retry-blocked', preview.reason ?? 'retry is blocked', {
+          sessionId: agent.id,
+          reason: preview.reason ?? 'blocked',
+          blockers: preview.blockers ?? [],
+        })
+      }
+      const prompt = replacePromptText(anchor.event.data, receipt.text)
+      agent.session.append('session/active-branch', {
+        revision: receipt.revision,
+        anchorSeq: anchor.event.seq,
+        messageId: receipt.messageId,
+        requestId: receipt.requestId,
+        expectedRevision: receipt.expectedRevision,
+        inputRevision: receipt.inputRevision,
+        ...(receipt.text === undefined ? {} : { text: receipt.text }),
+        prompt,
+      })
+      await this.flush(agent.session)
