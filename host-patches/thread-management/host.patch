+    try {
+      initial.resolve(err(new RemoteError('gateway/internal', 'catalog index unavailable', {})))
+      await vi.waitFor(() => {
+        expect(sessions.list.getSnapshot()).toMatchObject({
+          ids: [], phase: 'error', error: { code: 'gateway/internal', message: 'catalog index unavailable' },
+        })
+      })
+      expect(remoteErrorOf(sessions.list.getSnapshot().error)?.code).toBe('gateway/internal')
+      await sessions.refresh()
+      await vi.waitFor(() => { expect(sessions.list.getSnapshot()).toMatchObject({ ids: [], phase: 'ready', error: null }) })
+      expect(changes).toContain('error')
+      expect(changes).toContain('ready')
+    } finally {
+      stop()
+    }
+  }, 60_000)
+
+  it('reports a failed refresh after readiness, retains ordinary and free rows, and clears the error after recovery', async ({ mock, start }) => {
+    mock.load(sessionWorld)
+    mock.remote.session.list.mockResolvedValueOnce(ok({ items }))
+    const client = await start()
+    const sessions: ISessions = client.ctx.sessions
+    await vi.waitFor(() => { expect(sessions.list.getSnapshot().phase).toBe('ready') })
+    const before = sessions.list.getSnapshot()
+    mock.remote.session.list.mockResolvedValueOnce(err(new RemoteError('gateway/internal', 'refresh refused', {})))
+    await sessions.refresh()
+    await vi.waitFor(() => {
+      expect(sessions.list.getSnapshot()).toMatchObject({
+        phase: 'error', ids: before.ids, byId: before.byId,
+        error: { code: 'gateway/internal', message: 'refresh refused' },
+      })
+    })
+    using reference = sessions.retain(S1, { source: 'mainView' })
+    expect((await reference.ready).sessionId).toBe(S1)
+    expect(sessions.list.getSnapshot().byId[S2]?.classification).toBe('free')
+    mock.remote.session.list.mockResolvedValueOnce(ok({ items }))
+    await sessions.refresh()
+    await vi.waitFor(() => { expect(sessions.list.getSnapshot()).toMatchObject({ phase: 'ready', error: null }) })
+    expect(sessions.list.getSnapshot().ids).toEqual(before.ids)
+  })
+})
