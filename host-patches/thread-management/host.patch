+    messageId: string
+    expectedRevision: number
+    expectedInputRevision: string
+    requestId: string
+    text?: string
+  }): Promise<SessionRetryValue> {
+    return this.run(request.sessionId, async () => {
+      await this.assertUsable(request.sessionId)
+      const agent = await this.requireAgent(request.sessionId)
+      await this.requireDurable()
+      const existing = await this.idempotent(agent, request)
+      if (existing !== undefined) return { sessionId: request.sessionId, branchRevision: existing }
+      const preview = await this.inspect(agent, request.messageId)
+      if (!preview.eligible) {
+        throw new RemoteError('session/retry-blocked', preview.reason ?? 'retry is blocked', {
+          sessionId: request.sessionId,
+          reason: preview.reason ?? 'blocked',
+          blockers: preview.blockers ?? [],
+        })
+      }
+      if (preview.branchRevision !== request.expectedRevision) {
+        throw new RemoteError('session/retry-revision', 'branch revision changed', {
+          sessionId: request.sessionId,
+          expectedRevision: request.expectedRevision,
+          branchRevision: preview.branchRevision,
+        })
+      }
+      try {
+        await this.stopWork(request.sessionId, true)
+      } catch (error: unknown) {
