@@ -0,0 +1,39 @@
+/** Keyless stdio runtime replaying shared SDK branch fixtures. */
+import { readFileSync } from 'node:fs'
+import { createInterface } from 'node:readline'
+
+const [fixturePath, caseName, malformed] = process.argv.slice(2)
+const fixture = JSON.parse(readFileSync(fixturePath, 'utf8'))
+const scenario = fixture.cases.find(item => item.name === caseName)
+const events = fixture.events.filter(event => scenario.start <= event.seq && event.seq <= scenario.end)
+const branch = events.find(event => event.type === 'session/active-branch')
+if (malformed === 'data') branch.data = null
+if (malformed === 'anchor') branch.data.anchorSeq = '43'
+if (malformed === 'prompt') branch.data.prompt = null
+if (malformed === 'sequence') delete branch.seq
+if (malformed === 'prior-sequence') delete events[0].seq
+
+function write(message) {
+  process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', ...message })}\n`)
+}
+
+const input = createInterface({ input: process.stdin })
+for await (const line of input) {
+  const request = JSON.parse(line)
+  if (request.method === 'initialize') {
+    write({ id: request.id, result: { serverInfo: { name: 'branch-fixture', version: '1' } } })
+  } else if (request.method === 'session/prompt') {
+    const sessionId = request.params.sessionId
+    write({ method: 'session.event', params: { sessionId, event: {
+      type: 'agent/inbox/spliced', seq: scenario.start - 1, time: 0,
+      data: { target: 'next-turn', start: 0, inserted: [{ id: 'fixture-receipt' }] },
+    } } })
+    write({ id: request.id, result: { messageId: 'fixture-receipt' } })
+    for (const event of events) write({ method: 'session.event', params: { sessionId, event } })
+    write({ method: 'session.status', params: { sessionId, status: 'idle' } })
+  } else if (request.method === 'shutdown') {
+    write({ id: request.id, result: {} })
+    input.close()
+    break
+  }
+}
