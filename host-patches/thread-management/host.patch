+import type { Context, Fiber } from '@deepseek-ai/cordis'
+import { join } from 'node:path'
+import Storage from '@deepseek-ai/dsh-storage'
+import * as StorageJson from '@deepseek-ai/dsh-storage-json'
+import * as StorageDomain from '@deepseek-ai/dsh-storage-domain'
+
+/** Mount the normal durable admission owner without WebSessionController. */
+export async function mountAdmissionStorage(ctx: Context, root: string): Promise<Fiber> {
+  await ctx.plugin(Storage)
+  await ctx.plugin(StorageJson, { root: join(root, 'lifecycle-storage') })
+  const domain = await ctx.plugin(StorageDomain, { backend: 'json' })
+  await ctx.sessionPersistence.admission.whenReady()
+  return domain
+}
