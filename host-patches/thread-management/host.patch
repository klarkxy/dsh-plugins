+  /**
+   * Whether this request's own attempt reached a durable terminal model result.
+   * An assistant tool call, an interrupted or partial message, a synthetic
+   * closer, and a later human turn do not count. A later branch is not this result.
+   */
+  private durableModelResult(session: Session, requestId: string): boolean {
+    const branch = this.branchEvent(session, requestId)
+    if (branch === undefined) return false
+    const events = session.snapshotEvents()
+    const nextBranch = events.find(event => event.type === 'session/active-branch' && event.seq > branch.seq)?.seq
+    let laterHuman = false
+    const turns = new Map<number, { assistant: boolean; reason?: string; terminalStream: boolean }>()
+    for (const event of events) {
+      if (event.seq <= branch.seq) continue
+      if (nextBranch !== undefined && event.seq >= nextBranch) break
+      if (event.type === 'user/message' && event.data.source.kind === 'user') {
+        laterHuman = true
+        continue
