+/** Passive Session observers replace their history after another caller changes the active branch. */
+import { RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import { SessionId, SessionSeq } from '@deepseek-ai/dsh-session/types'
+import { createClientTest, webApp } from '@deepseek-ai/dsh-client-test-runtime/src/assembly/index.ts'
+import { afterEach, describe, expect, vi } from 'vitest'
+import { SessionEventStream } from '../src/client/transport.ts'
+import type { SessionPage } from '../src/types.ts'
+import { historyValue, plainTurn } from './event-script.client.ts'
+import { sessionBench } from './remote/bench.client.ts'
+import { FOLLOW, followScript, history } from './remote/session.client.ts'
+
+const it = createClientTest({ roster: webApp.closure(['@deepseek-ai/dsh-api-gateway']) })
+const SID = SessionId('passive-branch')
+const oldTurn = plainTurn(SessionSeq(0), 0, 'OLD_PROMPT', 'OLD_REPLY')
+const newTurn = plainTurn(SessionSeq(0), 0, 'NEW_PROMPT', 'NEW_REPLY')
+const moved = (revision: number) => new RemoteError('session/branch-moved', 'branch changed', { sessionId: SID, branchRevision: revision })
+
+afterEach(() => { vi.restoreAllMocks() })
+
+describe('passive active-branch refresh', () => {
+  it('retains the prior window until the fresh baseline then replaces superseded rows, including later branch changes', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID)
+    mock.stream(FOLLOW, followScript(history(oldTurn)))
+    await session.open()
+    const prior = session.eventSource.getSnapshot()
+    const replacement = Promise.withResolvers<SessionPage>()
+    mock.stream(FOLLOW, followScript(async () => ({ ok: true, value: await replacement.promise }), { branchRevision: 1 }))
+    mock.streams.fail(FOLLOW, moved(1))
+    await vi.waitFor(() => { expect(mock.log.requests(FOLLOW)).toHaveLength(2) })
+    expect(session.eventSource.getSnapshot()).toBe(prior)
+    replacement.resolve(historyValue(newTurn))
+    await vi.waitFor(() => {
+      expect(session.getSnapshot()).toMatchObject({ openState: 'open', openError: null })
+      expect(JSON.stringify(session.eventSource.getSnapshot().entries)).toContain('NEW_REPLY')
+    })
+    expect(JSON.stringify(session.eventSource.getSnapshot().entries)).not.toContain('OLD_REPLY')
+    expect(session.eventSource.getSnapshot().change.kind).toBe('replace')
+
+    mock.stream(FOLLOW, followScript(history(plainTurn(SessionSeq(0), 0, 'SECOND_PROMPT', 'SECOND_REPLY')), { branchRevision: 2 }))
+    mock.streams.fail(FOLLOW, moved(2))
+    await vi.waitFor(() => {
+      expect(mock.log.requests(FOLLOW)).toHaveLength(3)
+      expect(JSON.stringify(session.eventSource.getSnapshot().entries)).toContain('SECOND_REPLY')
+    })
+    expect(JSON.stringify(session.eventSource.getSnapshot().entries)).not.toContain('NEW_REPLY')
+    expect(session.getSnapshot()).toMatchObject({ openState: 'open', openError: null })
+  }, 60_000)
+
+  it('recovers a movement that races the first opening snapshot', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID)
+    let opens = 0
+    mock.stream(FOLLOW, (...args) => {
+      if (++opens === 1) throw moved(1)
+      return followScript(history(newTurn), { branchRevision: 1 })(...args)
+    })
+    await session.open()
+    expect(mock.log.requests(FOLLOW)).toHaveLength(2)
+    expect(session.getSnapshot()).toMatchObject({ openState: 'open', openError: null })
+    expect(JSON.stringify(session.eventSource.getSnapshot().entries)).toContain('NEW_REPLY')
+  })
+
+  it('stops when branches keep changing before any replacement baseline arrives', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID)
+    let opens = 0
+    mock.stream(FOLLOW, () => { throw moved(++opens) })
+    await session.open()
+    expect(mock.log.requests(FOLLOW)).toHaveLength(2)
+    expect(session.getSnapshot()).toMatchObject({ openState: 'error', openError: { code: 'session/branch-moved', details: { branchRevision: 2 } } })
+  })
+
+  it.for(['duplicate', 'unacknowledged'] as const)('keeps a %s movement terminal instead of retrying blindly', async (kind, { mock, start }) => {
+    const session = await sessionBench(mock, start, SID)
+    mock.stream(FOLLOW, followScript(history(oldTurn)))
+    await session.open()
+    mock.stream(FOLLOW, followScript(history(newTurn), { branchRevision: kind === 'duplicate' ? 1 : 0 }))
+    mock.streams.fail(FOLLOW, moved(1))
+    await vi.waitFor(() => { expect(JSON.stringify(session.eventSource.getSnapshot().entries)).toContain('NEW_REPLY') })
+    mock.streams.fail(FOLLOW, moved(kind === 'duplicate' ? 1 : 2))
+    await vi.waitFor(() => {
+      expect(session.getSnapshot()).toMatchObject({ openState: 'error', openError: { code: 'session/branch-moved' } })
+    })
+    expect(mock.log.requests(FOLLOW)).toHaveLength(2)
+    mock.stream(FOLLOW, followScript(history(newTurn), { branchRevision: 2 }))
+    await session.resync()
+    expect(mock.log.requests(FOLLOW)).toHaveLength(3)
+    expect(session.getSnapshot()).toMatchObject({ openState: 'open', openError: null })
+  })
+
+  it('keeps ordinary passive stream failures terminal', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID)
+    mock.stream(FOLLOW, followScript(history(oldTurn)))
+    await session.open()
+    mock.streams.fail(FOLLOW, new RemoteError('session/not-found', 'deleted', { sessionId: SID }))
+    await vi.waitFor(() => { expect(session.getSnapshot().openError?.code).toBe('session/not-found') })
+    expect(mock.log.requests(FOLLOW)).toHaveLength(1)
+    expect(JSON.stringify(session.eventSource.getSnapshot().entries)).toContain('OLD_REPLY')
+  })
+
+  it('does not reopen a Session disposed while branch recovery awaits the old stream teardown', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID)
+    mock.stream(FOLLOW, followScript(history(oldTurn)))
+    await session.open()
+    const teardown = Promise.withResolvers<void>()
+    const dispose = SessionEventStream.prototype.dispose
+    const closing = vi.spyOn(SessionEventStream.prototype, 'dispose').mockImplementationOnce(async function (this: SessionEventStream) {
+      const closed = dispose.call(this)
+      await teardown.promise
+      await closed
+    })
+    mock.streams.fail(FOLLOW, moved(1))
+    await vi.waitFor(() => { expect(closing).toHaveBeenCalledOnce() })
+    await session.dispose()
+    teardown.resolve()
+    await closing.mock.results[0]?.value
+    await Promise.resolve()
+    expect(mock.log.requests(FOLLOW)).toHaveLength(1)
+  })
+
+  it('lets the newest explicit resync own the replacement when an older teardown settles late', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID)
+    mock.stream(FOLLOW, followScript(history(oldTurn)))
+    await session.open()
+    const teardown = Promise.withResolvers<void>()
+    const dispose = SessionEventStream.prototype.dispose
+    vi.spyOn(SessionEventStream.prototype, 'dispose').mockImplementationOnce(async function (this: SessionEventStream) {
+      const closed = dispose.call(this)
+      await teardown.promise
+      await closed
+    })
+    const older = session.resync()
+    mock.stream(FOLLOW, followScript(history(newTurn), { branchRevision: 1 }))
+    const latest = session.resync()
+    await latest
+    teardown.resolve()
+    await older
+    expect(mock.log.requests(FOLLOW)).toHaveLength(2)
+    expect(session.getSnapshot()).toMatchObject({ openState: 'open', openError: null })
+    expect(JSON.stringify(session.eventSource.getSnapshot().entries)).toContain('NEW_REPLY')
+  })
+})
