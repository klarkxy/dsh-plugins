+"""Shared current-branch fixtures through derived helpers and the actual keyless stdio SDK."""
+from __future__ import annotations
+
+import copy
+import json
+import shutil
+from pathlib import Path
+
+import pytest
+
+from deepseek_harness import DeepSeekHarness, SdkProtocolError
+from deepseek_harness.api import final_response, finish_reason
+
+FIXTURE_ROOT = Path(__file__).resolve().parents[3] / "packages" / "sdk" / "client" / "tests"
+FIXTURE_PATH = FIXTURE_ROOT / "active-branch-parity.json"
+RUNTIME_PATH = FIXTURE_ROOT / "branch-fixture-runtime.mjs"
+FIXTURE = json.loads(FIXTURE_PATH.read_text(encoding="utf-8"))
+
+
+@pytest.mark.parametrize("scenario", FIXTURE["cases"], ids=lambda scenario: scenario["name"])
+def test_derived_helpers_follow_current_branch_without_changing_journal(scenario: dict) -> None:
+    events = [event for event in FIXTURE["events"] if scenario["start"] <= event["seq"] <= scenario["end"]]
+    before = copy.deepcopy(events)
+    assert final_response(events) == scenario["response"]
+    assert finish_reason(events) == scenario["finishReason"]
+    assert events == before
+
+
+@pytest.mark.parametrize("scenario", FIXTURE["cases"], ids=lambda scenario: scenario["name"])
+def test_stdio_run_keeps_raw_notifications_and_current_result(scenario: dict, tmp_path: Path) -> None:
+    node = shutil.which("node")
+    if node is None:
+        pytest.skip("requires Node for the shared keyless fixture runtime")
+    seen = []
+    with DeepSeekHarness(
+        _launch_args=(node, str(RUNTIME_PATH), str(FIXTURE_PATH), scenario["name"]),
+        cwd=str(tmp_path),
+    ) as sdk:
+        result = sdk.run("replay", session_id="sdk-branch", on_notification=seen.append)
+    events = [event for event in FIXTURE["events"] if scenario["start"] <= event["seq"] <= scenario["end"]]
+    assert result.final_response == scenario["response"]
+    assert result.finish_reason == scenario["finishReason"]
+    assert result.events[1:] == events
+    assert [notification.payload["event"] for notification in result.notifications if notification.method == "session.event"][1:] == events
+    assert result.notifications == seen
+
+
+@pytest.mark.parametrize("malformed", ["data", "anchor", "prompt", "sequence", "prior-sequence"])
+def test_stdio_run_reports_malformed_branch_as_protocol_error(malformed: str, tmp_path: Path) -> None:
+    node = shutil.which("node")
+    if node is None:
+        pytest.skip("requires Node for the shared keyless fixture runtime")
+    with DeepSeekHarness(
+        _launch_args=(node, str(RUNTIME_PATH), str(FIXTURE_PATH), "cut without replacement retains prefix", malformed),
+        cwd=str(tmp_path),
+    ) as sdk:
+        with pytest.raises(SdkProtocolError):
+            sdk.run("reject malformed branch")
