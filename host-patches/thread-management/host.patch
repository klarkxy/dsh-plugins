+  private async wakeRetry(agent: Agent, receipt: RetryReceipt): Promise<void> {
+    if (this.laterBranch(agent.session, receipt.requestId)) return
+    if (this.durableModelResult(agent.session, receipt.requestId) || await this.uncertainWrite(agent.session, receipt.requestId)) {
