+    // Quiescence precedes proof, and proof precedes removing either logs or owned files.
+    if (record.classification === 'free') await verifyDirectoryCleanup(sessionId, record)
+    for (const id of owned) {
+      await this.releaseOwnedLog(id)
+      const current = this.table?.get(id)
+      await this.tombstoneDeleted(id, current?.classification ?? 'ordinary', current?.ownedDirectory)
+    }
+    await this.releaseOwnedLog(sessionId)
+    if (record.classification === 'free' && record.ownedDirectory !== undefined) {
+      await this.removeDirectory(sessionId, record)
+    }
+    await this.tombstoneDeleted(sessionId, record.classification, record.ownedDirectory)
+  }
+
+  /** Keep a durable nonrecursive final-removal stage across marker unlink/rmdir interruption. */
+  private removeDirectory(sessionId: SessionId, record: SessionLifecycleRecord): Promise<void> {
+    return removeFreeDirectory(sessionId, record, async () => {
+      await this.put(sessionId, { ...this.table?.get(sessionId) ?? record, rootRemoval: 'final' })
+    })
+  }
+
+  /** Mark owned sessions deleting before any activation or log removal. */
+  private async closeAdmission(ids: readonly SessionId[]): Promise<void> {
+    for (const id of ids) {
+      const current = this.table?.get(id)
+      if (current?.phase === 'deleted' || current?.phase === 'deleting' || current?.phase === 'cleanup-pending') continue
+      await this.put(id, {
+        ...current,
+        phase: 'deleting',
+        classification: current?.classification ?? 'ordinary',
+        ...(current?.ownedDirectory === undefined ? {} : { ownedDirectory: current.ownedDirectory }),
+      })
+    }
+  }
+
+  /** Drop one session's agent and stored log. The caller writes the tombstone after owned files are gone. */
+  private async releaseOwnedLog(sessionId: SessionId): Promise<void> {
+    const loop = this.ctx.get('agentLoop')
+    if (loop !== undefined) await loop.releaseSession(sessionId)
+    const persistence = this.ctx.get('sessionPersistence')
+    if (persistence !== undefined) await persistence.delete(sessionId)
+    await this.ctx.get('sessionQuery')?.forgetSession(sessionId)
+  }
+
+  private async tombstoneDeleted(
+    sessionId: SessionId,
+    classification: 'ordinary' | 'free',
+    ownedDirectory?: string,
+  ): Promise<void> {
+    if (this.table?.get(sessionId)?.phase === 'deleted') return
+    await this.put(sessionId, {
+      ...this.table?.get(sessionId),
+      phase: 'deleted',
+      classification,
+      ...(ownedDirectory === undefined ? {} : { ownedDirectory }),
+    })
+  }
+
+  /**
+   * Persisted and resident subagent descendants, deepest first.
+   * Ordinary and free forks share `parentSession` and are not owned.
+   */
+  private async ownedDescendantIds(rootId: SessionId): Promise<SessionId[]> {
+    const nodes = new Map<SessionId, { parent?: SessionId }>()
+    const add = (id: SessionId, parent?: SessionId): void => {
+      if (nodes.has(id)) return
+      nodes.set(id, {
+        ...(parent === undefined ? {} : { parent }),
+      })
+    }
+    for (const session of this.ctx.sessions.list()) {
+      add(session.id, ownedSessionParent(session.header))
+    }
+    const persistence = this.ctx.get('sessionPersistence')
+    const query = this.ctx.get('sessionQuery')
+    if (query !== undefined && (persistence === undefined || typeof persistence.list === 'function')) {
+      for (const record of await query.listSessions()) {
+        add(record.header.id, ownedSessionParent(record.header))
+      }
+    } else if (typeof persistence?.list === 'function') {
+      for (const snapshot of await persistence.list()) {
+        add(snapshot.header.id, ownedSessionParent(snapshot.header))
+      }
+    }
+    const children = new Map<SessionId, SessionId[]>()
+    for (const [id, node] of nodes) {
+      if (node.parent === undefined) continue
+      const list = children.get(node.parent) ?? []
+      list.push(id)
+      children.set(node.parent, list)
+    }
+    const ordered: SessionId[] = []
+    const visited = new Set<SessionId>([rootId])
+    const visit = (parentId: SessionId): void => {
+      for (const childId of children.get(parentId) ?? []) {
+        if (visited.has(childId)) throw new Error('owned session lineage contains a cycle')
+        visited.add(childId)
+        visit(childId)
+        ordered.push(childId)
+      }
+    }
+    visit(rootId)
+    return ordered
+  }
+
+  private async stopWork(sessionId: SessionId, keepInbox: boolean, ownedIds: readonly SessionId[] = []): Promise<void> {
+    const ids = [...new Set([
+      sessionId,
+      ...ownedDescendants(this.ctx, sessionId).map(session => session.id),
+      ...ownedIds,
+    ])]
+    for (const id of ids) {
+      const agent = this.ctx.agents.get(id)
+      if (agent === undefined || agent.status !== 'running') continue
+      agent.cancel(id === sessionId ? { kind: 'user' } : { kind: 'parent' }, keepInbox ? { keepInbox: true } : undefined)
+    }
+    for (const id of ids) {
+      const agent = this.ctx.agents.get(id)
+      if (agent === undefined) continue
+      await agent.whenIdle()
+      if (agent.status === 'running') {
+        throw new Error(`session "${id}" was still running after cancel`)
+      }
+    }
+    for (const id of ids) {
+      const agent = this.ctx.agents.get(id)
+      if (agent === undefined) continue
+      await agent.runMaintenance(async () => {})
+      if (agent.status === 'running') throw new Error(`session "${id}" was still running after maintenance`)
+    }
+    const jobs = this.ctx.get('jobs')
+    if (jobs !== undefined) {
+      for (const id of ids) {
+        for (const job of jobs.list(id)) {
+          if (job.owner !== id || (job.status !== 'running' && job.status !== 'stopping')) continue
+          jobs.kill(job.id, id, 'session lifecycle')
+          const settled = await jobs.wait(job.id, 30_000, id)
+          if (settled.status === 'running' || settled.status === 'stopping') {
+            throw new Error(`job "${job.id}" did not settle`)
+          }
+        }
+      }
+    }
+    if (!keepInbox) {
+      const schedule = sessionSchedule(this.ctx)
+      if (schedule !== undefined) {
+        for (const id of ids) {
+          const tasks = await schedule.list({ sessionId: id })
+          for (const task of tasks) await schedule.delete({ sessionId: id, id: task.id })
+        }
+      }
+    }
+  }
+
+  private async requireDurable(): Promise<void> {
+    await this.ready
+    if (this.table === undefined || !this.durable) {
+      throw new RemoteError('session/lifecycle-unavailable', 'session lifecycle requires both domain storage and session persistence', {})
+    }
+  }
+
+  private async flush(session: Session): Promise<void> {
+    if (!await this.ctx.sessions.flush(session)) throw new RemoteError('session/lifecycle-unavailable', 'session persistence did not participate in the durability checkpoint', {})
+  }
+
+  private async put(sessionId: SessionId, record: SessionLifecycleRecord): Promise<void> {
+    const table = this.table
+    if (table === undefined) {
+      throw new RemoteError('session/lifecycle-unavailable', 'session lifecycle storage is not mounted', {})
+    }
+    const current = table.get(sessionId)
+    if (current !== undefined && !lifecycleTransition(current.phase, record.phase)) {
+      throw new RemoteError('session/deleted', `session "${sessionId}" is ${current.phase}`, { sessionId })
+    }
+    await table.put(sessionId, record)
+  }
+
+  private async putRetry(sessionId: SessionId, retry: RetryReceipt): Promise<void> {
+    const current = this.table?.get(sessionId)
+    const session = this.ctx.sessions.get(sessionId)
+    await this.put(sessionId, {
+      ...current,
+      phase: current?.phase === 'creating' ? 'creating' : 'active',
+      classification: current?.classification ?? session?.header.classification ?? 'ordinary',
+      ...(current?.ownedDirectory === undefined ? {} : { ownedDirectory: current.ownedDirectory }),
+      ...(current?.error === undefined ? {} : { error: current.error }),
+      retry,
+    })
+  }
+
+  private run<T>(sessionId: SessionId, operation: () => Promise<T>): Promise<T> {
+    return this.admission === undefined
+      ? this.ctx.sessions.admission.exclusive(sessionId, operation)
+      : this.admission.exclusive(sessionId, operation)
+  }
+}
+
+function humanInputRevision(agent: Agent): string {
+  const hash = createHash('sha256')
+  for (const event of projectActiveBranch(agent.session.snapshotEvents())) {
+    if (event.type !== 'user/message' || event.data.source.kind !== 'user') continue
+    hash.update(`${event.seq}\n${event.data.id}\n${messageText(event.data)}\n`)
+  }
+  for (const message of [...agent.inbox.nextTurn, ...agent.inbox.nextStep]) {
+    hash.update(`queue\n${message.id}\n${messageText(message)}\n`)
+  }
+  return hash.digest('hex')
+}
+
+function messageText(message: { content: readonly { type: string; text?: string }[] }): string {
+  return message.content.map(block => block.type === 'text' ? block.text ?? '' : '').join('\n')
+}
+
+function effectBlockers(session: Session, anchorSeq: number): string[] {
+  return eventEffectBlockers(projectActiveBranch(session.snapshotEvents()), anchorSeq)
+}
+
+function childBlocker(id: SessionId, blocker: string): string {
+  return blocker.startsWith('missing:') ? `missing:child:${id}:${blocker.slice(8)}` : `child:${id}:${blocker}`
+}
+
+/** Completed child work strictly before the parent anchor cannot affect replacement of that later prompt. */
+function eventEffectBlockers(active: readonly SessionEvent[], anchorSeq: number, sinceTime?: number): string[] {
+  type Effect = { effect: string; time: number; seq: SessionEvent['seq'] }
+  type Dispatch = { callId: string; name: string; seq: SessionEvent['seq']; time: number; kind: 'tool' | 'ptc'; turn?: number; step?: number; effects: Effect[]; end?: { time: number; aborted: boolean } }
+  const dispatches: Dispatch[] = []
+  const byId = new Map<string, Dispatch[]>()
+  const unpaired: { callId: string; effect: string }[] = []
+  const start = (dispatch: Dispatch): void => {
+    dispatches.push(dispatch)
+    const prior = byId.get(dispatch.callId) ?? []
+    prior.push(dispatch)
+    byId.set(dispatch.callId, prior)
+  }
+  for (const event of active) {
+    if (event.seq <= anchorSeq) continue
+    if (event.type === 'tool/call') start({ callId: event.data.callId, name: event.data.name, seq: event.seq, time: event.time, kind: 'tool', turn: event.data.turn, step: event.data.step, effects: [] })
+    else if (event.type === 'tool/ptc-dispatch-start') start({ callId: event.data.subCallId, name: event.data.name, seq: event.seq, time: event.time, kind: 'ptc', effects: [] })
+    else if (event.type === 'host/tool-effect') {
+      const dispatch = byId.get(event.data.callId)?.findLast(item => item.end === undefined && item.name === event.data.name)
+      if (dispatch === undefined) unpaired.push({ callId: event.data.callId, effect: event.data.effect })
+      else dispatch.effects.push({ effect: event.data.effect, time: event.time, seq: event.seq })
+    } else if (event.type === 'tool/result') {
+      const dispatch = byId.get(event.data.message.toolCallId)?.findLast(item => item.end === undefined && item.kind === 'tool'
+        && (event.sourceEventSeqs?.includes(item.seq) === true || (item.turn === event.data.turn && item.step === event.data.step)))
+      if (dispatch !== undefined) dispatch.end = { time: event.time, aborted: event.data.error?.code === 'ABORTED_BEFORE_DISPATCH' }
+    } else if (event.type === 'tool/ptc-dispatch') {
+      const dispatch = byId.get(event.data.subCallId)?.findLast(item => item.end === undefined && item.kind === 'ptc' && item.name === event.data.name)
+      if (dispatch !== undefined) dispatch.end = { time: event.time, aborted: event.data.error?.code === 'ABORTED_BEFORE_DISPATCH' }
+    }
+  }
+  const blockers: string[] = []
+  for (const dispatch of dispatches) {
+    const { callId, end } = dispatch
+    if (end?.aborted === true) continue
+    if (sinceTime !== undefined && dispatch.time < sinceTime && end !== undefined
+      && end.time < sinceTime && dispatch.effects.every(effect => effect.time < sinceTime)) continue
+    if (dispatch.effects.length === 0) {
+      blockers.push(`missing:${callId}`)
+      continue
+    }
+    for (const { effect } of dispatch.effects) if (!HOST_EFFECTS.has(effect) || effect !== 'read-only') blockers.push(`${effect}:${callId}`)
+  }
+  for (const { callId, effect } of unpaired) if (!HOST_EFFECTS.has(effect) || effect !== 'read-only') blockers.push(`${effect}:${callId}`)
+  return blockers
+}
+
+/** Session-scoped reminder methods used while releasing a deleted session. */
+interface SessionSchedule {
+  list(request: { sessionId: SessionId }): Promise<readonly { id: string }[]>
+  delete(request: { sessionId: SessionId; id: string }): Promise<unknown>
+}
+
+/**
+ * Resolve the host schedule service by name.
+ * This package does not reference the schedule project, because that project already references the session controller.
+ * @param ctx - host context that may provide `schedule`.
+ * @returns list and delete for one session, when the service is mounted.
+ */
+function sessionSchedule(ctx: Context): SessionSchedule | undefined {
+  const name: string = 'schedule'
+  const service: unknown = ctx.get(name)
+  if (service === undefined) return undefined
+  if (typeof service !== 'object' || service === null || !('catalog' in service) || !('delete' in service)) throw new Error('mounted schedule service does not support complete owner cleanup')
+  const { catalog, delete: remove } = service
+  if (typeof catalog !== 'function' || typeof remove !== 'function') throw new Error('mounted schedule service does not support complete owner cleanup')
+  return {
+    async list(request) {
+      const tasks: unknown = await catalog.call(service)
+      if (!Array.isArray(tasks)) throw new Error('schedule catalog did not return tasks')
+      const ids: { id: string }[] = []
+      for (const task of tasks) {
+        if (typeof task !== 'object' || task === null || !('id' in task) || typeof task.id !== 'string' || task.id.length === 0 || !('sessionId' in task) || typeof task.sessionId !== 'string') {
+          throw new Error('schedule catalog returned a task without an id or owner')
+        }
+        if (task.sessionId === request.sessionId) ids.push({ id: task.id })
+      }
+      return ids
+    },
+    delete(request) {
+      return remove.call(service, request)
+    },
+  }
+}
+
+function ownedDescendants(ctx: Context, rootId: SessionId): Session[] {
+  const all = ctx.sessions.list()
+  const children: Session[] = []
+  const visited = new Set<SessionId>([rootId])
+  const visit = (parentId: SessionId): void => {
+    for (const session of all) {
+      if (ownedSessionParent(session.header) !== parentId) continue
+      if (visited.has(session.id)) throw new Error('owned session lineage contains a cycle')
+      visited.add(session.id)
+      children.push(session)
+      visit(session.id)
+    }
+  }
+  visit(rootId)
+  return children
+}
+
+function replacePromptText(original: UserMessage, text: string | undefined): UserMessage {
+  if (text === undefined) return original
+  const attachments = original.content.filter(block => block.type !== 'text')
+  return { ...original, content: [{ type: 'text', text }, ...attachments] }
+}
+
+function lifecycleTransition(from: LifecyclePhase, to: LifecyclePhase): boolean {
+  if (from === to) return true
+  if (from === 'deleted') return false
+  if (from === 'deleting' || from === 'cleanup-pending') return to === 'deleted' || to === 'deleting' || to === 'cleanup-pending'
+  if (from === 'creating') return to === 'active' || to === 'deleted' || to === 'deleting'
+  return to === 'deleting' || to === 'cleanup-pending' || to === 'deleted'
+}
