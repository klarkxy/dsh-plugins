@@ -0,0 +1,51 @@
+/** Durable session-lifecycle records. The storage domain validates every write. */
+
+import { z } from 'zod'
+import { defineDomain, domainTable } from '@deepseek-ai/dsh-storage-domain'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+
+/** One logical same-session retry. `admitted` means the branch and receipt were accepted, not that a model result exists. */
+export const sessionRetryReceipt = z.object({
+  requestId: z.string(),
+  messageId: z.string(),
+  expectedRevision: z.number().int().nonnegative(),
+  revision: z.number().int().positive(),
+  /** Opaque admitted-input and pending-queue token. Absent tokens fail closed. */
+  inputRevision: z.string().min(1),
+  text: z.string().optional(),
+  /** `intent` precedes the branch event, `branched` precedes driver start, `admitted` follows that logical acceptance. */
+  stage: z.enum(['intent', 'branched', 'admitted']),
+})
+
+/** Tombstone and retry receipt stored outside the session log. */
+export const sessionLifecycleRecord = z.object({
+  phase: z.enum(['creating', 'active', 'deleting', 'cleanup-pending', 'deleted']),
+  classification: z.enum(['ordinary', 'free']),
+  ownedDirectory: z.string().optional(),
+  /** Allocation intent alone grants no cleanup rights; the matching marker proves this nonce. */
+  allocation: z.object({
+    nonce: z.string().min(1),
+    canonicalDirectory: z.string().optional(),
+    device: z.string().optional(),
+    inode: z.string().optional(),
+  }).optional(),
+  /** Proven contents are gone; recovery may only unlink a matching marker and rmdir this same physical root. */
+  rootRemoval: z.literal('final').optional(),
+  error: z.string().optional(),
+  retry: sessionRetryReceipt.optional(),
+})
+
+/** Validated lifecycle record. */
+export type SessionLifecycleRecord = z.infer<typeof sessionLifecycleRecord>
+
+/**
+ * One domain, one table, whole-unit atomic writes.
+ * The domain write chain serializes sessions; the JSON backend replaces the unit durably.
+ */
+export const sessionLifecycleDomain = defineDomain({
+  name: 'session_lifecycle',
+  version: 1,
+  tables: {
+    sessions: domainTable<SessionId, SessionLifecycleRecord>(sessionLifecycleRecord),
+  },
+})
