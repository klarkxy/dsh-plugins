@@ -208,8 +208,43 @@ def normalize_input(input: str | list[JsonObject]) -> list[JsonObject]:
     return input
 
 
+def _active_branch_events(events: list[JsonObject]) -> list[JsonObject]:
+    """Project logged branch decisions by physical sequence, including partial run intervals."""
+    branches = [event for event in events if event.get("type") == "session/active-branch"]
+    if not branches:
+        return events
+    for event in events:
+        seq = event.get("seq")
+        if type(seq) is not int or seq < 0 or seq > 9007199254740991:
+            raise SdkProtocolError("an active-branch activity interval requires physical event sequence numbers")
+    excluded: set[int] = set()
+    prompts: dict[int, JsonObject] = {}
+    for branch in branches:
+        data = branch.get("data")
+        anchor = data.get("anchorSeq") if isinstance(data, dict) else None
+        prompt = data.get("prompt") if isinstance(data, dict) else None
+        if (
+            type(anchor) is not int or anchor < 0 or anchor > 9007199254740991
+            or anchor >= branch["seq"] or not isinstance(prompt, dict)
+            or prompt.get("role") != "user" or not isinstance(prompt.get("id"), str)
+        ):
+            raise SdkProtocolError("session/active-branch event carried malformed branch data")
+        prompts[anchor] = prompt
+        for event in events:
+            if anchor < event["seq"] < branch["seq"]:
+                excluded.add(event["seq"])
+    current: list[JsonObject] = []
+    for event in events:
+        if event.get("type") == "session/active-branch" or event["seq"] in excluded:
+            continue
+        prompt = prompts.get(event["seq"])
+        current.append({**event, "data": prompt} if prompt is not None and event.get("type") == "user/message" else event)
+    return current
+
