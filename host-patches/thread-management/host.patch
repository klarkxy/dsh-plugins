+/** Canonical proof of free-session directory ownership for native admission and cleanup. */
+
+import { lstat, mkdir, readFile, realpath } from 'node:fs/promises'
+import { join, resolve } from 'node:path'
+import { resolveDshHome } from '@deepseek-ai/dsh-home-paths'
+import type { SessionLifecycleRecord } from './lifecycle-spec.ts'
+
+/** Exclusive owner marker inside a proven free-session root. */
+export const FREE_DIRECTORY_MARKER = '.dsh-session-owner.json'
+
+/**
+ * Reject aliases that cannot preserve an exact logical session identity.
+ * @param sessionId - logical session id used as one filesystem segment.
+ */
+export function assertFreeSessionSegment(sessionId: string): void {
+  if (sessionId.length === 0 || sessionId === '.' || sessionId === '..'
+    || /[\\/<>:"|?*\x00-\x1f]/.test(sessionId) || /[. ]$/.test(sessionId)
+    || /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i.test(sessionId)) {
+    throw new Error(`session id "${sessionId}" cannot name a free workspace directory`)
+  }
+}
+
+/**
+ * Prepare the canonical managed parent independently of exclusive leaf allocation.
+ * @param sessionId - exact leaf identity.
+ * @returns the canonical managed leaf path.
+ */
+export async function freeDirectoryPath(sessionId: string): Promise<string> {
+  const { parent, directory } = await freePaths(sessionId)
+  try {
+    await mkdir(parent)
+  } catch (error: unknown) {
+    if (!hasCode(error, 'EEXIST')) throw error
+  }
+  await assertManagedParent(parent)
+  return directory
+}
+
+/**
+ * Check the canonical path and physical root identity without regaining recursive cleanup rights.
+ * @param sessionId - exact logical owner.
+ * @param record - durable allocation record.
+ * @returns false only when the recorded root is absent.
+ */
+export async function verifyDirectoryIdentity(
+  sessionId: string,
+  record: Pick<SessionLifecycleRecord, 'ownedDirectory' | 'allocation'>,
+): Promise<boolean> {
+  const directory = record.ownedDirectory
+  if (directory === undefined) throw new Error('free workspace has no recorded directory; preserve its files and repair the lifecycle record')
+  const expected = await freePaths(sessionId)
+  if (resolve(directory) !== expected.directory) throw new Error('free workspace path does not match its exact recorded session identity')
+  await assertManagedParent(expected.parent)
+  let stats
+  try {
+    stats = await lstat(directory, { bigint: true })
+  } catch (error: unknown) {
+    if (hasCode(error, 'ENOENT')) return false
+    throw error
+  }
+  const allocation = record.allocation
+  if (allocation?.canonicalDirectory === undefined || allocation.device === undefined || allocation.inode === undefined) {
+    throw new Error('free workspace ownership is unproven; preserve its files and inspect the interrupted allocation before retrying cleanup')
+  }
+  if (!stats.isDirectory() || stats.isSymbolicLink()
+    || String(stats.dev) !== allocation.device || String(stats.ino) !== allocation.inode
+    || await realpath(directory) !== allocation.canonicalDirectory) {
+    throw new Error('free workspace root was substituted; restore the recorded owned directory before retrying cleanup')
+  }
+  return true
+}
+
+/**
+ * Require the canonical physical root and its exact session-ID/allocation-nonce marker.
+ * @param sessionId - exact logical owner.
+ * @param record - canonical lifecycle allocation record.
+ * @returns false only when the recorded root is absent.
+ */
+export async function verifyDirectoryProof(
+  sessionId: string,
+  record: Pick<SessionLifecycleRecord, 'ownedDirectory' | 'allocation'>,
+): Promise<boolean> {
+  const directory = record.ownedDirectory
+  const allocation = record.allocation
+  if (directory === undefined || allocation === undefined) throw new Error('free workspace has no recorded ownership proof')
+  if (!await verifyDirectoryIdentity(sessionId, record)) return false
+  const markerPath = join(directory, FREE_DIRECTORY_MARKER)
+  const markerStats = await lstat(markerPath).catch((error: unknown) => {
+    if (hasCode(error, 'ENOENT')) throw new Error('free workspace ownership marker is missing; preserve its files and inspect the interrupted allocation')
+    throw error
+  })
+  if (!markerStats.isFile() || markerStats.isSymbolicLink()) throw new Error('free workspace ownership marker was substituted')
+  const marker: unknown = JSON.parse(await readFile(markerPath, 'utf8'))
+  if (typeof marker !== 'object' || marker === null || !('sessionId' in marker) || !('nonce' in marker)
+    || marker.sessionId !== sessionId || marker.nonce !== allocation.nonce) {
+    throw new Error('free workspace ownership marker does not match its exact session id and allocation nonce')
+  }
+  return true
+}
+
+function hasCode(error: unknown, code: string): boolean {
+  return typeof error === 'object' && error !== null && 'code' in error && error.code === code
+}
+
+async function freePaths(sessionId: string): Promise<{ parent: string; directory: string }> {
+  assertFreeSessionSegment(sessionId)
+  const home = await realpath(resolveDshHome())
+  const parent = join(home, 'free-workspaces')
+  return { parent, directory: join(parent, sessionId) }
+}
+
+async function assertManagedParent(parent: string): Promise<void> {
+  const stats = await lstat(parent)
+  if (!stats.isDirectory() || stats.isSymbolicLink() || await realpath(parent) !== parent) {
+    throw new Error('free-workspaces must be the canonical managed directory inside the DSH home')
+  }
+}
