+import type { ApiSessionAgentController } from './agent.ts'
+import type { SessionLifecycleRecord } from './lifecycle-spec.ts'
+import { allocatedDirectoryIdentity, copyFreeDirectory, freeDirectoryPath, removeFreeDirectory, verifyDirectoryCleanup, verifyDirectoryProof, writeDirectoryProof } from './free-directory.ts'
+
+/** Durable phase stored outside the session log. */
+type LifecyclePhase = SessionLifecycleRecord['phase']
+
+/** Retry receipt carried on the tombstone until the rerun is woken. */
+type RetryReceipt = NonNullable<SessionLifecycleRecord['retry']>
+
+/** A local pre-commit cut refusal, never a persistence or provider failure. */
+class RetryCutRefusal extends RemoteError {}
+
+/** Preview of whether one human prompt can be replaced on the active branch. */
+export interface SessionRetryPreview {
+  readonly branchRevision: number
+  readonly inputRevision: string
+  readonly eligible: boolean
+  readonly reason?: string
+  readonly blockers?: readonly string[]
+}
+
+/** Committed retry. The session id does not change. */
+export interface SessionRetryValue {
+  readonly sessionId: SessionId
+  readonly branchRevision: number
+}
+
+/** Delete outcome. `deleted` is terminal only after required cleanup finishes. */
+export interface SessionDeleteValue {
+  readonly sessionId: SessionId
+  readonly phase: 'deleted' | 'cleanup-pending'
+}
+
+const HOST_EFFECTS = new Set(['read-only', 'filesystem-write', 'external-write', 'unknown'])
+
+/**
+ * Owns retry admission, free-workspace directories, and delete tombstones.
+ * Tombstones live beside the session log so a restart can finish cleanup.
+ */
+export class SessionLifecycle {
+  private ready: Promise<void>
+  private readonly admission: NativeSessionAdmission | undefined
+  private get table(): KvTable<SessionId, SessionLifecycleRecord> | undefined { return this.admission?.table }
+
+  /**
+   * Whether durable lifecycle storage is mounted. Retry, free create, and delete require it.
+   * @returns true when the storage domain facility is available.
+   */
+  get durable(): boolean {
+    return this.ctx.get('storageDomain') !== undefined && this.ctx.get('sessionPersistence') !== undefined && this.table !== undefined
+  }
+
+  /** Whether the mounted durable backend can actually remove its own stored generations. */
+  get canDelete(): boolean {
+    return this.durable && this.ctx.get('sessionPersistence')?.supportsDelete === true
+  }
+
+  /**
+   * @param ctx - host context with sessions, agents, and optional jobs, schedule, persistence, and storage.
+   * @param agents - session activation used after a tombstone check.
+   */
+  constructor(
+    private readonly ctx: Context,
+    private readonly agents: ApiSessionAgentController,
+  ) {
+    this.admission = ctx.get('sessionPersistence')?.admission
+    this.ready = this.open().then(() => this.replay())
+  }
+
+  /**
+   * Run one publication while the session's lifecycle lock is held, then re-check the tombstone.
+   * @param sessionId - session whose intake is frozen.
+   * @param operation - work that publishes input or creates the session.
+   * @returns the operation result.
+   */
+  exclusive<T>(sessionId: SessionId, operation: () => Promise<T>): Promise<T> {
+    return this.run(sessionId, async () => {
+      await this.assertUsable(sessionId)
+      return this.ctx.sessions.admission.run(sessionId, async () => {
+        const agent = this.ctx.agents.get(sessionId)
+        if (agent !== undefined) await this.recoverUnresolved(agent, 'idle')
+        return operation()
+      }, undefined, this.ctx.sessions.get(sessionId)?.header)
+    })
+  }
+
+  /** Bind source history observation and file copying to the same lifecycle operation. */
+  forFork<T>(sessionId: SessionId, operation: () => Promise<T>): Promise<T> {
+    return this.run(sessionId, async () => {
+      await this.assertUsable(sessionId)
+      if ((this.table?.get(sessionId)?.classification ?? this.ctx.sessions.get(sessionId)?.header.classification) === 'free') this.assertFreeForkQuiet(sessionId)
+      return operation()
+    })
+  }
+
+  /** Refuse a free fork while any source-owned producer can still change its files. */
+  assertFreeForkQuiet(sessionId: SessionId): void {
+    const ids = [sessionId, ...ownedDescendants(this.ctx, sessionId).map(session => session.id)]
+    for (const id of ids) {
+      const agent = this.ctx.agents.get(id)
+      if (agent?.status === 'running' || (agent !== undefined && agent.inbox.nextTurn.length + agent.inbox.nextStep.length > 0)
+        || this.ctx.get('jobs')?.list(id).some(job => job.owner === id && (job.status === 'running' || job.status === 'stopping')) === true) {
+        throw new RemoteError('session/agent-busy', 'Free chat is busy; wait for owned work to settle before forking.', { reason: 'free-session-work-active' })
+      }
+    }
+  }
+
+  /** Wait until restart cleanup has been attempted. */
+  async whenReady(): Promise<void> {
+    await this.ready
+  }
+
+  /**
+   * Refuse create, resume, prompt, and fork for a deleted or deleting id.
+   * @param sessionId - id the caller wants to use.
+   */
+  async assertUsable(sessionId: SessionId): Promise<void> {
+    await this.ready
+    const record = this.table?.get(sessionId)
+    if (record === undefined) return
+    if (record.phase === 'deleted' || record.phase === 'deleting' || record.phase === 'cleanup-pending') {
+      throw new RemoteError('session/deleted', `session "${sessionId}" is ${record.phase}`, { sessionId })
+    }
+    if (record.phase === 'creating' && record.error !== undefined) {
+      throw new RemoteError('session/allocation-pending', record.error, { sessionId })
+    }
+  }
+
+  /**
+   * Allocate a free-session directory before the session log exists.
+   * @param sessionId - new session id. It must be one path segment.
+   * @returns the absolute owned directory.
+   */
+  async beginFreeSession(sessionId: SessionId): Promise<string> {
+    await this.requireDurable()
+    await this.assertUsable(sessionId)
+    const existing = this.table?.get(sessionId)
+    if (existing?.phase === 'active' && existing.ownedDirectory !== undefined) {
+      if (!await verifyDirectoryProof(sessionId, existing)) throw new RemoteError('session/allocation-pending', 'owned free workspace is missing', { sessionId })
+      return existing.ownedDirectory
+    }
+    const ownedDirectory = await freeDirectoryPath(sessionId)
+    const nonce = randomUUID()
+    let record: SessionLifecycleRecord = {
+      phase: 'creating', classification: 'free', ownedDirectory, allocation: { nonce },
+    }
+    await this.put(sessionId, record)
+    try {
+      // EEXIST means occupied under the filesystem's own alias semantics. Never adopt or unlink it.
+      await mkdir(ownedDirectory)
+      const allocation = await allocatedDirectoryIdentity(ownedDirectory, nonce)
+      record = { ...record, allocation }
+      await this.put(sessionId, record)
+      await writeDirectoryProof(sessionId, ownedDirectory, allocation)
+    } catch (error: unknown) {
+      const reason = `free workspace allocation is incomplete: ${error instanceof Error ? error.message : String(error)}; preserve the occupied directory and inspect ownership before cleanup`
+      await this.put(sessionId, { ...record, error: reason })
+      throw new RemoteError('session/allocation-pending', reason, { sessionId })
+    }
