+          if (persistence === undefined) throw new Error('owned child has no persistence reader')
+          const handle = await persistence.open(id, 'read')
+          try { events = (await handle.read()).events; inheritedEventCount = handle.inheritedEventCount }
+          finally { await handle.close() }
+        }
+        const own = projectActiveBranch(events).filter(event => event.seq >= inheritedEventCount)
+        for (const event of own) {
+          if (event.type !== 'subagent/catalog') continue
+          ids.add(event.data.childId)
+          if (createdAfter.has(id) || event.time >= sinceTime) createdAfter.add(event.data.childId)
+        }
+        blockers.push(...eventEffectBlockers(own, -1, createdAfter.has(id) ? undefined : sinceTime).map(item => childBlocker(id, item)))
+      } catch (error: unknown) {
+        if (readFailures === 'throw') throw error
+        blockers.push(`missing:${id}:${error instanceof Error ? error.message : String(error)}`)
+      }
+    }
+    return blockers
+  }
