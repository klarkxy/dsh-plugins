+++ b/packages/session/session-format-v4-to-v5/src/codec.ts
@@ -0,0 +1,114 @@
+/** V5 framing over the released V4 codec. Event bytes stay V4; the header gains classification. */
+
+import { SessionFormatError, isSessionFormatJsonObject, sessionFormatCount, snapshotSessionFormatJson } from '@deepseek-ai/dsh-session-format'
+import type { SessionFormatCodec, SessionFormatCurrentEncoder, SessionFormatEvent, SessionFormatHeader, SessionFormatJsonObject, SessionFormatJsonValue } from '@deepseek-ai/dsh-session-format'
+import { releasedV4SessionFormatCodec } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+import { assertReleasedV5Header, assertV5RowAdmission, releasedV4HeaderView } from './validation.ts'
+
+/**
+ * Read classification fields from a physical V5 header, then present the rest as V4.
+ * @param value - untrusted physical header.
+ * @returns the V4 physical object plus the V5 fields to restore after decoding.
+ */
+function splitPhysicalHeader(value: unknown): {
+  v4: SessionFormatJsonObject
+  classification: SessionFormatJsonValue
+  ownedDirectory: SessionFormatJsonValue | undefined
+} {
+  if (!isSessionFormatJsonObject(value) || value['version'] !== 5) {
+    throw new SessionFormatError('expected format v5 physical header')
+  }
+  const v4: { [key: string]: SessionFormatJsonValue } = { version: 4 }
+  for (const [key, field] of Object.entries(value)) {
+    if (key === 'classification' || key === 'ownedDirectory' || key === 'version') continue
+    v4[key] = snapshotSessionFormatJson(field, `format v5 header ${key}`)
+  }
+  const classification = snapshotSessionFormatJson(value['classification'], 'format v5 header classification')
+  const ownedDirectory = Object.hasOwn(value, 'ownedDirectory')
+    ? snapshotSessionFormatJson(value['ownedDirectory'], 'format v5 header ownedDirectory')
+    : undefined
+  return { v4, classification, ownedDirectory }
+}
+
+function headerText(header: SessionFormatJsonObject, key: string): string | undefined {
+  const value = header[key]
+  if (value === undefined) return undefined
+  if (typeof value !== 'string') throw new SessionFormatError(`format v5 header ${key} must be a string`)
+  return value
+}
+
+function stampV5(
+  header: SessionFormatJsonObject,
+  classification: SessionFormatJsonValue,
+  ownedDirectory: SessionFormatJsonValue | undefined,
+): SessionFormatHeader {
+  if (classification !== 'ordinary' && classification !== 'free') {
+    throw new SessionFormatError('format v5 header classification must be "ordinary" or "free"')
+  }
+  const id = headerText(header, 'id')
+  if (id === undefined) throw new SessionFormatError('format v5 header id must be a string')
+  const cwd = headerText(header, 'cwd')
+  const parentSession = headerText(header, 'parentSession')
+  const origin = headerText(header, 'origin')
+  const agentPreset = headerText(header, 'agentPreset')
+  if (origin !== undefined && origin !== 'subagent') {
+    throw new SessionFormatError('format v5 header origin must be "subagent"')
+  }
+  const isSeeded = header['isSeeded']
+  if (typeof isSeeded !== 'boolean') throw new SessionFormatError('format v5 header isSeeded must be boolean')
+  const stamped: SessionFormatHeader = {
+    version: 5,
+    id,
+    createdAt: sessionFormatCount(header['createdAt'], 'format v5 header createdAt'),
+    isSeeded,
+    delegationDepth: sessionFormatCount(header['delegationDepth'], 'format v5 header delegationDepth'),
+    classification,
+    ...(cwd === undefined ? {} : { cwd }),
+    ...(parentSession === undefined ? {} : { parentSession }),
+    ...(origin === undefined ? {} : { origin }),
+    ...(agentPreset === undefined ? {} : { agentPreset }),
+    ...(typeof ownedDirectory === 'string' ? { ownedDirectory } : {}),
+  }
+  assertReleasedV5Header(stamped)
+  return typeof header['type'] === 'string' ? { ...stamped, type: header['type'] } : stamped
+}
+
+/**
+ * V5 physical encoder and decoder keep released V4 rows and add classification.
+ * A V4 reader rejects version 5. V5 rows that fail V4 admission still fail.
+ */
+export const releasedV5SessionFormatCodec = Object.freeze({
+  version: 5,
+  decodeHeader(value: unknown) {
+    const split = splitPhysicalHeader(value)
+    return stampV5(releasedV4SessionFormatCodec.decodeHeader(split.v4), split.classification, split.ownedDirectory)
+  },
+  createDecoder(value, recovery) {
+    const split = splitPhysicalHeader(value)
+    const decoder = releasedV4SessionFormatCodec.createDecoder(split.v4, recovery)
+    return {
+      ...decoder,
+      header: stampV5(decoder.header, split.classification, split.ownedDirectory),
+      decodeRow(row, context) {
+        assertV5RowAdmission(row)
+        decoder.decodeRow(row, {
+          emitRun: context.emitRun.bind(context),
+          emitEvent: context.emitEvent.bind(context),
+        })
+      },
+    }
+  },
+  encodeHeader(header, inheritedEventCount) {
+    assertReleasedV5Header(header)
+    const encoded = releasedV4SessionFormatCodec.encodeHeader(releasedV4HeaderView(header), inheritedEventCount)
+    const classification = header['classification']
+    if (classification === undefined) {
+      throw new SessionFormatError('format v5 header classification must be "ordinary" or "free"')
+    }
+    return stampV5(encoded, classification, header['ownedDirectory'])
+  },
+  encodeEvent(event: SessionFormatEvent) {
+    assertV5RowAdmission(event)
+    return releasedV4SessionFormatCodec.encodeEvent(event)
+  },
+} satisfies SessionFormatCodec & SessionFormatCurrentEncoder)
