+  private residentEffectBlockers(parent: Session, anchor: SessionEvent<'user/message'>): string[] {
+    const blockers = [...effectBlockers(parent, anchor.seq), ...this.runningJobs(parent.id)]
+    for (const child of ownedDescendants(this.ctx, parent.id)) {
+      if (this.ctx.agents.get(child.id)?.status === 'running') blockers.push(`running:${child.id}`)
+      blockers.push(...this.runningJobs(child.id))
+      const own = projectActiveBranch(child.snapshotEvents()).filter(event => event.seq >= child.inheritedEventCount)
