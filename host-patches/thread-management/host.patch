+// @vitest-environment jsdom
+/** Native navigation preserves an explicitly held free Session outside a refreshed catalog. */
+import { createClientTest, webApp } from '@deepseek-ai/dsh-client-test-runtime/src/assembly/index.ts'
+import { ok } from '@deepseek-ai/dsh-remote-mock'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import { expect, vi } from 'vitest'
+import { sessionWorld } from '../../../api/session-controller/tests/remote/session.client.ts'
+import type {} from '../src/client/navigation.ts'
+import { sessionMemberIds } from '../src/client/tree.ts'
+
+const it = createClientTest({ roster: webApp.closure(['@deepseek-ai/dsh-client-ui-workspace']) })
+const FREE = SessionId('selected-free-outside-catalog')
+
+it('opens a known free ID after a catalog refresh omits it and releases the selected ID after terminal deletion', async ({ mock, start }) => {
+  mock.load(sessionWorld)
+  mock.remote.session.create.mockResolvedValue(ok({ sessionId: FREE }))
+  mock.load({ unary: { 'session/delete': ok({ sessionId: FREE, phase: 'deleted' }) } })
+  const client = await start()
+  await vi.waitFor(() => { expect(client.ctx.get('uiWorkspace')).toBeDefined() })
+  await client.ctx.sessions.refresh()
+  const id = await client.ctx.sessions.create({ kind: 'free', sessionId: FREE })
+  expect(client.ctx.sessions.list.getSnapshot().byId[id]?.classification).toBe('free')
+  expect(sessionMemberIds(client.ctx.sessions.list.getSnapshot())).not.toContain(id)
+  using gateway = client.ctx.sessions.retain(id, { source: 'gateway' })
+  await gateway.ready
+  await client.ctx.sessions.refresh()
+  await client.flush()
+  expect(client.ctx.sessions.list.getSnapshot().ids).not.toContain(id)
+
+  client.ctx.uiWorkspace.openSession(id)
+  await client.flush()
+  expect(client.ctx.uiSession.adapter.current.getSnapshot().key).toBe(id)
+  expect(client.ctx.sessions.list.getSnapshot().byId[id]).toMatchObject({ classification: 'free', retainedBy: { gateway: 1, mainView: 1 } })
+  expect(sessionMemberIds(client.ctx.sessions.list.getSnapshot())).not.toContain(id)
+  const deleted = await client.ctx.uiWorkspace.deleteSession(id, 'delete-selection')
+  await client.flush()
+  expect(deleted).toEqual({ phase: 'deleted', releasedSelection: true })
+  expect(client.ctx.uiSession.adapter.current.getSnapshot().key).toBeUndefined()
+  expect(client.ctx.sessions.list.getSnapshot().byId[id]).toBeUndefined()
+})
