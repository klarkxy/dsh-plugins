+import type { FactoryComponentPropsOf } from '@deepseek-ai/dsh-client-ui-slots'
+
+type UserActionsHostProps = FactoryComponentPropsOf<'conversation.chat.userActions'>
+
+/**
+ * Render the shared user-action list for one durable prompt.
+ * @param props - Durable prompt id, plain text, and the authorized list renderer.
+ * @returns The list outlet. An empty list keeps the layout-neutral anchor.
+ */
+export function UserActionsHost({ messageId, text, renderSlot }: UserActionsHostProps) {
+  return renderSlot('conversation.chat.user-actions', { messageId, text })
+}
diff --git a/packages/client/ui-chat/tests/user-actions.client.spec.tsx b/packages/client/ui-chat/tests/user-actions.client.spec.tsx
new file mode 100644
--- /dev/null
+++ b/packages/client/ui-chat/tests/user-actions.client.spec.tsx
@@ -0,0 +1,315 @@
+// @vitest-environment jsdom
+/**
+ * Durable user and admitted-steering rows mount conversation.chat.user-actions
+ * through the production slot renderer. The probe records the owner props the
+ * list actually receives.
+ */
+import { brandString } from '@deepseek-ai/dsh-brand'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { afterEach, describe, expect, it } from 'vitest'
+import { cleanup, render } from '@testing-library/react'
+import { SlotTestRuntime, makeTranslate, usePinnedBrowserLanguages } from '@deepseek-ai/dsh-client-test-runtime'
+import { COMMON_NS, LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import type { PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { MessageId } from '@deepseek-ai/dsh-llm/brand'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { PendingSubmission, SessionReference } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { ChatNode } from '../src/client/contract/chat-nodes.ts'
+import type { ChatNodeHookContext, ChatNodeInjected, ChatNodeOwnerProps } from '../src/client/contract/slots.ts'
+import { contextForm, contextProducer } from '../src/client/conversation-nodes/event-projection.ts'
+import { registerChatNodeRenderers } from '../src/client/chat/register-node-renderers.ts'
+import { bindDisclosure } from '../src/client/chat/use-disclosure.ts'
+import { useTurnDataValue } from '../src/client/chat/use-turn-data.ts'
+import { PendingSteeringBubble, PendingSubmissionBubble } from '../src/client/chat/MessageItem.tsx'
+import { en, NS, zh } from '../src/client/locale.ts'
+import { derivePresentationPolicy } from '../src/client/presentation-policy.ts'
+import type { PerformanceUsageMode } from '../src/chat-settings.ts'
+
+usePinnedBrowserLanguages('en')
+
+const SID = 'session-user-actions' as SessionId
+const USER_ID = 'prompt-7f3a'
+const USER_KEY = 'engine-key-user'
+const USER_SEQ = 99
+const STEER_ID = 'steer-prompt-44'
+const STEER_NODE_ID = 'context-id-not-the-prompt'
+const STEER_KEY = 'engine-key-steer'
+const STEER_SEQ = 50
+const MESSAGE_TIME = 1_700_000_000_000
+const t = makeTranslate(en, commonEn)
+
+const references: SessionReference[] = []
+const disposers: Array<() => Promise<void>> = []
+
+afterEach(async () => {
+  cleanup()
+  for (const reference of references.splice(0)) reference.release()
+  for (const dispose of disposers.splice(0).reverse()) await dispose()
+})
+
+function Probe({ messageId, text }: PropsRuntime<'conversation.chat.user-actions'>) {
+  return <span data-prompt-id={messageId}>{text}</span>
+}
+
+function clockOf(time: number): string {
+  const date = new Date(time)
+  return `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`
+}
+
+function ownerOf<Kind extends ChatNode['kind']>(node: ChatNode<Kind>): ChatNodeOwnerProps & { node: ChatNode<Kind> } {
+  return {
+    node,
+    openSkill: () => {},
+    openFile: () => {},
+    inspectCall: undefined,
+    forkAt: () => {},
+    loadImage: () => Promise.reject(new Error('unused')),
+    renderMessageImages: () => null,
+    fileMentions: () => undefined,
+  }
+}
+
+function userNode(): ChatNode<'user'> {
+  return {
+    key: USER_KEY,
+    kind: 'user',
+    id: USER_ID,
+    target: 'chat',
+    anchorSeq: 4,
+    location: { kind: 'unresolved' },
+    visibility: 'visible',
+    data: {
+      kind: 'user',
+      seq: USER_SEQ,
+      time: MESSAGE_TIME,
+      content: [
+        { type: 'text', text: 'keep ' },
+        { type: 'reasoning', text: 'hidden-reasoning' },
+        { type: 'text', text: 'this' },
+      ],
+      source: { kind: 'user' },
+    },
+  }
+}
+
+function steeringNode(): ChatNode<'steering'> {
+  return {
+    key: STEER_KEY,
+    kind: 'steering',
+    id: STEER_NODE_ID,
+    target: 'chat',
+    anchorSeq: 8,
+    location: { kind: 'unresolved' },
+    visibility: 'visible',
+    data: {
+      kind: 'steering',
+      messageId: MessageId(STEER_ID),
+      seq: STEER_SEQ,
+      time: MESSAGE_TIME,
+      content: [{ type: 'text', text: 'turn left' }],
+      source: { kind: 'user' },
+    },
+  }
+}
+
+function contextNode(kind: 'context' | 'turn-trigger'): ChatNode<'context' | 'turn-trigger'> {
+  const source = { kind: 'schedule' }
+  return {
+    key: `${kind}-key`,
+    kind,
+    id: `${kind}-id`,
+    target: 'chat',
+    anchorSeq: 2,
+    location: { kind: 'unresolved' },
+    visibility: 'visible',
+    data: {
+      kind: 'context',
+      seq: 2,
+      time: MESSAGE_TIME,
+      content: [{ type: 'text', text: `${kind} body` }],
+      source,
+      producer: contextProducer(source),
+      form: contextForm(source),
+    },
+  }
+}
+
+async function bench(options: { probe?: boolean } = {}) {
+  const runtime = await SlotTestRuntime.create()
+  disposers.push(() => runtime.dispose())
+  const locale = new LocaleRuntime(runtime.ctx)
+  runtime.ctx.provide('locale', locale)
+  runtime.slots.installLocale(locale)
+  locale.register(COMMON_NS, { zh: commonZh, en: commonEn })
+  locale.register(NS, { zh, en })
+  const hookContext: ChatNodeHookContext = { turnData: undefined, disclosureReset: createSnapshotStore(0) }
+  const nodeInject: ChatNodeInjected = {
+    hooks: {
+      turnData: (_standard, { turnData }) => function useTurnData(key) {
+        return useTurnDataValue(turnData, key)
+      },
+      disclosure: (_standard, { disclosureReset }) => bindDisclosure(disclosureReset),
+    },
+  }
+  await runtime.declare({
+    'conversation.chat.node': { kind: 'keyed', scope: 'session', inject: nodeInject },
+  })
+  const probe = options.probe === false
+    ? undefined
+    : await runtime.mount({
+      inject: ['slots'],
+      apply: (ctx) => {
+        ctx.slots.inject('conversation.chat.user-actions', () => ctx.slots.register({
+          name: 'conversation.chat.user-actions',
+          id: 'probe',
+        }, Probe))
+      },
+    })
+  const performanceUsage = createSnapshotStore<PerformanceUsageMode>('compact')
+  const chat = await runtime.mount({
+    inject: ['slots'],
+    apply: (ctx) => {
+      registerChatNodeRenderers(ctx, performanceUsage, derivePresentationPolicy(createSnapshotStore('compact')))
+    },
+  })
+  await runtime.sessions.add({ id: SID })
+  const reference = runtime.sessions.retain(SID)
+  references.push(reference)
+  return { runtime, chat, probe, reference, hookContext }
+}
+
+function prompt(container: HTMLElement): HTMLElement | null {
+  const node = container.querySelector('[data-prompt-id]')
+  return node instanceof HTMLElement ? node : null
+}
+
+describe('conversation.chat.user-actions', () => {
+  it('gives a durable user row its Context id and the copy text', async () => {
+    const b = await bench()
+    expect(b.runtime.slots.spec('conversation.chat.user-actions')).toMatchObject({ kind: 'list', scope: 'session' })
+    const view = b.runtime.renderSlot('conversation.chat.node', ownerOf(userNode()), {
+      entryKey: 'user',
+      session: b.reference,
+      hookContext: b.hookContext,
+    })
+    const action = prompt(view.container)
+    expect(action?.getAttribute('data-prompt-id')).toBe(USER_ID)
+    expect(action?.getAttribute('data-prompt-id')).not.toBe(USER_KEY)
+    expect(action?.textContent).toBe('keep this')
+    expect(action?.textContent).not.toContain('hidden-reasoning')
+    expect(action?.textContent).not.toContain(String(USER_SEQ))
+    expect(view.view.getByRole('button', { name: 'Copy' })).toBeTruthy()
+    expect(view.container.textContent).toContain(clockOf(MESSAGE_TIME))
+    expect(view.container.textContent).toContain('keep this')
+  })
+
+  it('gives admitted steering its message id rather than the Context id, key, or sequence', async () => {
+    const b = await bench()
+    const view = b.runtime.renderSlot('conversation.chat.node', ownerOf(steeringNode()), {
+      entryKey: 'steering',
+      session: b.reference,
+      hookContext: b.hookContext,
+    })
+    const action = prompt(view.container)
+    expect(action?.getAttribute('data-prompt-id')).toBe(STEER_ID)
+    expect(action?.getAttribute('data-prompt-id')).not.toBe(STEER_NODE_ID)
+    expect(action?.getAttribute('data-prompt-id')).not.toBe(STEER_KEY)
+    expect(action?.textContent).toBe('turn left')
+    expect(view.view.getByRole('button', { name: 'Copy' })).toBeTruthy()
+  })
+
+  it('keeps copy and clock when nothing contributes an action', async () => {
+    const b = await bench({ probe: false })
+    expect(b.runtime.slots.entries('conversation.chat.user-actions')).toHaveLength(0)
+    const view = b.runtime.renderSlot('conversation.chat.node', ownerOf(userNode()), {
+      entryKey: 'user',
+      session: b.reference,
+      hookContext: b.hookContext,
+    })
+    expect(prompt(view.container)).toBeNull()
+    const actions = view.container.querySelector('[data-clock="start"]')
+    expect(actions?.querySelectorAll('button')).toHaveLength(1)
+    expect(view.view.getByRole('button', { name: 'Copy' })).toBeTruthy()
+    expect(view.container.textContent).toContain(clockOf(MESSAGE_TIME))
+    expect(view.container.textContent).toContain('keep this')
+  })
+
+  it('omits the list for pending steering, submission echoes, context, and turn triggers', async () => {
+    const b = await bench()
+    const pending = render(
+      <PendingSteeringBubble
+        content={[{ type: 'text', text: 'pending steer' }]}
+        renderMessageImages={() => null}
+        t={t}
+      />,
+    )
+    expect(pending.container.querySelector('[data-slot="conversation.chat.user-actions"]')).toBeNull()
+    expect(pending.container.querySelector('[data-pending-steering]')).not.toBeNull()
+    expect(pending.getByRole('button', { name: 'Copy' })).toBeTruthy()
+    pending.unmount()
+
+    const echo = render(
+      <PendingSubmissionBubble
+        submission={{
+          requestId: brandString<PendingSubmission['requestId']>('echo-1'),
+          placement: 'steering',
+          time: MESSAGE_TIME,
+          text: 'echo steer',
+          attachments: [],
+        }}
+        renderMessageImages={() => null}
+        t={t}
+      />,
+    )
+    expect(echo.container.querySelector('[data-slot="conversation.chat.user-actions"]')).toBeNull()
+    expect(echo.container.querySelector('[data-submission-echo]')).not.toBeNull()
+    expect(echo.getByRole('button', { name: 'Copy' })).toBeTruthy()
+    expect(echo.container.textContent).toContain(clockOf(MESSAGE_TIME))
+    echo.unmount()
+
+    const context = b.runtime.renderSlot('conversation.chat.node', ownerOf(contextNode('context')), {
+      entryKey: 'context',
+      session: b.reference,
+      hookContext: b.hookContext,
+    })
+    expect(context.container.textContent).toContain('Context injection')
+    expect(context.container.querySelector('[data-slot="conversation.chat.user-actions"]')).toBeNull()
+    expect(prompt(context.container)).toBeNull()
+
+    const trigger = b.runtime.renderSlot('conversation.chat.node', ownerOf(contextNode('turn-trigger')), {
+      entryKey: 'turn-trigger',
+      session: b.reference,
+      hookContext: b.hookContext,
+    })
+    expect(trigger.container.querySelector('[data-turn-trigger]')).not.toBeNull()
+    expect(trigger.container.querySelector('[data-slot="conversation.chat.user-actions"]')).toBeNull()
+    expect(prompt(trigger.container)).toBeNull()
+  })
+
+  it('removes the list when Chat unloads and restores a waiting contribution when Chat returns', async () => {
+    const b = await bench()
+    const view = b.runtime.renderSlot('conversation.chat.node', ownerOf(userNode()), {
+      entryKey: 'user',
+      session: b.reference,
+      hookContext: b.hookContext,
+    })
+    expect(prompt(view.container)?.getAttribute('data-prompt-id')).toBe(USER_ID)
+    await b.chat.dispose()
+    expect(b.runtime.slots.spec('conversation.chat.user-actions')).toBeUndefined()
+    expect(b.runtime.slots.entries('conversation.chat.user-actions')).toHaveLength(0)
+    expect(prompt(view.container)).toBeNull()
+    const performanceUsage = createSnapshotStore<PerformanceUsageMode>('compact')
+    await b.runtime.mount({
+      inject: ['slots'],
+      apply: (ctx) => {
+        registerChatNodeRenderers(ctx, performanceUsage, derivePresentationPolicy(createSnapshotStore('compact')))
+      },
+    })
+    expect(b.runtime.slots.entries('conversation.chat.user-actions')).toHaveLength(1)
+    view.update(ownerOf(userNode()), { entryKey: 'user', session: b.reference, hookContext: b.hookContext })
+    expect(prompt(view.container)?.getAttribute('data-prompt-id')).toBe(USER_ID)
+    expect(prompt(view.container)?.textContent).toBe('keep this')
+  })
+})
