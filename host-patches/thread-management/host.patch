+/** Same-session retry blockers, idempotency, and durable delete replay. */
+
+import { lstat, mkdtemp, mkdir, readFile, rm, symlink, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join, resolve } from 'node:path'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type { Agent, AgentHandle, CreateAgentOptions } from '@deepseek-ai/dsh-agent'
+import { AttachmentId } from '@deepseek-ai/dsh-attachment'
+import { resolveDshHome } from '@deepseek-ai/dsh-home-paths'
+import { createToolResultMessage, createUserMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { UserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId, projectActiveBranch } from '@deepseek-ai/dsh-session'
+import type { Session } from '@deepseek-ai/dsh-session'
+import Storage from '@deepseek-ai/dsh-storage'
+import { DomainFacility } from '@deepseek-ai/dsh-storage-domain'
+import { apply as applyStorageJson } from '@deepseek-ai/dsh-storage-json'
+import { RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import { SessionLifecycle } from '../src/lifecycle.ts'
+import { ApiSessionAgentController } from '../src/agent.ts'
+import { installSessionAdmission } from '@deepseek-ai/dsh-session-persistence'
+import { allocatedDirectoryIdentity, freeDirectoryPath, writeDirectoryProof } from '../src/free-directory.ts'
+import { createSessionTestController } from './test-remote.ts'
+
+const homes: string[] = []
+const previousHome = process.env['DSH_HOME']
+const finalRemovalFault = vi.hoisted(() => ({ path: undefined as string | undefined }))
+vi.mock('node:fs/promises', async importOriginal => {
+  const actual = await importOriginal<typeof import('node:fs/promises')>()
+  return {
+    ...actual,
+    rmdir: (async (...args: Parameters<typeof actual.rmdir>) => {
+      if (String(args[0]) === finalRemovalFault.path) throw new Error('injected final root removal failure')
+      return actual.rmdir(...args)
+    }) as typeof actual.rmdir,
+  }
+})
+
+afterEach(async () => {
+  finalRemovalFault.path = undefined
+  if (previousHome === undefined) delete process.env['DSH_HOME']
+  else process.env['DSH_HOME'] = previousHome
+  await Promise.all(homes.splice(0).map(home => rm(home, { recursive: true, force: true })))
+})
+
+async function isolatedHome(): Promise<string> {
+  const home = await mkdtemp(join(tmpdir(), 'dsh-lifecycle-'))
+  process.env['DSH_HOME'] = home
+  homes.push(home)
+  return home
+}
+
+async function harness(): Promise<Context> {
+  await isolatedHome()
+  const ctx = await contextWithoutHome()
+  createSessionTestController(ctx, {
+    defaultModelSelection: () => ({ provider: 'fixture', model: 'fixture-model' }),
+    cwd: '/tmp',
+  })
+  return ctx
+}
+
+function idleAgent(ctx: Context, session: Session, status: 'idle' | 'running' = 'idle'): Agent {
+  return {
+    id: session.id,
+    options: {},
+    session,
+    status,
+    ctx,
+    inbox: {
+      nextTurn: [] as UserMessage[],
+      nextStep: [] as UserMessage[],
+      clear() {},
+      append() {},
+      prepend() {},
+      replace: () => false,
+      remove: () => false,
+      splice: () => [],
+    },
+    cancel() {},
+    send() {},
+    followup() {},
+    steer: () => ({ outcome: Promise.resolve({ status: 'rejected' as const }) }),
+    inject() {},
+    whenIdle() { return Promise.resolve() },
+    continueFromBranch() {
+      session.append('turn/start', { turn: 1 })
+    },
+    runMaintenance(task) { return task(new AbortController().signal) },
+  }
+}
+
+async function promptSession(ctx: Context, id: string, text = 'hello'): Promise<{ session: Session; message: UserMessage }> {
+  const session = ctx.sessions.create(SessionId(id), { meta: { cwd: '/proj' } })
+  const message = createUserMessage({
+    content: [
+      { type: 'text', text },
+      {
+        type: 'image',
+        attachment: {
+          attachmentId: AttachmentId('att-1'),
+          mediaType: 'image/png',
+          bytes: 4,
+          width: 1,
+          height: 1,
+        },
+      },
+    ],
+    source: { kind: 'user' },
+  })
+  session.append('turn/start', { turn: 1 })
+  session.append('user/message', message, { surfaceOp: 'append' })
+  session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+  await ctx.agents.register(idleAgent(ctx, session))
+  return { session, message }
+}
+
+describe('session retry evidence', () => {
+  it('reports missing persistence and unsupported deletion honestly', async () => {
