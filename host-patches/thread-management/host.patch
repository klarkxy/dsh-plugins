+function installFactory(ctx: Context): void {
+  ctx.agents.setFactory({
+    async createAgent(_owner: Context, options: CreateAgentOptions): Promise<AgentHandle> {
+      const session = ctx.sessions.create(options.sessionId, {
+        ...(options.meta === undefined ? {} : { meta: options.meta }),
+      })
+      const agent = idleAgent(ctx, session)
+      await options.setup?.(ctx, agent)
+      await ctx.agents.register(agent)
+      return { agent, dispose: () => Promise.resolve() }
+    },
+    resume: () => Promise.reject(new Error('lifecycle edge tests do not resume')),
+  })
+}
