+import { describe, expect, it } from 'vitest'
+import { SessionFormatEventCollector } from '@deepseek-ai/dsh-session-format'
+import type { SessionFormatEvent, SessionFormatHeader } from '@deepseek-ai/dsh-session-format'
+import { releasedV4SessionFormatCodec } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+import { releasedV5SessionFormatCodec, sessionFormatV4ToV5 } from '../src/index.ts'
+
+const header: SessionFormatHeader = {
+  version: 4,
+  id: 'identity',
+  createdAt: 1,
+  isSeeded: false,
+  delegationDepth: 0,
+}
+const fact: SessionFormatEvent = { type: 'feedback/record', seq: 0, time: 2, data: { text: 'retained' } }
+
+describe('V4 to V5 identity migration', () => {
+  it('copies events and stamps ordinary classification', () => {
+    const before = JSON.stringify({ header, fact })
+    expect(sessionFormatV4ToV5.migrateHeader(header)).toEqual({
+      ...header,
+      version: 5,
+      classification: 'ordinary',
+    })
+    const stage = sessionFormatV4ToV5.createStage({
+      sourceHeader: header,
+      targetHeader: sessionFormatV4ToV5.migrateHeader(header),
+      sourceKind: 'decoded',
+      sourceInheritedEventCount: 0,
+    })
+    const output = new SessionFormatEventCollector()
+    stage.transformEvent(fact, output)
+    expect(stage.finish(output)).toBe(0)
+    expect(output.values).toEqual([fact])
+    expect(output.values[0]).toBe(fact)
+    expect(JSON.stringify({ header, fact })).toBe(before)
+  })
+
+  it('rejects a V5 header from the released V4 reader and round-trips it on the V5 codec', () => {
+    const physical = {
+      type: 'session',
+      version: 5,
+      id: 'identity',
+      createdAt: 1,
+      cwd: '/workspace',
+      isSeeded: false,
+      delegationDepth: 0,
+      classification: 'ordinary',
+    }
+    expect(() => releasedV4SessionFormatCodec.decodeHeader(physical)).toThrow(/format v4/)
+    const decoded = releasedV5SessionFormatCodec.decodeHeader(physical)
+    expect(decoded.version).toBe(5)
+    expect(decoded.classification).toBe('ordinary')
+    expect(releasedV5SessionFormatCodec.encodeHeader(decoded, 0).classification).toBe('ordinary')
+    expect(() => releasedV5SessionFormatCodec.decodeHeader({ ...physical, version: 4 })).toThrow(/format v5/)
+  })
+})
