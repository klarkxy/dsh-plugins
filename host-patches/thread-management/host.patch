@@ -0,0 +1,164 @@
+import { describe, expect, it } from 'vitest'
+import { foldSurface, projectActiveBranch, SessionSeq } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { UserMessage } from '@deepseek-ai/dsh-llm'
+
+function user(text: string, kind: 'user' | 'compact-checkpoint' = 'user'): UserMessage {
+  return createUserMessage({
+    content: [{ type: 'text', text }],
+    source: { kind } as never,
+  })
+}
+
+function event(
+  seq: number,
+  message: UserMessage,
+  surface: 'append' | { op: 'replace'; startSeq: number; endSeq: number } = 'append',
+  sourceEventSeqs?: number[],
+): SessionEvent {
+  return {
+    type: 'user/message',
+    seq: SessionSeq(seq),
+    time: seq + 1,
+    data: message,
+    surfaceOp: surface === 'append'
+      ? 'append'
+      : { op: 'replace', startSeq: SessionSeq(surface.startSeq), endSeq: SessionSeq(surface.endSeq) },
+    ...(sourceEventSeqs === undefined ? {} : { sourceEventSeqs: sourceEventSeqs.map(item => SessionSeq(item)) }),
+  }
+}
+
+function turnStart(seq: number, turn: number): SessionEvent {
+  return { type: 'turn/start', seq: SessionSeq(seq), time: seq + 1, data: { turn } }
+}
+
+function branch(
+  seq: number,
+  anchorSeq: number,
+  prompt: UserMessage,
+  fields: {
+    revision: number
+    expectedRevision: number
+    messageId: string
+    requestId: string
+    inputRevision: string
+    text?: string
+  },
+): SessionEvent {
+  return {
+    type: 'session/active-branch',
+    seq: SessionSeq(seq),
+    time: seq + 1,
+    data: {
+      revision: fields.revision,
+      expectedRevision: fields.expectedRevision,
+      anchorSeq: SessionSeq(anchorSeq),
+      messageId: fields.messageId,
+      requestId: fields.requestId,
+      inputRevision: fields.inputRevision,
+      prompt,
+      ...(fields.text === undefined ? {} : { text: fields.text }),
+    },
+  }
+}
+
+function texts(events: readonly SessionEvent[]): string[] {
+  const folded = foldSurface(events)
+  return folded.nodes.flatMap(seq => {
+    const item = events.find(candidate => candidate.seq === seq)
+    if (item === undefined) return []
+    const message = item.type === 'user/message'
+      ? folded.projectedMessages.get(seq) ?? item.data
+      : undefined
+    if (message === undefined || message.role !== 'user') return []
+    return [message.content.map(block => block.type === 'text' ? block.text : '').join('')]
+  })
+}
+
+describe('active branch prefix', () => {
+  it('keeps the human transcript and trace events when compaction has no branch cut', () => {
+    const first = user('Original human question')
+    const summary = user('Model compaction summary', 'compact-checkpoint')
+    const events = [
+      event(0, first),
+      turnStart(1, 1),
+      event(2, summary, { op: 'replace', startSeq: 0, endSeq: 0 }, [0]),
+    ]
+    expect(projectActiveBranch(events).map(item => item.seq)).toEqual([0, 1, 2])
+    expect(foldSurface(events).nodes).toEqual([2])
+  })
+
+  it('rebuilds the context a compaction removed before the edited target', () => {
+    const context = user('Context before the target')
+    const target = user('Original target')
+    const summary = user('Compacted entire history', 'compact-checkpoint')
+    const replacement = { ...target, content: [{ type: 'text' as const, text: 'Edited target' }] }
+    const events = [
+      event(0, context),
+      event(1, target),
+      event(2, summary, { op: 'replace', startSeq: 0, endSeq: 1 }, [0, 1]),
+      branch(3, 1, replacement, {
+        revision: 1,
+        expectedRevision: 0,
+        messageId: target.id,
+        requestId: 'probe-retry',
+        inputRevision: 'input',
+        text: 'Edited target',
+      }),
+    ]
+    expect(texts(events)).toEqual(['Context before the target', 'Edited target'])
+    expect(projectActiveBranch(events).map(item => item.seq)).toEqual([0, 1])
+  })
+
+  it('drops a compaction and a later human that sit after the selected prompt', () => {
+    const context = user('Context')
+    const first = user('First')
+    const summary = user('Summary', 'compact-checkpoint')
+    const later = user('Later human')
+    const edited = { ...first, content: [{ type: 'text' as const, text: 'Edited first' }] }
+    const events = [
+      event(0, context),
+      event(1, first),
+      event(2, summary, { op: 'replace', startSeq: 0, endSeq: 0 }, [0]),
+      event(3, later),
+      branch(4, 1, edited, {
+        revision: 1,
+        expectedRevision: 0,
+        messageId: first.id,
+        requestId: 'nested',
+        inputRevision: 'input',
+        text: 'Edited first',
+      }),
+    ]
+    expect(texts(events)).toEqual(['Context', 'Edited first'])
+  })
+
+  it('folds an earlier branch into the prefix of a later one', () => {
+    const context = user('Context')
+    const first = user('First')
+    const second = user('Second')
+    const editedFirst = { ...first, content: [{ type: 'text' as const, text: 'Edited first' }] }
+    const editedSecond = { ...second, content: [{ type: 'text' as const, text: 'Edited second' }] }
+    const events = [
+      event(0, context),
+      event(1, first),
+      branch(2, 1, editedFirst, {
+        revision: 1,
+        expectedRevision: 0,
+        messageId: first.id,
+        requestId: 'first',
+        inputRevision: 'one',
+      }),
+      event(3, second),
+      branch(4, 3, editedSecond, {
+        revision: 2,
+        expectedRevision: 1,
+        messageId: second.id,
+        requestId: 'second',
+        inputRevision: 'two',
+      }),
+    ]
+    expect(texts(events)).toEqual(['Context', 'Edited first', 'Edited second'])
+  })
+})
diff --git a/packages/core/session/tests/active-branch-replay.spec.ts b/packages/core/session/tests/active-branch-replay.spec.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/session/tests/active-branch-replay.spec.ts
@@ -0,0 +1,243 @@
+import { describe, expect, it } from 'vitest'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { UserMessage } from '@deepseek-ai/dsh-llm'
+import { deriveEventMessage, foldSurface, projectActiveBranch, Session, SessionId, SessionSeq } from '../src/index.ts'
+import type { SessionEvent, SessionMessageProjection } from '../src/index.ts'
+import { imageOffloadProjection } from '../../../compaction/compaction-image-offload/src/projection.ts'
+import { observationModelSurface } from '../../../session-query/session-query/src/observation.ts'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    'test/branch-replay-project': { seq: SessionSeq; suffix: string }
+  }
+}
+
+function user(text: string, kind: 'user' | 'compact-checkpoint' = 'user'): UserMessage {
+  return createUserMessage({ content: [{ type: 'text', text }], source: { kind } as never })
+}
+
+function appendUser(session: Session, text: string): SessionEvent<'user/message'> {
+  return session.append('user/message', user(text), { surfaceOp: 'append' })
+}
+
+function decide(session: Session, anchor: SessionEvent<'user/message'>, revision: number, text: string) {
+  const prompt = { ...anchor.data, content: [{ type: 'text' as const, text }] }
+  session.append('session/active-branch', {
+    revision, expectedRevision: revision - 1, anchorSeq: anchor.seq,
+    messageId: anchor.data.id, requestId: `branch-${revision}`, inputRevision: `input-${revision}`, prompt,
+  })
+  return prompt
+}
+
+function foldedMessages(events: readonly SessionEvent[], projections: readonly SessionMessageProjection[]) {
+  const folded = foldSurface(events, projections)
+  return folded.nodes.flatMap((seq) => {
+    const message = deriveEventMessage(events[seq]!, folded.projectedMessages)
+    return message === null ? [] : [message]
+  })
+}
+
+describe('bounded active branch replay', () => {
+  it('keeps 32 successive prompt edits and image projections through live, restored, and captured model surfaces', () => {
+    const branchCount = 32
+    let calls = 0
+    const counted: typeof imageOffloadProjection = {
+      ...imageOffloadProjection,
+      project(event, context) {
+        calls += 1
+        return imageOffloadProjection.project(event, context)
+      },
+    }
+    const definitions = [counted]
+    const session = Session.create(SessionId('successive-branches'), undefined, undefined, undefined, definitions)
+    const image = session.append('user/message', createUserMessage({
+      content: [{ type: 'image', attachment: {
+        attachmentId: `sha256:${'a'.repeat(64)}` as never, mediaType: 'image/png', bytes: 1, width: 1, height: 1,
+      } }],
+      source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    session.append('image/offload', { targets: [{ seq: image.seq, imageIndexes: [0] }] })
+    const expected = session.deriveMessages()
+    calls = 0
+    let captured: readonly SessionEvent[] = []
+    let capturedMessages = expected
+    let firstAnchor: SessionEvent<'user/message'> | undefined
+    for (let index = 0; index < branchCount; index++) {
+      const anchor = appendUser(session, `original ${index}`)
+      firstAnchor ??= anchor
+      expected.push(decide(session, anchor, index + 1, `edited ${index}`))
+      expect(session.deriveMessages()).toEqual(expected)
+      if (index === 15) {
+        captured = session.snapshotEvents()
+        capturedMessages = [...expected]
+      }
+    }
+    expect(calls).toBeLessThanOrEqual(branchCount)
+    expect(image.data.content[0]?.type).toBe('image')
+    expect(firstAnchor?.data.content).toEqual([{ type: 'text', text: 'original 0' }])
+    const events = session.snapshotEvents()
+    const humanTranscript = projectActiveBranch(events).filter(event => event.type === 'user/message')
+    expect(humanTranscript.slice(1).map(event => event.data)).toEqual(expected.slice(1))
+
+    calls = 0
+    const restored = Session.create(SessionId('successive-restored'), events, undefined, undefined, definitions)
+    expect(restored.deriveMessages()).toEqual(expected)
+    expect(calls).toBeLessThanOrEqual(branchCount + 1)
+    calls = 0
+    expect(foldedMessages(events, definitions)).toEqual(expected)
+    expect(calls).toBeLessThanOrEqual(branchCount + 1)
+
+    calls = 0
+    const cursor = captured.length - 1
+    expect(observationModelSurface(captured, definitions, cursor).map(row => row.message)).toEqual(capturedMessages)
+    expect(calls).toBeLessThanOrEqual(17)
+    const originalCut = observationModelSurface(captured, definitions, cursor, firstAnchor!.seq)
+    expect(originalCut.map(row => row.message)).toEqual([expected[0], firstAnchor!.data])
+    expect(() => observationModelSurface(captured, definitions, cursor, session.seq - 1)).toThrow(/past observation cursor/)
+    appendUser(session, 'after capture')
+    expect(observationModelSurface(captured, definitions, cursor).map(row => row.message)).toEqual(capturedMessages)
+  })
+
+  it('repeatedly restores ordinary prefix compaction and custom projections while discarding later changes', () => {
+    const branchCount = 24
+    let calls = 0
+    const projection: SessionMessageProjection<'test/branch-replay-project'> = {
+      type: 'test/branch-replay-project',
+      project(event, context) {
+        calls += 1
+        const source = context.events[event.data.seq - context.baseSeq]
+        if (source === undefined || source.seq !== event.data.seq || !context.nodes.includes(source.seq)) {
+          throw new Error('projection target must be a current physical message')
+        }
+        const message = deriveEventMessage(source, context.messages)
+        if (message === null) throw new Error('projection target must produce a message')
+        const text = message.content.map(block => block.type === 'text' ? block.text : '').join('')
+        return new Map([[source.seq, { ...message, content: [{ type: 'text' as const, text: text + event.data.suffix }] }]])
+      },
+    }
+    const definitions = [projection]
+    const session = Session.create(SessionId('repeated-rewind'), undefined, undefined, undefined, definitions)
+    const original = appendUser(session, 'original context')
+    const summary = session.append('user/message', user('prefix summary', 'compact-checkpoint'), {
+      surfaceOp: { op: 'replace', startSeq: original.seq, endSeq: original.seq }, sourceEventSeqs: [original.seq],
+    })
+    const source = appendUser(session, 'projected context')
+    session.append('test/branch-replay-project', { seq: source.seq, suffix: ' + retained' })
+    const anchor = appendUser(session, 'original anchor')
+    const prefix = session.deriveMessages().slice(0, -1)
+    calls = 0
+    let prompt = anchor.data
+    for (let revision = 1; revision <= branchCount; revision++) {
+      session.append('test/branch-replay-project', { seq: source.seq, suffix: ' + abandoned' })
+      session.append('user/message', user('abandoned whole-history summary', 'compact-checkpoint'), {
+        surfaceOp: { op: 'replace', startSeq: summary.seq, endSeq: anchor.seq },
+        sourceEventSeqs: [summary.seq, source.seq, anchor.seq],
+      })
+      expect(session.deriveMessages()).toHaveLength(1)
+      prompt = decide(session, anchor, revision, `rewind ${revision}`)
+      expect(session.deriveMessages()).toEqual([...prefix, prompt])
+      expect(session.surface.nodes).toEqual([summary.seq, source.seq, anchor.seq])
+    }
+    expect(calls).toBeLessThanOrEqual(2 * branchCount)
+    const events = session.snapshotEvents()
+    const transcript = projectActiveBranch(events)
+    expect(transcript.map(event => event.seq)).toEqual([0, 1, 2, 3, 4])
+    expect(transcript.at(-1)?.data).toEqual(prompt)
+    expect(source.data.content).toEqual([{ type: 'text', text: 'projected context' }])
+
+    calls = 0
+    expect(foldedMessages(events, definitions)).toEqual([...prefix, prompt])
+    expect(calls).toBeLessThanOrEqual(2 * branchCount + 1)
+    calls = 0
+    const restored = Session.create(SessionId('rewind-restored'), events, undefined, undefined, definitions)
+    expect(restored.deriveMessages()).toEqual([...prefix, prompt])
+    expect(calls).toBeLessThanOrEqual(2 * branchCount + 1)
+    const cursor = events.length - 1
+    calls = 0
+    expect(observationModelSurface(events, definitions, cursor).map(row => row.message)).toEqual([...prefix, prompt])
+    expect(calls).toBeLessThanOrEqual(2 * branchCount + 1)
+    const beforeDecision = observationModelSurface(events, definitions, cursor, cursor - 1)
+    expect(beforeDecision.map(row => row.message.content)).toEqual([[{ type: 'text', text: 'abandoned whole-history summary' }]])
+  })
+
+  it('rejects a superseded raw anchor atomically while allowing an earlier current prompt rewind', () => {
+    const session = Session.create(SessionId('current-anchor'))
+    const earlier = appendUser(session, 'earlier')
+    const later = appendUser(session, 'later')
+    decide(session, later, 1, 'later edited')
+    const prompt = decide(session, earlier, 2, 'earlier edited')
+    expect(session.deriveMessages()).toEqual([prompt])
+    const events = session.snapshotEvents()
+    const candidate: SessionEvent<'session/active-branch'> = {
+      type: 'session/active-branch', seq: SessionSeq(session.seq), time: 1,
+      data: {
+        revision: 3, expectedRevision: 2, anchorSeq: later.seq, messageId: later.data.id,
+        requestId: 'superseded', inputRevision: 'superseded', prompt: later.data,
+      },
+    }
+    expect(() => session.append(candidate.type, candidate.data)).toThrow(/not on the current active branch/)
+    expect(session.snapshotEvents()).toEqual(events)
+    expect(session.deriveMessages()).toEqual([prompt])
+    expect(() => foldSurface([...events, candidate])).toThrow(/not on the current active branch/)
+    expect(() => Session.create(SessionId('invalid-restored'), [...events, candidate])).toThrow(/not on the current active branch/)
+    expect(projectActiveBranch(events).filter(event => event.type === 'user/message').map(event => event.data)).toEqual([prompt])
+  })
+
+  it('projects retained messages by physical sequence after an earlier branch discarded a compaction', () => {
+    const projection: SessionMessageProjection<'test/branch-replay-project'> = {
+      type: 'test/branch-replay-project',
+      project(event, context) {
+        const source = context.events[event.data.seq - context.baseSeq]
+        if (source?.seq !== event.data.seq) throw new Error('projection lost its physical source')
+        const message = deriveEventMessage(source, context.messages)
+        if (message === null) throw new Error('projection target must produce a message')
+        return new Map([[source.seq, {
+          ...message,
+          content: [...message.content, { type: 'text' as const, text: event.data.suffix }],
+        }]])
+      },
+    }
+    const definitions = [projection]
+    const session = Session.create(SessionId('physical-prefix'), undefined, undefined, undefined, definitions)
+    const context = appendUser(session, 'context')
+    const first = appendUser(session, 'first')
+    session.append('test/branch-replay-project', { seq: context.seq, suffix: 'discarded' })
+    session.append('user/message', user('discarded summary', 'compact-checkpoint'), {
+      surfaceOp: { op: 'replace', startSeq: context.seq, endSeq: first.seq },
+      sourceEventSeqs: [context.seq, first.seq],
+    })
+    const editedFirst = decide(session, first, 1, 'edited first')
+    const retained = appendUser(session, 'retained after physical gap')
+    session.append('test/branch-replay-project', { seq: retained.seq, suffix: 'retained projection' })
+    session.append('test/branch-replay-project', { seq: first.seq, suffix: 'projection after edit' })
+    const second = appendUser(session, 'second')
+    const prefix = session.deriveMessages().slice(0, -1)
+    expect(prefix[1]?.content).toEqual([...editedFirst.content, { type: 'text', text: 'projection after edit' }])
+    session.append('test/branch-replay-project', { seq: retained.seq, suffix: 'abandoned again' })
+    session.append('user/message', user('second discarded summary', 'compact-checkpoint'), {
+      surfaceOp: { op: 'replace', startSeq: context.seq, endSeq: second.seq },
+      sourceEventSeqs: [context.seq, first.seq, retained.seq, second.seq],
+    })
+    const editedSecond = decide(session, second, 2, 'edited second')
+    const expected = [...prefix, editedSecond]
+    expect(session.deriveMessages()).toEqual(expected)
+    const events = session.snapshotEvents()
+    expect(foldedMessages(events, definitions)).toEqual(expected)
+    expect(Session.create(SessionId('physical-restored'), events, undefined, undefined, definitions).deriveMessages()).toEqual(expected)
+    expect(observationModelSurface(events, definitions, events.length - 1).map(row => row.message)).toEqual(expected)
+  })
+
+  it('rejects a future human anchor before reconstructing a malformed cold prefix', () => {
+    const session = Session.create(SessionId('future-anchor'))
+    appendUser(session, 'first')
+    const future = { type: 'user/message' as const, seq: SessionSeq(2), time: 3, data: user('future'), surfaceOp: 'append' as const }
+    const candidate: SessionEvent<'session/active-branch'> = {
+      type: 'session/active-branch', seq: SessionSeq(1), time: 2,
+      data: {
+        revision: 1, expectedRevision: 0, anchorSeq: future.seq, messageId: future.data.id,
+        requestId: 'future', inputRevision: 'future', prompt: future.data,
+      },
+    }
+    expect(() => foldSurface([...session.snapshotEvents(), candidate, future])).toThrow(/must be an earlier human user message/)
+  })
+})
diff --git a/packages/core/session/tests/admission.spec.ts b/packages/core/session/tests/admission.spec.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/session/tests/admission.spec.ts
@@ -0,0 +1,135 @@
+import { describe, expect, it } from 'vitest'
+import { SessionAdmission, SessionId, ownedSessionParent } from '../src/index.ts'
+
+describe('native session admission ordering', () => {
+  it('accepts input during factory publication but fences competing publication and queued deletion', async () => {
+    const admission = new SessionAdmission(() => false)
+    const id = SessionId('publication-input')
+    const entered = Promise.withResolvers<void>()
+    const release = Promise.withResolvers<void>()
+    const creating = admission.run(id, async () => {
+      admission.assertPublication(id)
+      entered.resolve()
+      await release.promise
+    })
+    await entered.promise
+    admission.assertUsable(id)
+    expect(() => admission.assertPublication(id)).toThrow(/lifecycle operation/)
+    const deleting = admission.exclusive(id, async () => {})
+    expect(() => admission.assertUsable(id)).toThrow(/lifecycle operation/)
+    expect(() => admission.assertPublication(id)).toThrow(/lifecycle operation/)
+    release.resolve()
+    await Promise.all([creating, deleting])
+  })
+  it('preserves stateless operation and refuses an unavailable durable owner', async () => {
+    const id = SessionId('stateless')
+    const stateless = new SessionAdmission(() => false)
+    expect(await stateless.run(id, async () => 'ok')).toBe('ok')
+    const durable = new SessionAdmission(() => true)
+    await expect(durable.run(id, async () => 'bad')).rejects.toThrow(/unavailable/)
+    expect(() => durable.assertUsable(id)).toThrow(/unavailable/)
+  })
+
+  it('shares ordering and refuses synchronous intake outside the active lease', async () => {
+    const admission = new SessionAdmission(() => false)
+    const id = SessionId('ordered')
+    const entered = Promise.withResolvers<void>()
+    const release = Promise.withResolvers<void>()
+    const observed: string[] = []
+    const first = admission.exclusive(id, async () => {
+      admission.assertUsable(id)
+      entered.resolve()
+      await release.promise
+      observed.push('first')
+    })
+    await entered.promise
+    const second = admission.run(id, async () => { observed.push('second') })
+    expect(() => admission.assertUsable(id)).toThrow(/lifecycle operation/)
+    release.resolve()
+    await Promise.all([first, second])
+    expect(observed).toEqual(['first', 'second'])
+    admission.assertUsable(id)
+  })
+
+  it('reuses an active operation without deadlocking and expires escaped callbacks', async () => {
+    const admission = new SessionAdmission(() => false)
+    const id = SessionId('reentrant')
+    const deferred = Promise.withResolvers<void>()
+    let escaped: Promise<void> | undefined
+    await admission.exclusive(id, async () => {
+      await admission.run(id, async () => admission.assertUsable(id))
+      escaped = deferred.promise.then(() => admission.assertUsable(id))
+    })
+    const started = Promise.withResolvers<void>()
+    const finish = Promise.withResolvers<void>()
+    const newer = admission.exclusive(id, async () => {
+      started.resolve()
+      await finish.promise
+    })
+    await started.promise
+    deferred.resolve()
+    await expect(escaped).rejects.toThrow(/lifecycle operation/)
+    finish.resolve()
+    await newer
+  }, 1000)
+
+  it('freezes grandchildren under a root operation while independent forks remain usable', async () => {
+    const root = SessionId('root')
+    const child = SessionId('child')
+    const grandchild = SessionId('grandchild')
+    const fork = SessionId('fork')
+    const admission = new SessionAdmission(() => false, id => id === child ? root : id === grandchild ? child : undefined)
+    const entered = Promise.withResolvers<void>()
+    const release = Promise.withResolvers<void>()
+    const closing = admission.exclusive(root, async () => {
+      entered.resolve()
+      await release.promise
+    })
+    await entered.promise
+    expect(() => admission.assertUsable(grandchild, child)).toThrow(/lifecycle operation/)
+    admission.assertUsable(fork)
+    expect(ownedSessionParent({ parentSession: root })).toBeUndefined()
+    expect(ownedSessionParent({ parentSession: root, origin: 'subagent' })).toBe(root)
+    release.resolve()
+    await closing
+  })
+
+  it('reads the same delegate after ordering and keeps removed durable owners closed', async () => {
+    const id = SessionId('terminal')
+    const admission = new SessionAdmission(() => false)
+    let deleted = false
+    const detach = admission.bind({
+      whenReady: async () => {},
+      admit: async (_id, operation) => operation(),
+      assertUsable: () => { if (deleted) throw new Error('deleted') },
+    })
+    const deletion = admission.exclusive(id, async () => { deleted = true })
+    const create = admission.run(id, async () => { throw new Error('must not run') })
+    await deletion
+    await expect(create).rejects.toThrow('deleted')
+    detach()
+    await expect(admission.run(id, async () => 'bad')).rejects.toThrow(/unavailable/)
+  })
+
+  it('rejects a cancelled waiter before a closing parent releases its queue', async () => {
+    const admission = new SessionAdmission(() => false)
+    const root = SessionId('closing-root')
+    const entered = Promise.withResolvers<void>()
+    const release = Promise.withResolvers<void>()
+    const closing = admission.exclusive(root, async () => {
+      entered.resolve()
+      await release.promise
+    })
+    await entered.promise
+    const cancelled = new AbortController()
+    let ran = false
+    const child = admission.run(SessionId('late-child'), async () => { ran = true }, root, undefined, cancelled.signal)
+    cancelled.abort(new Error('owned turn cancelled'))
+    await expect(child).rejects.toThrow('owned turn cancelled')
+    expect(ran).toBe(false)
+    release.resolve()
+    await closing
+    await admission.exclusive(root, async () => {})
+    expect(ran).toBe(false)
+  }, 1000)
+})
diff --git a/packages/core/tools/tests/dispatch-durability.spec.ts b/packages/core/tools/tests/dispatch-durability.spec.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/tools/tests/dispatch-durability.spec.ts
@@ -0,0 +1,106 @@
+/** Live Session dispatch evidence must settle before a tool body can change the world. */
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { unsupportedInbox } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture, TOOL_ABORTED_BEFORE_DISPATCH } from '../src/index.ts'
+import { expect, it } from 'vitest'
+
+async function fixture(body: () => void) {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  const session = ctx.sessions.create(SessionId('durable-tool-dispatch'))
+  const agent: Agent = {
+    id: session.id, session, ctx, options: {}, status: 'idle', inbox: unsupportedInbox(),
+    send() {}, followup() {}, steer: () => ({ outcome: Promise.resolve({ status: 'rejected' as const }) }), inject() {}, cancel() {}, continueFromBranch() {},
+    whenIdle: () => Promise.resolve(), runMaintenance: operation => operation(new AbortController().signal),
+  }
+  const callId = ToolCallId('write-dispatch')
+  session.append('turn/start', { turn: 1 })
+  session.append('step/start', { turn: 1, step: 1 })
+  session.append('tool/call', { turn: 1, step: 1, callId, name: 'write', arguments: '{}' })
+  ctx.tools.register(defineContentToolFixture({
+    name: 'write', description: 'dispatch fixture', hostEffect: 'filesystem-write', parameters: {},
+    async execute() { body(); return [] },
+  }))
+  return { ctx, session, agent, callId }
+}
+
+it('holds the body until live-session dispatch evidence has flushed', async () => {
+  let invoked = false
+  const { ctx, session, agent, callId } = await fixture(() => { invoked = true })
+  const entered = Promise.withResolvers<undefined>()
+  const release = Promise.withResolvers<undefined>()
+  let evidenceRecorded = false
+  ctx.on('session/event', (_subject, event) => {
+    if (event.type === 'host/tool-effect' && event.data.callId === callId) evidenceRecorded = true
+  })
+  ctx.on('session/flush', async (subject) => {
+    expect(subject).toBe(session)
+    expect(evidenceRecorded).toBe(true)
+    entered.resolve(undefined)
+    await release.promise
+  })
+  try {
+    const execution = ctx.tools.execute({ agent, signal: new AbortController().signal, callId, name: 'write', arguments: {} })
+    await entered.promise
+    expect(invoked).toBe(false)
+    release.resolve(undefined)
+    expect((await execution).isError).toBe(false)
+    expect(invoked).toBe(true)
+  } finally { release.resolve(undefined); await ctx.fiber.dispose() }
+})
+
+it('never invokes the body when the dispatch durability checkpoint fails', async () => {
+  let invoked = false
+  const { ctx, agent, callId } = await fixture(() => { invoked = true })
+  ctx.on('session/flush', () => { throw new Error('dispatch durability failed') })
+  try {
+    const result = await ctx.tools.execute({ agent, signal: new AbortController().signal, callId, name: 'write', arguments: {} })
+    expect(result.isError).toBe(true)
+    expect(result.error?.message).toContain('dispatch durability failed')
+    expect(invoked).toBe(false)
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('reports cancellation during the durability checkpoint as before dispatch', async () => {
+  let invoked = false
+  const { ctx, agent, callId } = await fixture(() => { invoked = true })
+  const entered = Promise.withResolvers<undefined>()
+  const release = Promise.withResolvers<undefined>()
+  const controller = new AbortController()
+  ctx.on('session/flush', async () => { entered.resolve(undefined); await release.promise })
+  try {
+    const execution = ctx.tools.execute({ agent, signal: controller.signal, callId, name: 'write', arguments: {} })
+    await entered.promise
+    controller.abort()
+    release.resolve(undefined)
+    const result = await execution
+    expect(result.error?.info?.code).toBe(TOOL_ABORTED_BEFORE_DISPATCH)
+    expect(invoked).toBe(false)
+  } finally { release.resolve(undefined); await ctx.fiber.dispose() }
+})
+
+it('keeps live tool-only sessions usable when no persistence listener is mounted', async () => {
+  let invoked = false
+  const { ctx, agent, callId } = await fixture(() => { invoked = true })
+  try {
+    expect((await ctx.tools.execute({ agent, signal: new AbortController().signal, callId, name: 'write', arguments: {} })).isError).toBe(false)
+    expect(invoked).toBe(true)
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('never invokes a persisted session body when no durability listener participates', async () => {
+  let invoked = false
+  const { ctx, agent, callId } = await fixture(() => { invoked = true })
+  ctx.provide('sessionPersistence', {} as never)
+  try {
+    const result = await ctx.tools.execute({ agent, signal: new AbortController().signal, callId, name: 'write', arguments: {} })
+    expect(result.error?.info?.code).toBe('TOOL_DISPATCH_NOT_DURABLE')
+    expect(invoked).toBe(false)
+  } finally { await ctx.fiber.dispose() }
+})
