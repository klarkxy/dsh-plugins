+// @vitest-environment jsdom
+/** Session deletion through the shipped UI registration retains the native Remote failure. */
+import { createClientTest, webApp } from '@deepseek-ai/dsh-client-test-runtime/src/assembly/index.ts'
+import { ok } from '@deepseek-ai/dsh-remote-mock'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import { RemoteError, remoteErrorOf } from '@deepseek-ai/dsh-typert-protocol'
+import { describe, expect, vi } from 'vitest'
+import type {} from '../src/client/navigation.ts'
+
+const it = createClientTest({ roster: webApp.closure(['@deepseek-ai/dsh-client-ui-workspace']) })
+const SESSION = SessionId('delete-refused')
+
+describe('Session delete failure through native Workspace UI registration', () => {
+  it('throws the native code, diagnostic, and details and keeps the catalog row', async ({ mock, start }) => {
+    mock.remote.session.list.mockResolvedValueOnce(ok({ items: [{
+      sessionId: SESSION, updatedAt: 1, running: false, blank: false, agentAvailable: true,
+    }] }))
+    mock.load({ unary: { 'session/delete': {
+      ok: false,
+      error: new RemoteError('session/delete-pending', 'owned resources are still stopping', {
+        sessionId: SESSION, reason: 'cleanup pending',
+      }),
+    } } })
+    const client = await start()
+    await vi.waitFor(() => { expect(client.ctx.get('uiWorkspace')).toBeDefined() })
+    await vi.waitFor(() => { expect(client.ctx.sessions.list.getSnapshot().phase).toBe('ready') })
+    const deletion = client.ctx.uiWorkspace.deleteSession(SESSION, 'delete-request')
+    await expect(deletion).rejects.toMatchObject({
+      name: 'RemoteError', isDSHRemoteError: true, code: 'session/delete-pending',
+      message: 'owned resources are still stopping', details: { sessionId: SESSION, reason: 'cleanup pending' },
+    })
+    const failure = await deletion.catch((error: unknown) => error)
+    expect(remoteErrorOf(failure)?.code).toBe('session/delete-pending')
+    expect(client.ctx.sessions.list.getSnapshot().ids).toContain(SESSION)
+    expect(mock.log.requests('session/delete')).toHaveLength(1)
+  }, 60_000)
+})
