+import { mkdtemp, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { afterEach, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { SessionId, SessionLogOffset } from '@deepseek-ai/dsh-session'
+import JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import * as StorageDomain from '@deepseek-ai/dsh-storage-domain'
+import { HarnessSdkJsonRpcServer } from '../src/server.ts'
+import { MockAdapter, textResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { mountAdmissionStorage } from './admission-fixture.ts'
+
+const roots: string[] = []
+const contexts: Context[] = []
+const previousHome = process.env['DSH_HOME']
+afterEach(async () => {
+  try {
+    for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+    for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true })
+  } finally {
+    if (previousHome === undefined) delete process.env['DSH_HOME']
+    else process.env['DSH_HOME'] = previousHome
+  }
+})
+
+async function boot(root: string) {
+  process.env['DSH_HOME'] = root
+  const ctx = new Context()
+  contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(JsonlSessionPersistence, { root: join(root, 'sessions') })
+  const domain = await mountAdmissionStorage(ctx, root)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const adapter = new MockAdapter([textResponse('must not infer')])
+  ctx.llm.registerAdapter(['mock'], adapter)
+  return { ctx, adapter, domain }
+}
+
+async function newRoot() {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-native-admission-'))
+  roots.push(root)
+  return root
+}
+
+it('shares terminal deletion across SDK, direct factories, publication and restart without WebSessionController', async () => {
+  const root = await newRoot()
+  const { ctx, adapter } = await boot(root)
+  const id = SessionId('terminal-native')
+  const handle = await ctx.agents.create({ sessionId: id, meta: { cwd: root } })
+  await ctx.sessions.flush(handle.agent.session)
+  const prepared = ctx.sessions.prepare(SessionId('late-publication'))
+  await ctx.sessionPersistence.admission.exclusive(id, async () => {
+    await ctx.sessionPersistence.admission.table!.put(id, { phase: 'deleting', classification: 'ordinary' })
+    await handle.dispose()
+    await ctx.sessionPersistence.delete(id)
+    await ctx.sessionPersistence.admission.table!.put(id, { phase: 'deleted', classification: 'ordinary' })
+  })
+  await ctx.sessionPersistence.admission.exclusive(prepared.id, async () => {
+    await ctx.sessionPersistence.admission.table!.put(prepared.id, { phase: 'deleted', classification: 'ordinary' })
+  })
+  expect(() => ctx.sessions.enter(prepared)).toThrow(/deleted/)
+  expect(() => ctx.agents.enter(handle.agent, undefined)).toThrow(/deleted/)
+  const message = createUserMessage({ content: [{ type: 'text', text: 'retained' }], source: { kind: 'user' } })
+  for (const send of [() => handle.agent.send(message, 'next-turn', true), () => handle.agent.followup(message),
+    () => handle.agent.steer(message), () => handle.agent.inject(message), () => handle.agent.inbox.append('next-turn', message)]) {
+    expect(send).toThrow(/disposed/)
+  }
+  await expect(ctx.agents.create({ sessionId: id, meta: { cwd: root } })).rejects.toThrow(/deleted/)
+  await expect(ctx.agentLoop.create(id, {}, { cwd: root })).rejects.toThrow(/deleted/)
+  await expect(ctx.agents.resume({ resumeSessionId: id })).rejects.toThrow(/deleted/)
+  const sdk = new HarnessSdkJsonRpcServer(ctx, { notify() {}, request: async () => { throw new Error('unused') } })
+  await sdk.initialize({ cwd: root, provider: 'mock', model: 'mock' })
+  await expect(sdk.prompt({ sessionId: id, contentBlocks: [{ type: 'text', text: 'SDK' }] })).rejects.toThrow(/deleted/)
+  await sdk.shutdown()
+  expect(await ctx.sessionPersistence.stat(id)).toBeUndefined()
+  expect(adapter.requests).toHaveLength(0)
+  await ctx.fiber.dispose()
+  contexts.splice(contexts.indexOf(ctx), 1)
+  const restarted = await boot(root)
+  await expect(restarted.ctx.agents.create({ sessionId: id })).rejects.toThrow(/deleted/)
+  expect(await restarted.ctx.sessionPersistence.stat(id)).toBeUndefined()
+  expect(restarted.adapter.requests).toHaveLength(0)
+}, 10000)
+
+it('keeps clean interrupted allocation closed to SDK and native factories', async () => {
+  const root = await newRoot()
+  const { ctx, adapter } = await boot(root)
+  const id = SessionId('interrupted-allocation')
+  await ctx.sessionPersistence.admission.table!.put(id, { phase: 'creating', classification: 'free', ownedDirectory: join(root, id), allocation: { nonce: 'interrupted' } })
+  await expect(ctx.agents.create({ sessionId: id })).rejects.toThrow(/allocation requires recovery/)
+  await expect(ctx.sessionPersistence.admission.withAllocatedSession(id, async () => ctx.agents.create({ sessionId: id }))).rejects.toThrow()
+  expect(await ctx.sessionPersistence.stat(id)).toBeUndefined()
+  expect(ctx.sessions.get(id)).toBeUndefined()
+  expect(adapter.requests).toHaveLength(0)
+})
+
+it('rejects retained input while domain ownership reloads, then reads the same durable table', async () => {
+  const root = await newRoot()
+  const { ctx, adapter, domain } = await boot(root)
+  const id = SessionId('reload-input')
+  const handle = await ctx.agents.create({ sessionId: id, meta: { cwd: root } })
+  const message = createUserMessage({ content: [{ type: 'text', text: 'blocked' }], source: { kind: 'user' } })
+  await ctx.sessionPersistence.admission.table!.put(SessionId('reload-terminal'), { phase: 'deleted', classification: 'ordinary' })
+  // The actual injection owner is replaced through Cordis, not a second-open table.
+  await domain.dispose()
+  expect(() => handle.agent.followup(message)).toThrow(/unavailable/)
+  await expect(ctx.agents.create({ sessionId: SessionId('during-reload') })).rejects.toThrow(/unavailable/)
+  await ctx.plugin(StorageDomain, { backend: 'json' })
+  await ctx.sessionPersistence.admission.whenReady()
+  await expect(ctx.agents.create({ sessionId: SessionId('reload-terminal') })).rejects.toThrow(/deleted/)
+  expect(adapter.requests).toHaveLength(0)
+  await handle.dispose()
+})
+
+it('drains a cancelled child waiter behind its closing parent and preserves independent forks', async () => {
+  const root = await newRoot()
+  const { ctx, adapter } = await boot(root)
+  const parentId = SessionId('closing-parent')
+  const childId = SessionId('late-owned-child')
+  const parent = await ctx.agents.create({ sessionId: parentId, meta: { cwd: root } })
+  const entered = Promise.withResolvers<void>()
+  const drained = Promise.withResolvers<void>()
+  const deletion = ctx.sessionPersistence.admission.exclusive(parentId, async () => {
+    await ctx.sessionPersistence.admission.table!.put(parentId, { phase: 'deleting', classification: 'ordinary' })
+    entered.resolve()
+    await drained.promise
+    await parent.dispose()
+    await ctx.sessionPersistence.delete(parentId)
+    await ctx.sessionPersistence.admission.table!.put(parentId, { phase: 'deleted', classification: 'ordinary' })
+  })
+  await entered.promise
+  const cancelled = new AbortController()
+  const child = ctx.agents.create({ sessionId: childId, parentAgent: parent.agent,
+    meta: { cwd: root, origin: 'subagent', parentSession: parentId, delegationDepth: 1 }, signal: cancelled.signal })
+  cancelled.abort(new Error('parent stopped owned work'))
+  await expect(child).rejects.toThrow('parent stopped owned work')
+  drained.resolve()
+  await deletion
+  expect(await ctx.sessionPersistence.stat(childId)).toBeUndefined()
+  expect(ctx.agents.get(childId)).toBeUndefined()
+  const independent = await ctx.agents.create({ sessionId: SessionId('independent-fork'), seed: [], inheritedEventCount: SessionLogOffset(0),
+    meta: { cwd: root, parentSession: parentId, isSeeded: true } })
+  await independent.dispose()
+  expect(adapter.requests).toHaveLength(0)
+}, 2000)
