+      const anchor = this.anchor(agent.session, receipt.messageId)
+      if (anchor === undefined) {
+        throw new RetryCutRefusal('session/retry-blocked', 'prompt is not on the active branch', {
+          sessionId: agent.id,
+          reason: 'not-human-prompt',
+          blockers: [],
+        })
+      }
+      // Intent persistence does not reserve a cut across process loss or other native input paths.
+      const preview = await this.inspect(agent, receipt.messageId, 'throw')
