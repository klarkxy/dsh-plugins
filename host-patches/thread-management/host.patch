@@ -0,0 +1,40 @@
+import { lstat, mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { afterEach, expect, it } from 'vitest'
+import { verifyDirectoryProof } from '../src/directory-proof.ts'
+
+const roots: string[] = []
+const previousHome = process.env['DSH_HOME']
+afterEach(async () => {
+  if (previousHome === undefined) delete process.env['DSH_HOME']
+  else process.env['DSH_HOME'] = previousHome
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true })
+})
+
+it('keeps proof verification read-only when the managed parent does not exist', async () => {
+  const home = await mkdtemp(join(tmpdir(), 'dsh-proof-readonly-'))
+  roots.push(home)
+  process.env['DSH_HOME'] = home
+  const parent = join(home, 'free-workspaces')
+  const ownedDirectory = join(parent, 'missing-root')
+  await expect(verifyDirectoryProof('missing-root', { ownedDirectory,
+    allocation: { nonce: 'missing', canonicalDirectory: ownedDirectory, device: '0', inode: '0' } })).rejects.toThrow()
+  await expect(lstat(parent)).rejects.toMatchObject({ code: 'ENOENT' })
+})
+
+it('refuses mismatched or missing-home records without preparing any directory', async () => {
+  const home = await mkdtemp(join(tmpdir(), 'dsh-proof-mismatch-'))
+  roots.push(home)
+  process.env['DSH_HOME'] = home
+  const unrelated = join(home, 'unrelated')
+  await mkdir(unrelated)
+  await writeFile(join(unrelated, 'keep.txt'), 'keep')
+  await expect(verifyDirectoryProof('exact-id', { ownedDirectory: unrelated,
+    allocation: { nonce: 'bad', canonicalDirectory: unrelated, device: '0', inode: '0' } })).rejects.toThrow(/exact recorded session identity/)
+  await expect(lstat(join(home, 'free-workspaces'))).rejects.toMatchObject({ code: 'ENOENT' })
+  expect(await readFile(join(unrelated, 'keep.txt'), 'utf8')).toBe('keep')
+  process.env['DSH_HOME'] = join(home, 'missing-home')
+  await expect(verifyDirectoryProof('exact-id', { ownedDirectory: unrelated, allocation: { nonce: 'bad' } })).rejects.toThrow()
+  await expect(lstat(join(home, 'missing-home'))).rejects.toMatchObject({ code: 'ENOENT' })
+})
