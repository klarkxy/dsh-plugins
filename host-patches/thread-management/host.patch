+    const subagents = this.ctx.get('subagents')
+    if (parent !== undefined && subagents !== undefined) {
+      await subagents.drainContinuableDescendants([parent])
+    }
+    const owned = await this.ownedDescendantIds(sessionId)
+    await this.closeAdmission(owned)
