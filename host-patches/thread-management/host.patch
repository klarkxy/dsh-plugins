+      && known.expectedRevision === request.expectedRevision
+      && known.inputRevision === request.expectedInputRevision
+      && known.text === request.text
+    if (!same) {
+      throw new RemoteError('session/retry-conflict', 'retry requestId was already used with a different payload', {
+        sessionId: agent.id,
+        requestId: request.requestId,
