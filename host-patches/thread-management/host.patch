+  /** Fresh and recovered intents revalidate the recorded cut synchronously before branch append. */
+  private assertRetryCut(
+    agent: Agent,
+    request: { expectedRevision: number; expectedInputRevision: string },
+    anchor: SessionEvent<'user/message'>,
