+  private runningJobs(sessionId: SessionId): string[] {
+    return this.ctx.get('jobs')?.list(sessionId).filter(job => job.owner === sessionId && (job.status === 'running' || job.status === 'stopping')).map(job => `running:job:${job.id}`) ?? []
