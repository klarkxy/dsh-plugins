+  }
+
+  /**
+   * Mark a created session active. A crash before this leaves `creating`.
+   * @param sessionId - session that now has a log.
+   * @param classification - ordinary or free.
+   * @param ownedDirectory - recorded free directory, when classification is free.
+   */
+  async markActive(
+    sessionId: SessionId,
+    classification: 'ordinary' | 'free',
+    ownedDirectory?: string,
+  ): Promise<void> {
+    const current = this.table?.get(sessionId)
+    if (classification === 'free' && !await verifyDirectoryProof(sessionId, {
+      ownedDirectory, allocation: current?.allocation,
+    })) throw new RemoteError('session/allocation-pending', 'owned free workspace is missing', { sessionId })
+    await this.put(sessionId, {
+      ...current,
+      phase: 'active',
+      classification,
+      ...(ownedDirectory === undefined ? {} : { ownedDirectory }),
+    })
+  }
+
+  /** Grant native publication only for the currently proven allocation; active idempotent adoption needs no grant. */
+  withAllocatedSession<T>(sessionId: SessionId, operation: () => Promise<T>): Promise<T> {
+    if (this.table?.get(sessionId)?.phase === 'active') return operation()
+    if (this.admission === undefined) return Promise.reject(new RemoteError('session/lifecycle-unavailable', 'native allocation admission is unavailable', {}))
