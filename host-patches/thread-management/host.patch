+import type { Context } from '@deepseek-ai/cordis'
+import { join } from 'node:path'
+import Storage from '@deepseek-ai/dsh-storage'
+import * as StorageJson from '@deepseek-ai/dsh-storage-json'
+import * as StorageDomain from '@deepseek-ai/dsh-storage-domain'
+
+/** Use the normal durable domain in persistence-backed factory fixtures. */
+export async function mountAdmissionStorage(ctx: Context, root: string): Promise<void> {
+  if (ctx.get('storageDomain') === undefined) {
+    await ctx.plugin(Storage)
+    await ctx.plugin(StorageJson, { root: join(root, 'lifecycle-storage') })
+    await ctx.plugin(StorageDomain, { backend: 'json' })
+  }
+  await ctx.get('sessionPersistence')?.admission.whenReady()
+}
