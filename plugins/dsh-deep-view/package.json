{
  "name": "@klarkxy/dsh-deep-view",
  "version": "0.3.11",
  "description": "Intelligent reply interfaces with native visuals, interactive math, node graphs, data exploration, maps and validated answers.",
  "icon": "./icon.svg",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "import": "./lib/core.js",
      "default": "./lib/core.js"
    },
    "./answer-text": {
      "types": "./lib/answer-text.d.ts",
      "import": "./lib/answer-text.js",
      "default": "./lib/answer-text.js"
    },
    "./answers": {
      "types": "./lib/answers.d.ts",
      "import": "./lib/answers.js",
      "default": "./lib/answers.js"
    },
    "./widget": {
      "types": "./lib/widget.d.ts",
      "import": "./lib/widget.js",
      "default": "./lib/widget.js"
    },
    "./copy": {
      "types": "./lib/copy.d.ts",
      "import": "./lib/copy.js",
      "default": "./lib/copy.js"
    },
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/map-worker.mjs && node scripts/vendor-css.mjs && tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-deep-view",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-deep-view/src"
  },
  "dependencies": {
    "@klarkxy/dsh-plugin-kit": "workspace:*",
    "@xyflow/react": "12.12.1",
    "jsonrepair": "3.15.0",
    "mafs": "0.21.0",
    "maplibre-gl": "6.18.0",
    "parse5": "8.1.1",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-files": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-files": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.2-rc.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.0",
    "jsdom": "29.1.1",
    "@types/jsdom": "28.0.3",
    "postcss": "8.5.27"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness-plugin",
    "charts",
    "widgets",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-deep-view"
  },
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/deep-view/",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "cf8cc73364ee47a657d1496dfb22600abbad67897134985b4926cd9046859fac"
  }
}
