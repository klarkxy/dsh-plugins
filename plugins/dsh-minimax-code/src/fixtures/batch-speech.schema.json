{
  "tool_name": "connector__matrix__batch_text_to_audio",
  "description": "Batch TTS (text-to-speech) for spoken audio (at most 10 per call). Successful items return success_items[].node_id and success_items[].file_name; file_name is the final base filename including its actual extension. Call get_asset_url with node_id to obtain a short-lived audio URL. Optional requests[].output_file sets the downloaded base filename; directory components are ignored. Do not construct an OSS/CDN URL from node_id. Do NOT pass output_file_list.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "requests": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "emotion": {
              "enum": [
                "happy",
                "sad",
                "angry",
                "fearful",
                "disgusted",
                "surprised",
                "neutral"
              ],
              "type": "string"
            },
            "output_file": {
              "description": "Optional downloaded base filename. Directory components are ignored.",
              "minLength": 1,
              "type": "string"
            },
            "pitch": {
              "maximum": 12,
              "minimum": -12,
              "type": "integer"
            },
            "speed": {
              "maximum": 2,
              "minimum": 0.5,
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "voice_id": {
              "description": "default male-qn-qingse",
              "type": "string"
            },
            "volume": {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "requests"
    ],
    "type": "object"
  },
  "output_schema": {
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "integer"
      },
      "failed_items": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "err_code": {
              "type": "integer"
            },
            "error_msg": {
              "type": "string"
            },
            "index": {
              "type": "integer"
            }
          },
          "required": [
            "index",
            "error_msg",
            "err_code"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "message": {
        "type": "string"
      },
      "success_items": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "file_name": {
              "type": "string"
            },
            "node_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "node_id",
            "file_name"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "total_failed": {
        "type": "integer"
      },
      "total_requested": {
        "type": "integer"
      },
      "total_success": {
        "type": "integer"
      }
    },
    "required": [
      "code",
      "message",
      "total_requested",
      "total_success",
      "total_failed",
      "success_items",
      "failed_items"
    ],
    "type": "object"
  }
}
