{
  "name": "@klarkxy/dsh-model-route",
  "version": "0.2.7",
  "description": "Shared library that lets DSH plugins describe provider, model, and reasoning-effort settings consistently and share model lists and picker menus; installed automatically by dependent plugins.",
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/model-route/",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./zod": {
      "types": "./lib/zod.d.ts",
      "import": "./lib/zod.js",
      "default": "./lib/zod.js"
    },
    "./schemastery": {
      "types": "./lib/schemastery.d.ts",
      "import": "./lib/schemastery.js",
      "default": "./lib/schemastery.js"
    },
    "./ui": {
      "types": "./lib/ui.d.ts",
      "import": "./lib/ui.js",
      "default": "./lib/ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-model-route/src"
  },
  "peerDependencies": {
    "zod": "^4.1.5",
    "@deepseek-ai/schemastery": ">=3.18.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "@types/jsdom": "28.0.3",
    "zod": "4.4.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "model-route",
    "model-picker",
    "reasoning-effort",
    "llm",
    "shared-library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-model-route"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "7d532fe75fc9e5609e46f7293bcc81ceaa2779d4b069f725b59fa0c5640a7092"
  }
}
