{
  "name": "@klarkxy/dsh-unrestricted",
  "version": "0.2.0",
  "description": "Unrestricted: a session preset that removes the limits on what the model answers and delivers complete results, only in sessions that pick it. May get your account banned.",
  "icon": "./icon.svg",
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/unrestricted/",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-unrestricted"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-preset",
    "unrestricted"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib",
    "cordis.patch.yml",
    "README*.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-unrestricted",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/preset.test.mjs && vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-unrestricted/src"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@klarkxy/dsh-plugin-kit": "workspace:*",
    "@deepseek-ai/dsh": "0.2.1-rc.1",
    "@deepseek-ai/dsh-web-app": "0.2.1-rc.1"
  },
  "dshRelease": {
    "contentHash": "bd660d10571c79c51df7a755d2c9a189027343511030a929703764e2acf511d1"
  }
}
