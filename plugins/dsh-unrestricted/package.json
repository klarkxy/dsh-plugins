{
  "name": "@klarkxy/dsh-unrestricted",
  "version": "0.4.0",
  "description": "Unrestricted: a session preset that removes the limits on what the model answers and delivers complete results, only in sessions that pick it. May get your account banned.",
  "icon": "./icon.svg",
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/unrestricted/",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-unrestricted"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-preset",
    "preset",
    "session-preset",
    "unrestricted",
    "jailbreak",
    "bypass"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "import": "./lib/runtime.js",
      "default": "./lib/runtime.js"
    },
    "./transport": {
      "types": "./lib/transport.d.ts",
      "import": "./lib/transport.js",
      "default": "./lib/transport.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib",
    "presets",
    "cordis.patch.yml",
    "README*.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-unrestricted",
    "preset:check": "node scripts/gen-preset.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/preset.test.mjs && node scripts/gen-preset.mjs --check && vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-unrestricted/src"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web-app": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@klarkxy/dsh-plugin-kit": "workspace:*"
  },
  "dshRelease": {
    "contentHash": "4df2cf3634e818eff467c1349b9d4e345cb9cb9c128b9a28542a9f2665ad7cf3"
  }
}
