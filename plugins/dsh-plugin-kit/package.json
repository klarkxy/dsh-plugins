    "./auxiliary-context": {
      "types": "./lib/auxiliary-context.d.ts",
      "import": "./lib/auxiliary-context.js",
      "default": "./lib/auxiliary-context.js"
    },
    "./auxiliary-model-client": {
      "types": "./lib/auxiliary-model-client.d.ts",
      "import": "./lib/auxiliary-model-client.js",
      "default": "./lib/auxiliary-model-client.js"
    },
    "./cli-process": {
      "types": "./lib/cli-process.d.ts",
      "import": "./lib/cli-process.js",
      "default": "./lib/cli-process.js"
    },
    "./cli-media": {
      "types": "./lib/cli-media.d.ts",
