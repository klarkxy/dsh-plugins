{
  "name": "@klarkxy/dsh-plugin-kit",
  "version": "0.3.2",
  "description": "Shared support library for klarkxy DSH plugins.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./host-rpc": {
      "types": "./lib/host-rpc.d.ts",
      "import": "./lib/host-rpc.js",
      "default": "./lib/host-rpc.js"
    },
    "./domain": {
      "types": "./lib/domain.d.ts",
      "import": "./lib/domain.js",
      "default": "./lib/domain.js"
    },
    "./model-settings": {
      "types": "./lib/model-settings.d.ts",
      "import": "./lib/model-settings.js",
      "default": "./lib/model-settings.js"
    },
    "./client-utils": {
      "types": "./lib/client-utils.d.ts",
      "import": "./lib/client-utils.js",
      "default": "./lib/client-utils.js"
    },
    "./model-menu": {
      "types": "./lib/model-menu.d.ts",
      "import": "./lib/model-menu.js",
      "default": "./lib/model-menu.js"
    },
    "./llm-call": {
      "types": "./lib/llm-call.d.ts",
      "import": "./lib/llm-call.js",
      "default": "./lib/llm-call.js"
    },
    "./official-ui": {
      "types": "./lib/official-ui.d.ts",
      "import": "./lib/official-ui.js",
      "default": "./lib/official-ui.js"
    },
    "./package.json": "./package.json",
    "./model-settings-client": {
      "types": "./lib/model-settings-client.d.ts",
      "import": "./lib/model-settings-client.js",
      "default": "./lib/model-settings-client.js"
    },
    "./cli-process": {
      "import": "./lib/cli-process.js",
      "default": "./lib/cli-process.js",
      "types": "./lib/cli-process.d.ts"
    },
    "./cli-media": {
      "import": "./lib/cli-media.js",
      "default": "./lib/cli-media.js",
      "types": "./lib/cli-media.d.ts"
    }
  },
  "files": [
    "lib",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-plugin-kit/src"
  },
