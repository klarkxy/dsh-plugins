      "types": "./lib/official-ui.d.ts",
      "import": "./lib/official-ui.js",
      "default": "./lib/official-ui.js"
    },
    "./package.json": "./package.json",
    "./model-settings-client": {
      "types": "./lib/model-settings-client.d.ts",
      "import": "./lib/model-settings-client.js",
      "default": "./lib/model-settings-client.js"
    },
