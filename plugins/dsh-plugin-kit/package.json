      "types": "./lib/log-shared.d.ts",
      "import": "./lib/log-shared.js",
      "default": "./lib/log-shared.js"
    },
    "./logger": {
      "types": "./lib/logger.d.ts",
      "import": "./lib/logger.js",
      "default": "./lib/logger.js"
    },
    "./client-logger": {
      "types": "./lib/client-logger.d.ts",
      "import": "./lib/client-logger.js",
      "default": "./lib/client-logger.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-plugin-kit/src"
  },
