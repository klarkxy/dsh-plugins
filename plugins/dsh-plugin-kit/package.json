{
  "name": "@klarkxy/dsh-plugin-kit",
  "version": "0.8.0",
  "description": "Shared support library for klarkxy DSH plugins, providing the default auxiliary model, shared session settings, independent feature contexts, RPC, UI helpers and optional shared model picker integration; installed automatically by dependent plugins.",
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/plugin-kit/",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./host-rpc": {
      "types": "./lib/host-rpc.d.ts",
      "import": "./lib/host-rpc.js",
      "default": "./lib/host-rpc.js"
    },
    "./domain": {
      "types": "./lib/domain.d.ts",
