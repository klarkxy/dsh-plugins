    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@klarkxy/dsh-plugin-kit": "workspace:*"
  },
