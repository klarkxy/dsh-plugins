{
  "name": "@klarkxy/dsh-classmates",
  "version": "0.2.0-rc.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-classmates"
  },
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-plugins/issues"
  },
  "description": "Teammate Roles: reusable roles for native DSH subagents and Team teammates",
  "icon": "./icon.svg",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "docs/compatibility.md",
    "docs/preset-acceptance.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/evidence/live-acceptance.json",
    "docs/evidence/browser-acceptance.json",
    "docs/enhancement-acceptance.zh-CN.md",
    "docs/novice-workflow-acceptance.zh-CN.md",
    "docs/evidence/enhancement-browser.json",
    "docs/evidence/enhancement-manager.json",
    "docs/evidence/enhancement-cold.json",
    "docs/evidence/plugin-settings-browser.json",
    "docs/evidence/role-list-browser.json",
    "docs/evidence/creator-configuration.json",
    "docs/evidence/creator-settings-browser.json",
    "docs/fusion-migration.md",
    "scripts/migrate-fusion.mjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "migrate-fusion": "node dist/migrate-fusion.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
