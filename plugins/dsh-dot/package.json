{
  "name": "@klarkxy/dsh-dot",
  "version": "0.1.0",
  "description": "Dorothy (dot): an always-on coordinator for DeepSeek Harness. Talk to Dorothy in her own panel, and she opens workspaces, starts sessions, follows their progress, settles their approvals and questions for you, and reports back.",
  "icon": "./icon.svg",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "import": "./lib/tools.js",
      "default": "./lib/tools.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "client": {
        "inject": [
          "@deepseek-ai/dsh-client-connection",
          "@deepseek-ai/dsh-api-remotes",
          "@deepseek-ai/dsh-client-ui-slots",
          "@deepseek-ai/dsh-client-ui-sidebar",
          "@deepseek-ai/dsh-client-ui-workspace",
          "@deepseek-ai/dsh-client-ui-primitives",
          "@deepseek-ai/dsh-client-locale"
        ]
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-dot/src"
  },
  "dependencies": {
    "@klarkxy/dsh-dev-index": "workspace:*",
    "@klarkxy/dsh-plugin-kit": "workspace:*",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/schemastery": ">=3.18.4",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.1",
    "jsdom": "29.1.1",
    "@types/jsdom": "^28.0.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "coordinator",
    "agent-orchestration",
    "session-manager",
    "task-board"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-dot"
  },
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/dot/",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
