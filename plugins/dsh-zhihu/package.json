{
  "name": "@klarkxy/dsh-zhihu",
  "version": "0.1.10",
  "description": "Zhihu search, agent tools, knowledge bases, and usage tracking for DeepSeek Harness.",
  "icon": "./icon.svg",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "import": "./lib/tools.js",
      "default": "./lib/tools.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./usage": {
      "types": "./lib/usage.d.ts",
      "import": "./lib/usage.js",
      "default": "./lib/usage.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/*.js",
    "lib/*.js.map",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dshEditor": {
    "role": "feature",
    "visibility": "public",
    "wrapClient": true,
    "entries": [
      {
        "id": "zhihu",
        "title": "知乎",
        "description": "知乎搜索、知识库与用量",
        "feature": "zhihu",
        "service": "zhihu"
      }
    ],
    "inserts": [
      {
        "id": "zhihu-tools",
        "name": "@klarkxy/dsh-zhihu/tools",
        "title": "知乎工具",
        "description": "供写作搭档调用的知乎检索",
        "feature": "zhihu-tools",
        "requires": [
          "zhihu"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-zhihu",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-zhihu/src"
  },
  "dependencies": {
    "zod": "^4.1.5",
    "@klarkxy/dsh-plugin-kit": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "react": "^18.2.0",
    "@types/react": "18.3.31",
    "react-dom": "^18.2.0",
    "@types/react-dom": "^18.3.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "zhihu",
    "zhihu-search",
    "knowledge-base",
    "web-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-zhihu"
  },
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/zhihu/",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "1badbace8750df1849db5448e135df8930575a4a85fb743cb33940f448decfc8"
  }
}
