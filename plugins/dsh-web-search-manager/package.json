{
  "name": "@klarkxy/dsh-web-search-manager",
  "version": "0.1.8",
  "description": "Web Search: manage web search providers and public-page fetching from one settings page.",
  "icon": "./icon.svg",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "import": "./lib/tools.js",
      "default": "./lib/tools.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dshEditor": {
    "role": "feature",
    "visibility": "public",
    "wrapClient": true,
    "runtimeDependencies": [
      "@deepseek-ai/dsh-web-search-exa"
    ],
    "entries": [
      {
        "id": "web-search-manager",
        "title": "网页搜索",
        "description": "在一个设置页管理搜索服务商和公开页面抓取",
        "feature": "web-search",
        "service": "webSearchManager"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-web-search-manager",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-web-search-manager/src"
  },
  "dependencies": {
    "@deepseek-ai/dsh-web-search-exa": ">=0.1.7-rc.2",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-web": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-web": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-web-search-deepseek": ">=0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-fetch-http": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-search-deepseek": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.1.7-rc.2",
    "@deepseek-ai/dsh-web": "0.1.7-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.1.7-rc.2",
    "@deepseek-ai/dsh-web-search-deepseek": "0.1.7-rc.2",
    "react": "^18.2.0",
    "@types/react": "18.3.31"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "web-search",
    "search-provider",
    "page-fetching",
    "duckduckgo",
    "tavily"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-web-search-manager"
  },
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/web-search-manager/",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "bf0d3a6c045677e009bf8cec234ef966392afc94b90a5b2e538426b7f1cc5d06"
  }
}
