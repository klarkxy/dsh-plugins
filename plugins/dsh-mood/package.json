{
  "name": "@klarkxy/dsh-mood",
  "version": "0.1.4",
  "description": "Autonomy-first task guidance with clarification only for genuine blockers in DeepSeek Harness.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dshEditor": {
    "role": "feature",
    "visibility": "public",
    "wrapClient": true,
    "entries": [
      {
        "id": "mood",
        "title": "需求澄清",
        "description": "默认自主推进，仅在真正阻塞时询问，支持按需梳理需求",
        "feature": "mood",
        "service": "aiMood"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-mood",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.editor-plugins.config.ts --maxWorkers=2 plugins/dsh-mood/src"
  },
  "dependencies": {
    "@klarkxy/dsh-ai-services": "workspace:*",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "react": "^18.2.0",
    "@types/react": "18.3.31"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "mood",
    "requirements-clarification",
    "task-contract"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-mood"
  },
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/mood/",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "sha256-c9d42e8b93f36a8345e1ef7a5f3a2e027cbe470680ea354e27f84e9017a44b76"
  }
}
