{
  "name": "@klarkxy/dsh-safe-auto",
  "version": "0.5.4",
  "description": "Safe Auto: a reviewer model answers approval requests one call at a time; includes review history with full audit trails.",
  "icon": "./icon.svg",
  "type": "module",
  "homepage": "https://klarkxy.github.io/dsh-plugins/plugins/safe-auto/",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ui-host": "./src/ui-host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "src/*.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-safe-auto",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-safe-auto"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "approval",
    "security",
    "safe-auto",
    "approval-workflow",
    "auto-review",
    "audit"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@klarkxy/dsh-plugin-kit": "workspace:*",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.1",
    "@klarkxy/dsh-model-route": "workspace:*",
    "jsdom": "29.1.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "77c467f7f55eb6450ea073f7c61a30b78619b38bf50c6be74e27357318ade841"
  }
}
