{
  "name": "@klarkxy/dsh-safe-auto",
  "version": "0.5.0",
  "description": "Safe Auto: a reviewer model answers native approval requests, Codex auto-review style; only a pass approves that one call.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ui-host": "./src/ui-host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "src/*.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --check src/config.js && node --check src/dangerous.js && node --check src/transcript.js && node --check src/model-route.js && node --check src/reviewer.js && node --check src/audit.js && node --check src/index.js && node --check src/control.js && node --check src/ui-host.js && tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-safe-auto",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-safe-auto"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "security"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@klarkxy/dsh-plugin-kit": "workspace:*",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.1",
    "@klarkxy/dsh-model-route": "workspace:*",
    "jsdom": "29.1.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "4479e79ba77c55f0446e01d5ac8a9b2db9079aedde794debb60fea69e85221a0"
  }
}
