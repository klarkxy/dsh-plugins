{
  "name": "@klarkxy/dsh-safe-auto",
  "version": "0.1.0-rc.5",
  "description": "Safe Auto: budgeted preflight and one-shot escalation with conversation-following or independent reviewers.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ui-host": "./src/ui-host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "src/*.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README*.md",
    "docs/*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --check src/config.js && node --check src/policy.js && node --check src/escalation.js && node --check src/model-route.js && node --check src/reviewer.js && node --check src/gate.js && node --check src/index.js && node --check src/control.js && node --check src/ui-host.js && tsdown && node ../../scripts/editor-plugins/wrap-client.mjs @klarkxy/dsh-safe-auto",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.2"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-plugins.git",
    "directory": "plugins/dsh-safe-auto"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "security"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "dependencies": { "zod": "^4.1.5" },
  "peerDependencies": { "@deepseek-ai/dsh-storage-domain": ">=0.1.7-rc.2" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-storage-domain": { "optional": true } },
  "devDependencies": { "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "29a456b330ec9c7f4e4020bbb770a40747057e1271fb6d2ad997c2cf4b5ff71c"
  }
}
