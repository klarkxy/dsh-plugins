{
  "name": "dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter \"{plugins/*}\" --if-present run build",
    "typecheck": "pnpm --filter \"{plugins/*}\" --if-present run typecheck",
    "test": "pnpm --filter \"{plugins/*}\" test",
    "pack:check": "pnpm --filter \"{plugins/*}\" exec npm pack --dry-run --cache .npm-cache",
    "release:check": "node scripts/release-target.mjs && node --test scripts/*.test.mjs",
    "site:build": "node site/build.mjs",
    "site:test": "node --test site/*.test.mjs",
    "check": "pnpm release:check && pnpm site:test && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "marked": "18.0.14",
    "semver": "^7.8.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
